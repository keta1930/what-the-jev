    {
      "sentence_index": 67,
      "paragraph_index": 12,
      "origin": "human",
      "text": "安眠吧，莘田！",
      "output_sha256": "afdcc4d81fb00539dbd294d1b0e9ee7d890ef86649e3bda1e196c8e9d8475719",
