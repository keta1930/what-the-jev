      ]
    },
    {
      "sentence_index": 61,
      "paragraph_index": 7,
      "origin": "human",
      "text": "满藏在我们心里！",
      "output_sha256": "f1be366a8810ecce2d1c0b0e7415f11dbb4b4e86e201afdc704a7b5bdfe3afab",
      "alignment_unit_index": 61,
      "alignment_score": null,
      "source_human_sentence_index": 61,
