      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 65,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "单靠理论学习而不参与实际斗争，理论也不过是书本上的东西，无法让思想深入到作品的每一个字句。",
      "output_sha256": "030aa00b1a0be04ee2d41be40ddd4ee99f996a33b7e1a4b56821a430267e93b0",
      "alignment_unit_index": 57,
