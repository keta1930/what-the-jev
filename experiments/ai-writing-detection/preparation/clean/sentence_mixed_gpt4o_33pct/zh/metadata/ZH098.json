      "ai_unit_sentence_indices": [
        56
      ]
    },
    {
      "sentence_index": 67,
      "paragraph_index": 7,
      "origin": "human",
      "text": "文字、生活、思想、感情四者俱备，再加上艺术的处理技巧与方法，才能写出像样子的作品。",
      "output_sha256": "56dd5f03ffee9df46ba9cf317fb5ee82874cd10660b29327f2b3e1089bdcd00c",
