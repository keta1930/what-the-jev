        "aef6d24ca6f131349af6f9b9270014bf40bea1a22d90a7f77d31ac0f20981463"
      ],
      "source_ai_sentence_index": 76,
      "source_ai_sha256": "2702ce8a55edab2167e82b4af96fd809c19c84d97cbc078faf480ba6c3791ebf",
