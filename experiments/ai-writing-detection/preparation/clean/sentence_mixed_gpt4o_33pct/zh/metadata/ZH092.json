      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 5,
      "origin": "human",
      "text": "这时候屋里的电话铃也响得密起来了。",
      "output_sha256": "a5308a89b3bda0e3c1d8ffc3013164e8d9dcf6db9e1770627f23855fa6884d9d",
