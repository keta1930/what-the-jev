      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 5,
      "origin": "human",
      "text": "大家在电话里猜着，是敌人在进攻西苑了，是敌人在进攻南苑了。",
