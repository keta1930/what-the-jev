      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 20,
      "origin": "ai",
      "text": "父亲点头说道。",
      "output_sha256": "c96381d8ede38a9f40d403a304aca78c9e8040b087e85619686ada49cb4c667a",
      "alignment_unit_index": 54,
      "alignment_score": 0.728571,
      "human_sentence_indices": [
