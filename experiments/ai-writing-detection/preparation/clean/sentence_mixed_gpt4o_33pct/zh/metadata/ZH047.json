    {
      "sentence_index": 27,
      "paragraph_index": 6,
      "origin": "human",
      "text": "我们集邮，但是不为居奇赚钱。",
      "output_sha256": "8759a87ada7b7dfb64233babee9ed6516bebb6d9f4255ec68fc520715f9dff13",
