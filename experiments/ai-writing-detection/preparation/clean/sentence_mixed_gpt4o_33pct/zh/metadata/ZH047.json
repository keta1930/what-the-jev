      ],
      "human_sha256": [
        "977bb5aec193ead46631a6a97ed0efed658070ba16a28fe85b78f9d05ee9ff8d",
        "32cbd775effafe0d64497db0256bdcd084370032bc625dcf88d13b4bfe6bdd8b"
      ],
      "source_ai_sentence_index": 46,
      "source_ai_sha256": "4d07afc85a34f7934afbb00b0ba1f565540faf928f27e60799ac4a87838572fa",
      "ai_unit_sentence_indices": [
        46
      ]
    },
    {
      "sentence_index": 57,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "在妇女食堂，招待员和厨师都是女性。",
      "output_sha256": "8bad3a19067628ffed468c20bd6bc71e743299e769745664185ab1ee5f23e176",
      "alignment_unit_index": 51,
      "alignment_score": 0.600542,
