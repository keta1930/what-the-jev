      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 5,
      "origin": "human",
      "text": "我们去看戏，是干干净净的戏。",
      "output_sha256": "d844e944e0107fc3c939cc8704bf5cf34a988c0caf65850dc0825cddfba81a23",
