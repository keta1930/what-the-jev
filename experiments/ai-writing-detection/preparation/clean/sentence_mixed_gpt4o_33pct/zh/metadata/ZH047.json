      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "纽约、伦敦、巴黎等城市却无法解决这个问题。",
      "output_sha256": "1820e943063a01f593f19175885d8f073121d35e9a86868b5b12fc17e9ea8773",
      "alignment_unit_index": 13,
      "alignment_score": 0.7,
      "human_sentence_indices": [
        14
