      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 5,
      "origin": "human",
      "text": "可是，我们去看电影，是干干净净的电影。",
      "output_sha256": "6fde67687664d5786f353d05c1e2b088da1587a1ba12c13dd88fe7e47638c851",
