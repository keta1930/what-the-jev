      "ai_unit_sentence_indices": [
        13
      ]
    },
    {
      "sentence_index": 17,
      "paragraph_index": 3,
      "origin": "human",
      "text": "难道女子比男人低一头，到处有成群卖淫的妇女也算是“民主”和“人道主义”的表现么？",
      "output_sha256": "5f2f242d59e6765a4cf065219f6ba2aa86c80e6ff5691e806abbd39bff3f7646",
      "alignment_unit_index": 16,
      "alignment_score": null,
