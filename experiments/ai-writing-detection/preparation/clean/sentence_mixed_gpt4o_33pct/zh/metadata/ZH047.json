      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "《月牙儿》中描绘了“女招待”的悲惨遭遇，而今天，女性已参与到各行各业中。",
      "output_sha256": "4d07afc85a34f7934afbb00b0ba1f565540faf928f27e60799ac4a87838572fa",
      "alignment_unit_index": 50,
      "alignment_score": 0.492241,
      "human_sentence_indices": [
        58,
