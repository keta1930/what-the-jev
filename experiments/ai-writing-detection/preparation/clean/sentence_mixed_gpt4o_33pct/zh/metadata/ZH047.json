      "source_human_sha256": "a7e4f30b38a80dc41cd52e6253cf795b8e9b9f7b3ad1f2aefa6da287e9196a6d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 9,
      "origin": "human",
      "text": "我们感谢他为我们出汗服务。",
      "output_sha256": "d476654f26b23b557e7eab0a0c5cb1c2d49154b79b99845d8b0a8d11042ff014",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 57,
