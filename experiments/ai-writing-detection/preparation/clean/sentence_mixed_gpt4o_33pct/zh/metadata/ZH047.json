      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 6,
      "origin": "human",
      "text": "难道不该如此吗？",
      "output_sha256": "fb3bb78c4f2ac36b352d825ee4b926f4566a61c8ea6ec999c5d93f4aed156c5b",
