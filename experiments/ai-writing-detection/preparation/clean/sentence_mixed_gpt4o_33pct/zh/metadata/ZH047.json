      "source_ai_sentence_index": 8,
      "source_ai_sha256": "97372c35bbd414b95dc0ac11e79514a0f2f544afd212c74e3779aa184aaf9cd4",
      "ai_unit_sentence_indices": [
        8
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 3,
      "origin": "human",
      "text": "我们改造了妓女，使她们得到了新生。",
      "output_sha256": "02f6a28da23ea58b13c330fe43d045849eccfdd2b2860c1db87c9a08b4f3463d",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 12,
