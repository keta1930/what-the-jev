      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 3,
      "origin": "human",
      "text": "这是件了不起的事。",
      "output_sha256": "8d0867e9a80de311e5424d8f1d8b64b5ba44e56f6f659c1155e3bd4adc51b578",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 13,
