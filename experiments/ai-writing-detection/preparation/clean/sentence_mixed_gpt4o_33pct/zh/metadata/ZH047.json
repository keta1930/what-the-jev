      "human_sha256": [
        "93f8c0273c1e001b1f63b6b2bbb2b746b6978b645061c37c39917db023edefbe"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "af5ca0438f3b049530dce90fd5f8f581ecc432f68b9337c1f44237d3b3652b8f",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 53,
      "paragraph_index": 9,
      "origin": "human",
      "text": "是呀，大家心里都干净了，谁还能看不起“祥子”呢？",
      "output_sha256": "092e7a8b1a4a4e0f91ba25f5c8a7a477ecaa495a1a3b807ebd99bf1ce98a70cd",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "092e7a8b1a4a4e0f91ba25f5c8a7a477ecaa495a1a3b807ebd99bf1ce98a70cd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 9,
      "origin": "human",
      "text": "谁还会剥削他呢？",
      "output_sha256": "a7e4f30b38a80dc41cd52e6253cf795b8e9b9f7b3ad1f2aefa6da287e9196a6d",
      "alignment_unit_index": 48,
      "alignment_score": null,
