      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "——为北京解放十周年而作",
      "output_sha256": "5c589ce60d28720512c7e7ca04a11c60c03dc792cac0dd5cee20a1a64856a494",
      "alignment_unit_index": 1,
