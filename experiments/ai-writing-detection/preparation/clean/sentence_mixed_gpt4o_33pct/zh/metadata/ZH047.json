      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 10,
      "origin": "human",
      "text": "她们剔猪、卖鱼，还蹬起三轮车去取货送货。",
      "output_sha256": "72f794cd0f664cab5dfc442def4f3ebc07c44e968383d8f0ff6ebd83d0ec52f6",
      "alignment_unit_index": 54,
      "alignment_score": null,
