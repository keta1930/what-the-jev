      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "确实，市场与庙会上已不再有老虎摊子，也没有了江湖气息。",
      "output_sha256": "3c5d02e40308c7e4e85e383a23f2b5f67cff0150692e4e0faf553528e7274246",
      "alignment_unit_index": 47,
      "alignment_score": 0.61676,
      "human_sentence_indices": [
