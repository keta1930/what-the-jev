      ],
      "source_ai_sentence_index": 44,
      "source_ai_sha256": "c3b670c6144a5be1133f70b32164650406b57794c3594aa388eb44a7695ab3e5",
      "ai_unit_sentence_indices": [
        44
      ]
    },
    {
      "sentence_index": 50,
      "paragraph_index": 8,
      "origin": "human",
      "text": "最坏的变成最好的，这难道不像奇迹，不令人从心里喜悦么？",
