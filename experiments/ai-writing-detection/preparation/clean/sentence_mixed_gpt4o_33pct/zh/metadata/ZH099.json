      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 10,
      "origin": "human",
      "text": "这必能办到，连天桥不是已经高高悬起跃进的红旗了吗！",
      "output_sha256": "6521b2dd1593c8f57c5fbb5957d7b6c619e265d146241b868e1a2ea7d0330f19",
      "alignment_unit_index": 51,
