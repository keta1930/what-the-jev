      "source_human_sha256": "a49f0a861eb257c2936def28225c536dfae827808ed61c1ac2bc689ad0347fe7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 7,
      "origin": "human",
      "text": "百年树人吗？",
      "output_sha256": "cf300ac772ce4b0e110a0756755aebfa01f33db13330b29f42457694a3783f2e",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "cf300ac772ce4b0e110a0756755aebfa01f33db13330b29f42457694a3783f2e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 7,
      "origin": "human",
      "text": "在社会主义社会里不用这么久！",
      "output_sha256": "6621a54aa7ba2ee16d2eac0c06cc0bb22aff5b34cc9e92601601148d102c5247",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "6621a54aa7ba2ee16d2eac0c06cc0bb22aff5b34cc9e92601601148d102c5247",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 7,
      "origin": "human",
      "text": "十年的教育已经使天桥改了样子，由混乱变为有条有理，由落后变为先进。",
      "output_sha256": "53e5bf68e2b17f6c9a1be9a5cb0a21ee9b90f8c0121992bb81233952173f462f",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 46,
