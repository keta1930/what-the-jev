      "ai_unit_sentence_indices": [
        46
      ]
    },
    {
      "sentence_index": 52,
      "paragraph_index": 9,
      "origin": "human",
      "text": "天桥领着头儿变了嘛。",
      "output_sha256": "f97b7ef9b3fd93e357ba455c9205d089cfd6df82ff1ac7f8d6800474a74c2211",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "f97b7ef9b3fd93e357ba455c9205d089cfd6df82ff1ac7f8d6800474a74c2211",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "这是多么美好的社会啊，无论走到哪里，都不必担心受骗、受欺，内心始终安宁，这是多么大的幸福啊！",
      "output_sha256": "a627f1270ba06dc11d26dfe67f129a5e9b431044165a2291e845aa85fd1009fd",
      "alignment_unit_index": 49,
      "alignment_score": 0.602155,
      "human_sentence_indices": [
