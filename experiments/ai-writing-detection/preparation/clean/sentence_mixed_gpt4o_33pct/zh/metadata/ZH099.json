      ],
      "human_sha256": [
        "c55fc95b018f77fd66e1edff16fdced2dbc441cb9bcd65ab23612f7c0d4cffdb"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "22446005f908741b0d744917b177a6e1e03bc623991ee0da88520cc3b5430e32",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 40,
      "paragraph_index": 6,
      "origin": "human",
      "text": "整个的天桥改观了。",
      "output_sha256": "ab9808f10da6ed983967be6336d79040deb13b2803eb25bb5e5035512a4cf5d8",
      "alignment_unit_index": 36,
      "alignment_score": null,
