      "source_ai_sentence_index": 40,
      "source_ai_sha256": "05bc18424bb42b140cdb54d30ab1823743309ce748989d30e16f99e5625fed30",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 46,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "天桥已成为跃进过程中的一面红旗。",
