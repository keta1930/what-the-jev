      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 6,
      "origin": "human",
      "text": "若是没有这个基础，而专凭一二商店的干部的努力，便不会有多少成就。",
      "output_sha256": "a49f0a861eb257c2936def28225c536dfae827808ed61c1ac2bc689ad0347fe7",
      "alignment_unit_index": 37,
      "alignment_score": null,
