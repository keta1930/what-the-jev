      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "8da88ebb6574a6d18746656b708f64da5796993e3943218403c1488c615159d1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "回首今天的天桥，令人深信：全北京的新风气确实已经建立，因为过去的天桥是最污浊混乱的地方。",
      "output_sha256": "c3b670c6144a5be1133f70b32164650406b57794c3594aa388eb44a7695ab3e5",
      "alignment_unit_index": 45,
      "alignment_score": 0.62363,
      "human_sentence_indices": [
        51
