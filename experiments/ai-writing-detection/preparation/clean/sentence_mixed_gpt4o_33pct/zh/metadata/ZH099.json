  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "古人云：十年树木，百年树人。",
      "output_sha256": "1566ede03e88be84fbadb285be62c08aa42d3efd87b81df3785523e988fb261a",
      "alignment_unit_index": 1,
      "alignment_score": 0.743182,
      "human_sentence_indices": [
