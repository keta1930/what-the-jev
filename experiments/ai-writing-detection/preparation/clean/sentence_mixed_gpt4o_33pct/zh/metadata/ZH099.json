      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "这是令人惊叹的成就！",
      "output_sha256": "05bc18424bb42b140cdb54d30ab1823743309ce748989d30e16f99e5625fed30",
      "alignment_unit_index": 41,
      "alignment_score": 0.599874,
