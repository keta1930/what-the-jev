      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "“文协”的兴衰与我们每一个人息息相关。",
      "output_sha256": "3f713f3ee5aac1572d2bff5c58c9cbecf9388ab56607ceb5549a9470e7737490",
      "alignment_unit_index": 42,
