      "source_ai_sentence_index": 42,
      "source_ai_sha256": "3f713f3ee5aac1572d2bff5c58c9cbecf9388ab56607ceb5549a9470e7737490",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 43,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "我们不能因其已相对稳固而放松努力。",
