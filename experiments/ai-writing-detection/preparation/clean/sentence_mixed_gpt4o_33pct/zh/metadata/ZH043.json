      "ai_unit_sentence_indices": [
        43
      ]
    },
    {
      "sentence_index": 44,
      "paragraph_index": 6,
      "origin": "human",
      "text": "今天静止，明天就衰废！",
      "output_sha256": "da094818a05c53dc0978b38ccc31cc909038d57652bb4792c82450b8cdcb77fe",
      "alignment_unit_index": 44,
