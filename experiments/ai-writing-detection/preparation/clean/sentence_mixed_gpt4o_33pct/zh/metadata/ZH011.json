        "ffdf2563d8fab4c1f4ff4cc2f7b5fc0054a3d11621424fdb84b943f45a48850c"
      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "5498aabff9430da12153ec157e9a4a0014e862c450e780f615f2905c994c7301",
