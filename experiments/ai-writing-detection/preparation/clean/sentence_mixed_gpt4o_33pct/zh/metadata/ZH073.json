      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "一激动，就容易把桐城派的文章义法和报告文学的第一点、第二点都忘了。",
      "output_sha256": "16c6ad46389547d96e46444279ede4f1273a03812711e810c349412c9c3c02c6",
      "alignment_unit_index": 2,
      "alignment_score": null,
