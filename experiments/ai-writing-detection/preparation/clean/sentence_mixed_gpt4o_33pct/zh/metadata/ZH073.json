        "0de24bd1017075016c46ea03b897a2f014122ca29f34fffaa4c5c5035c9e7e48"
      ],
      "source_ai_sentence_index": 56,
      "source_ai_sha256": "ecb1f2aefdcaee105bee653368beca74204d5159337aed258e6c7e2d9636b027",
      "ai_unit_sentence_indices": [
        56
      ]
    },
    {
      "sentence_index": 57,
      "paragraph_index": 13,
      "origin": "human",
      "text": "大会开幕，赫鲁晓夫同志同党、政领导人到会；大会闭幕，也是如此，并由赫鲁晓夫同志作了恳切而精彩的发言。",
      "output_sha256": "4eceb2022e3359b9b41904bd48da412c72ac2b57dce840b1c5cf5b2c5cb37c1e",
      "alignment_unit_index": 57,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "4eceb2022e3359b9b41904bd48da412c72ac2b57dce840b1c5cf5b2c5cb37c1e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 13,
      "origin": "human",
      "text": "在社会主义国家里，作家是多么幸福啊！",
      "output_sha256": "82df9309ae60059ab52ba93b63c6fdcb499db4423e39228968a8a515c14b33c6",
      "alignment_unit_index": 58,
      "alignment_score": null,
      "source_human_sentence_index": 62,
      "source_human_sha256": "82df9309ae60059ab52ba93b63c6fdcb499db4423e39228968a8a515c14b33c6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 13,
      "origin": "human",
      "text": "党是多么重视文学事业，尊重作家呀！",
      "output_sha256": "8908b6a7a050c74ffb7d74d9e81fdbf2e4367dfe6a5b272f510c3d2560a301f1",
      "alignment_unit_index": 59,
      "alignment_score": null,
      "source_human_sentence_index": 63,
      "source_human_sha256": "8908b6a7a050c74ffb7d74d9e81fdbf2e4367dfe6a5b272f510c3d2560a301f1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 13,
      "origin": "human",
      "text": "他的发言感动了所有在场的作家。",
      "output_sha256": "13b11c5484f54237c2017ec4e3ceaf291045aee0f35563f06f10045defcdcf1c",
      "alignment_unit_index": 60,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "13b11c5484f54237c2017ec4e3ceaf291045aee0f35563f06f10045defcdcf1c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 13,
      "origin": "ai",
      "text": "会后，一位西方作家对我说：赫鲁晓夫同志真伟大：那么民主，那么自信，那么幽默，那么通达！",
      "output_sha256": "7ac76538bbfb83b7facc8eed51bbd4e5c7cb28d4ba839ebe12b61d3705c401a1",
