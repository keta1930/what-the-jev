  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "刚刚由莫斯科回来，感情激动。",
      "output_sha256": "9dfc8f73bb9f7ae7044acabb4f84b9aa43672eca6ff3a1711564d9a001f486e2",
      "alignment_unit_index": 1,
      "alignment_score": null,
