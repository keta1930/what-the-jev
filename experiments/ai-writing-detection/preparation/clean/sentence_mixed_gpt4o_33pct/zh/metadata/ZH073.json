        "fb9fc8b887eb342623a24d0b28841f570b3bee8f15e0ca24cb1eadd19e4dd7ba"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "a945d629e092ad095285352260b0f59706e587bd3cf8c976196766f0d4f60601",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 16,
      "paragraph_index": 6,
      "origin": "human",
      "text": "……当然看见了！",
      "output_sha256": "d647e1a36d31bf08d63f7df17d88fd6c83d60ae83829cb9c94f079d3e9ab19eb",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "d647e1a36d31bf08d63f7df17d88fd6c83d60ae83829cb9c94f079d3e9ab19eb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 6,
      "origin": "human",
      "text": "可是提起这些东西就很难以三言两语地说完，或者也不易说到根儿上。",
      "output_sha256": "270fbb8587554758e92bc854fbff2eb74350e60c4b04366e4153b48cde9e5c25",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "270fbb8587554758e92bc854fbff2eb74350e60c4b04366e4153b48cde9e5c25",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 6,
      "origin": "human",
      "text": "什么根儿呢？",
      "output_sha256": "93801cd26772ec8d74187ffd84b28e3dae6f3fe35bfbca0aa16ea30c6604e8d6",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "93801cd26772ec8d74187ffd84b28e3dae6f3fe35bfbca0aa16ea30c6604e8d6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "全苏人民正在欢快地建设共产主义啊！",
      "output_sha256": "f4cbdb80262dbf3a45145266f046bef0dd30edb8468132154e79a3bf916acd15",
      "alignment_unit_index": 19,
      "alignment_score": 0.704038,
      "human_sentence_indices": [
        19
      ],
      "human_sha256": [
        "483eb17606b0081e20058d306bee575e51a761be68969be94d8cabe32bfc56e9"
      ],
      "source_ai_sentence_index": 19,
      "source_ai_sha256": "f4cbdb80262dbf3a45145266f046bef0dd30edb8468132154e79a3bf916acd15",
      "ai_unit_sentence_indices": [
        19
      ]
    },
    {
      "sentence_index": 20,
      "paragraph_index": 6,
      "origin": "human",
      "text": "作着这史无前例的伟大事业，怎能够不人人处处都喜气洋洋呢？",
      "output_sha256": "97293f2bb59cf49f84ed4cd8ed214ac0d0a6b4c27374a7af6d879687e230e6fb",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 20,
