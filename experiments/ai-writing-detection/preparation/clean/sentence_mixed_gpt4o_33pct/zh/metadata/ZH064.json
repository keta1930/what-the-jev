      ]
    },
    {
      "sentence_index": 28,
      "paragraph_index": 6,
      "origin": "human",
      "text": "故牙齒既然是白的，口脣必須塗紅。",
      "output_sha256": "3625e922514475513d6d92aa6b73e5db08565ec3f45a80cb33fdf6561dcd4220",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 30,
