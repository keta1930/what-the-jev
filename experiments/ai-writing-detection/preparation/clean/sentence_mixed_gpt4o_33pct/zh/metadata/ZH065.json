      ],
      "source_ai_sentence_index": 64,
      "source_ai_sha256": "6fe9dea43c409f1872455e41dbd010945aaebcaf74c909ca0d4faae8a95a6066",
      "ai_unit_sentence_indices": [
        64
      ]
    },
    {
      "sentence_index": 68,
      "paragraph_index": 12,
      "origin": "human",
      "text": "学生中我颇有记得的。",
      "output_sha256": "b751b09da886e5af13804037522e9ff9291909d3fcb001b8fb572e34a8bc1dec",
      "alignment_unit_index": 63,
      "alignment_score": null,
      "source_human_sentence_index": 68,
      "source_human_sha256": "b751b09da886e5af13804037522e9ff9291909d3fcb001b8fb572e34a8bc1dec",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 69,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "前些日子，有位P君给我写信，虽然我没时间回复，但心中仍然很感激！",
      "output_sha256": "5c836c9960d61e0121034020cf7c875a6d07a50565db399060ec5b9763eeaa1b",
      "alignment_unit_index": 64,
      "alignment_score": 0.531459,
