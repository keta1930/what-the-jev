    },
    {
      "sentence_index": 70,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "借此机会，请你替我转达一句。",
      "output_sha256": "9690f047ee52c23e524fc6fc003467b7234a5f34331b0559bd8fa8c1e11a8e8c",
      "alignment_unit_index": 65,
