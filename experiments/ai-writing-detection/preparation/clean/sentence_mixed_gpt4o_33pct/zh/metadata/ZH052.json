        "0356fec89680de4b17d0fdc50708f6e0ba1004aa7e91ee5bf3caabdceaa18c72"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "86828daf7d26fa9411d2221f12a9db53519bbf30851feadc26f26f68119844ca",
      "ai_unit_sentence_indices": [
        30
      ]
    },
    {
      "sentence_index": 31,
      "paragraph_index": 11,
      "origin": "human",
      "text": "他過於可惜那張吸墨紙。",
      "output_sha256": "42d84f3777b970be138db59964464aff0adc31240a0672595e6b36f968be2105",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 32,
      "source_human_sha256": "42d84f3777b970be138db59964464aff0adc31240a0672595e6b36f968be2105",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 11,
      "origin": "human",
      "text": "我看他那種樣子也很生氣。",
      "output_sha256": "7b84627076dbdc32c227a915d5077945fccb4c63087f2f91f22fb1ecdec6e955",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "7b84627076dbdc32c227a915d5077945fccb4c63087f2f91f22fb1ecdec6e955",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 11,
      "origin": "human",
      "text": "吸墨紙重要，還是拿生命去開玩笑重要？",
      "output_sha256": "23f332ad048ef86cab292f0465af327e1a6068c80e3282618e45654cbd4f4e78",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "23f332ad048ef86cab292f0465af327e1a6068c80e3282618e45654cbd4f4e78",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 34,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "“為了一點小事燒掉一件棉襖！”",
      "output_sha256": "17db263979b2d91f41ed7df6516c2159d4370a68e933c57957884c0942c37d25",
      "alignment_unit_index": 33,
      "alignment_score": 0.575735,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "1bea784e7ef2f69cce5d1010f186a820be4ceacaf791fd610aebb070e6b6e8d8"
      ],
      "source_ai_sentence_index": 33,
      "source_ai_sha256": "17db263979b2d91f41ed7df6516c2159d4370a68e933c57957884c0942c37d25",
      "ai_unit_sentence_indices": [
        33
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 12,
      "origin": "human",
      "text": "郎華罵我。",
      "output_sha256": "02c304088ef4ce5a82f8598ab1681599613523ac5350ba334b1de0415a5f2172",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "02c304088ef4ce5a82f8598ab1681599613523ac5350ba334b1de0415a5f2172",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 12,
      "origin": "human",
      "text": "“那你就不會把字剪掉？”",
      "output_sha256": "654f9d6bb19b2a4bcb2f9c85773b7412cdcff25ac7126147880151da963615a5",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "654f9d6bb19b2a4bcb2f9c85773b7412cdcff25ac7126147880151da963615a5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 13,
      "origin": "human",
      "text": "我哪想起來這樣做！",
      "output_sha256": "4dae174608e9470343893919fed9da4ac498f455c04d650b00181ea6f3e88740",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "4dae174608e9470343893919fed9da4ac498f455c04d650b00181ea6f3e88740",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 13,
      "origin": "human",
      "text": "真傻，爲着一塊瘡疤丟掉一個蘋果！",
      "output_sha256": "1911fe658027630cfa44d95cc3a14a9afdbbd4af42cdfd76208fc5054376cb05",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "1911fe658027630cfa44d95cc3a14a9afdbbd4af42cdfd76208fc5054376cb05",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "我們把那些“滿洲國”建國紀念的明信片擺在桌上，那是朋友贈送的，厚厚一疊。",
      "output_sha256": "721ae33b83aa0028920b4de0ec048ea0d584c29c5669a75370541d78bb07df21",
      "alignment_unit_index": 38,
      "alignment_score": 0.686382,
      "human_sentence_indices": [
        40
      ],
      "human_sha256": [
        "68fa1aae2b2d3060525987099b8bcf0863cf6210266d10d71bcaec94cd59d4c3"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "721ae33b83aa0028920b4de0ec048ea0d584c29c5669a75370541d78bb07df21",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 40,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "還有兩本上面寫著“滿洲國”的書，沒仔細看就擺了上去。",
      "output_sha256": "3326f4c0b5d1d65c52a313f947eae00a5ed64668117e38be320c1ede430f2e18",
      "alignment_unit_index": 39,
      "alignment_score": 0.472511,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "ab05abec24039851bffdd509752db3af5fe917650d5979ea42052b62cb11adff"
      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "3326f4c0b5d1d65c52a313f947eae00a5ed64668117e38be320c1ede430f2e18",
      "ai_unit_sentence_indices": [
        39
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "桌面上還擺著一些有趣的書：《離騷》、《李後主詞》、《石達開日記》，以及他當家庭教師用的小學算術教本。",
      "output_sha256": "11bdf79e3697fbcd813a36e9dc22326a36fcd786dca3362583ec5e85f7f2c71e",
      "alignment_unit_index": 40,
      "alignment_score": 0.691039,
      "human_sentence_indices": [
        42
      ],
      "human_sha256": [
        "8c22a722e2787fb8ef2fd2c9222d2254ca5152fff0a5692eb34b15173a916404"
      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "11bdf79e3697fbcd813a36e9dc22326a36fcd786dca3362583ec5e85f7f2c71e",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 14,
      "origin": "human",
      "text": "一本《世界各國革命史》也從桌子上抽下去，郎華說那上面載着日本怎樣壓迫朝鮮的歷史，所以不能擺在外面。",
      "output_sha256": "09047d3cbd084661e70d55e7e9bf5a12f22fb00f1f1cf30e5b005b888fe0901c",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "09047d3cbd084661e70d55e7e9bf5a12f22fb00f1f1cf30e5b005b888fe0901c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "我聽了這話，立刻想要燒掉它，已經站起來，郎華卻將我按下：“瘋了嗎？",
      "output_sha256": "9633659040a768deac585e6e892520d96f84e8b9fde54358861638d0873e09b5",
      "alignment_unit_index": 42,
      "alignment_score": 0.543849,
      "human_sentence_indices": [
        44
      ],
      "human_sha256": [
        "424d9bea717d09a8dded6097da3abab276992cc421c728a2cbf944d68c4794ae"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "9633659040a768deac585e6e892520d96f84e8b9fde54358861638d0873e09b5",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 44,
      "paragraph_index": 14,
      "origin": "human",
      "text": "你瘋了嗎？”",
      "output_sha256": "e6e639aded8082fedaadc568a99ec4f88018c48da5a8e70372bd0a0458f1011d",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "e6e639aded8082fedaadc568a99ec4f88018c48da5a8e70372bd0a0458f1011d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 15,
      "origin": "human",
      "text": "我就一聲不響了，一直到滅了燈睡下，連呼吸也不能呼吸似的。",
      "output_sha256": "dd70904022e7b1c5b77e67db693bc205300ce41de43c3b0b458d91d1097cebf1",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "dd70904022e7b1c5b77e67db693bc205300ce41de43c3b0b458d91d1097cebf1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 15,
      "origin": "human",
      "text": "在黑暗中我把眼睛張得很大。",
      "output_sha256": "8c717e11b0e571b104248d13fbb2458c676992ab2266f270d3dc5d772d5e5bf0",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 47,
      "source_human_sha256": "8c717e11b0e571b104248d13fbb2458c676992ab2266f270d3dc5d772d5e5bf0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 15,
      "origin": "human",
      "text": "院中的狗叫聲也多起來。",
      "output_sha256": "ba3f7e4be5c051dc92601427ec49d24e1555b7a312888a93d50bb88ef723aa39",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "ba3f7e4be5c051dc92601427ec49d24e1555b7a312888a93d50bb88ef723aa39",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 48,
      "paragraph_index": 15,
      "origin": "human",
      "text": "大門扇響得也厲害了。",
      "output_sha256": "35b9e8bb07bf295cc9bf8f8b74dc6e3fc5df4ba6de45e96a1440af136c5ff7a2",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "35b9e8bb07bf295cc9bf8f8b74dc6e3fc5df4ba6de45e96a1440af136c5ff7a2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 15,
      "origin": "human",
      "text": "總之，一切能發聲的東西都比平常發的聲音要高，平常不會響的東西也被我新發現着，棚頂發着響，洋瓦房蓋被風吹着也響，響，響……",
      "output_sha256": "c72f73c6be27115bc417864ca067d14d7dd16631b476c858d64489d2e1e84bee",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "c72f73c6be27115bc417864ca067d14d7dd16631b476c858d64489d2e1e84bee",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 16,
      "origin": "human",
      "text": "郎華按住我的胸口……我的不會說話的胸口。",
      "output_sha256": "f192058191d5b4184b785d8fa05080e1e1bac9dc012885d90db806b01827891e",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 51,
      "source_human_sha256": "f192058191d5b4184b785d8fa05080e1e1bac9dc012885d90db806b01827891e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 16,
      "origin": "human",
      "text": "鐵大門震響了一下，我跳了一下。",
      "output_sha256": "6988d1b6c6d1752f9f9ec3294de5a6c3594db15b403f69d40c5e6638b1ba8bcf",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 52,
      "source_human_sha256": "6988d1b6c6d1752f9f9ec3294de5a6c3594db15b403f69d40c5e6638b1ba8bcf",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 17,
      "origin": "ai",
      "text": "“別怕，我們有什麼呢？",
      "output_sha256": "e20994ec25850364072bb65b3e47bb966fd7158bd9e5ae7604a8609573f3536b",
      "alignment_unit_index": 51,
      "alignment_score": 0.773366,
      "human_sentence_indices": [
        53
      ],
      "human_sha256": [
        "5626d237967582e6bc8b5f410d0bc6ed47ced7d767ded3756fa2a0460835760f"
      ],
      "source_ai_sentence_index": 51,
      "source_ai_sha256": "e20994ec25850364072bb65b3e47bb966fd7158bd9e5ae7604a8609573f3536b",
      "ai_unit_sentence_indices": [
        51
      ]
    },
    {
      "sentence_index": 53,
      "paragraph_index": 17,
      "origin": "human",
      "text": "什麼也沒有。",
      "output_sha256": "5a1f0c00e3f27fdf6c25547b78defaed7e49641f50143fc1e070537e2b10e608",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "5a1f0c00e3f27fdf6c25547b78defaed7e49641f50143fc1e070537e2b10e608",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 17,
      "origin": "ai",
      "text": "不要太在意流言蜚語。",
      "output_sha256": "8eadb5daef4bddbce9ada0453589f9f2d44063a8b567d4d7ff739539d8bb519c",
      "alignment_unit_index": 53,
      "alignment_score": 0.399306,
      "human_sentence_indices": [
        55
      ],
      "human_sha256": [
        "af9dcc61704ad072318eb69aaee22631ccedf30d48c26a3b53607f27ba0d1e0a"
      ],
      "source_ai_sentence_index": 53,
      "source_ai_sha256": "8eadb5daef4bddbce9ada0453589f9f2d44063a8b567d4d7ff739539d8bb519c",
      "ai_unit_sentence_indices": [
        53
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 17,
      "origin": "human",
      "text": "他媽的，哪天捉去哪天算！",
      "output_sha256": "428810ccc080b7f8a62f98f37049702b1be99af9adb62c88dc01ad693e8e5d51",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "428810ccc080b7f8a62f98f37049702b1be99af9adb62c88dc01ad693e8e5d51",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 17,
      "origin": "human",
      "text": "睡吧，睡不足，明天要頭疼的……”",
      "output_sha256": "7ec411cd2ab87c604ec46c457ac3f7b1123b1013b3d2951b00300254f35a98ed",
      "alignment_unit_index": 55,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "7ec411cd2ab87c604ec46c457ac3f7b1123b1013b3d2951b00300254f35a98ed",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 18,
      "origin": "human",
      "text": "他按住我的胸口。",
      "output_sha256": "92a2d594968317bd19afc8b2ee449d45b193d1fc9cd3e4c7abcd2f69961f52f6",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "92a2d594968317bd19afc8b2ee449d45b193d1fc9cd3e4c7abcd2f69961f52f6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 18,
      "origin": "human",
      "text": "好像給噩夢驚醒的孩子似的，心在母親的手下大跳着。",
      "output_sha256": "e531aac9e80f00ee3d44404398acd8f9b830f33e66c6731ece6f5036e28a0676",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "e531aac9e80f00ee3d44404398acd8f9b830f33e66c6731ece6f5036e28a0676",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 19,
      "origin": "ai",
      "text": "有一天，我們到一家影戲院試劇，這些人雜七雜八地從我們的小房間出發。",
      "output_sha256": "087b5aeca916588da2e82dc307f11a9a24aab53268b62e3ab34ad9d5ec09d956",
      "alignment_unit_index": 57,
      "alignment_score": 0.663683,
      "human_sentence_indices": [
        60
      ],
      "human_sha256": [
        "8a6c87a2bcbb890252fe363206af20bd0b07a177032fb563c260971e3e0ca0fd"
      ],
      "source_ai_sentence_index": 57,
      "source_ai_sha256": "087b5aeca916588da2e82dc307f11a9a24aab53268b62e3ab34ad9d5ec09d956",
      "ai_unit_sentence_indices": [
        57
      ]
    },
    {
      "sentence_index": 60,
      "paragraph_index": 20,
      "origin": "human",
      "text": "全體都到齊，只少了徐志，他一次也沒有不到過，要試演他就不到，大家以爲他病了。",
      "output_sha256": "bc0d973e8d200c2125be4e4710af42a62e24c076d69f55854c4bcfdba3fc757a",
      "alignment_unit_index": 58,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "bc0d973e8d200c2125be4e4710af42a62e24c076d69f55854c4bcfdba3fc757a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 21,
      "origin": "human",
      "text": "很大的舞臺，很漂亮的垂幕。",
      "output_sha256": "31134e3809365c228a64e7c9cb0efe98a3ea8c4226323bce8155cedf9b07dae1",
      "alignment_unit_index": 59,
      "alignment_score": null,
      "source_human_sentence_index": 62,
      "source_human_sha256": "31134e3809365c228a64e7c9cb0efe98a3ea8c4226323bce8155cedf9b07dae1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 21,
      "origin": "human",
      "text": "我扮演的是一個老太婆的角色，還要我哭，還要我生病。",
      "output_sha256": "c70906a30a755e7d42b077665f28c8b65e5fd57024bbe22ca7061627127998bd",
      "alignment_unit_index": 60,
      "alignment_score": null,
      "source_human_sentence_index": 63,
      "source_human_sha256": "c70906a30a755e7d42b077665f28c8b65e5fd57024bbe22ca7061627127998bd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 63,
      "paragraph_index": 21,
      "origin": "human",
      "text": "把四個椅子拼成一張牀，試一試倒下去，我的腰部觸得很疼。",
      "output_sha256": "154163e8aa7fcf42e626f0fd0de37fe222a5552fc197231530cb01784c02b9c0",
      "alignment_unit_index": 61,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "154163e8aa7fcf42e626f0fd0de37fe222a5552fc197231530cb01784c02b9c0",
      "ai_unit_sentence_indices": []
    },
    {
