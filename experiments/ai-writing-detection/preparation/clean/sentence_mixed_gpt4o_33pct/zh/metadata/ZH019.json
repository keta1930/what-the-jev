    },
    {
      "sentence_index": 29,
      "paragraph_index": 7,
      "origin": "human",
      "text": "鲁迅日记第六册同日所记可供比较参考：",
      "output_sha256": "2c1ac11f96d90e7baa6ec16d4020e467e4f590a318ba2b132470accae70e4126",
      "alignment_unit_index": 28,
