      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "“十二日晴，晨四时半听到战声激烈，午后二时许平息，事情平静下来，但谣言四起。",
      "output_sha256": "2871b077a42f39d05497830b1f5b04280359a2084e7544c3daa5c05e74c86585",
      "alignment_unit_index": 29,
      "alignment_score": 0.613362,
