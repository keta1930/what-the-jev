      "ai_unit_sentence_indices": [
        60
      ]
    },
    {
      "sentence_index": 67,
      "paragraph_index": 23,
      "origin": "human",
      "text": "留下我覺得風從棚頂，從牀底都會吹來，凍鼻頭，又凍耳朵。",
      "output_sha256": "5998f70d16d2214c2b4c08c9328e2faf2904f4e3e06fa0a8c6ed7955824833a0",
      "alignment_unit_index": 60,
      "alignment_score": null,
      "source_human_sentence_index": 67,
