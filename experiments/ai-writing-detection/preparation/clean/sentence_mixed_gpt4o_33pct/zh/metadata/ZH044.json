      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 69,
      "paragraph_index": 24,
      "origin": "human",
      "text": "早晨起來，一定會推不開門吧！",
      "output_sha256": "8e1a5825d12f447db4a749a9129a432cd075bb8377f683ff80a050a09b91993e",
      "alignment_unit_index": 62,
      "alignment_score": null,
