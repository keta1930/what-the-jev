      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 70,
      "paragraph_index": 24,
      "origin": "human",
      "text": "記得爺爺說過：大雪的年頭，小孩站在雪裏露不出頭頂……風不住掃打窗子，狗在房後哽哽地叫……",
      "output_sha256": "4c2ae92cc37939a91ade0aebfd96d77fb1308b98ce00c583c7df96623da911fe",
      "alignment_unit_index": 63,
      "alignment_score": null,
