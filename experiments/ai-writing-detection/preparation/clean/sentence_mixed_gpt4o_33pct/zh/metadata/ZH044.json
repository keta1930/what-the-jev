      ],
      "source_ai_sentence_index": 59,
      "source_ai_sha256": "417e2a549c297959e807c65cafb886c27bd68380f5a95409ed96cce49a60bd71",
      "ai_unit_sentence_indices": [
        59
      ]
    },
    {
      "sentence_index": 66,
      "paragraph_index": 23,
      "origin": "ai",
      "text": "不久，他又沉沉入眠。",
      "output_sha256": "0ec0fc79769fae46fcaf6911b9baf5397a9b3e1ee89892fde7d64899976bfac6",
      "alignment_unit_index": 59,
      "alignment_score": 0.345,
