      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 68,
      "paragraph_index": 24,
      "origin": "human",
      "text": "夜間，大雪又不知落得怎樣了！",
      "output_sha256": "f60c05d0f4146b520f8ecd34e70feea5b8c26f31f48d27f436e56ae8fd124d0b",
      "alignment_unit_index": 61,
      "alignment_score": null,
