      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 64,
      "paragraph_index": 23,
      "origin": "human",
      "text": "是物質的反映。",
      "output_sha256": "c3f7467d0c3cfaddbda9a8dfc9141d3d9b02bab0b7042df2ed49229c48b222fc",
      "alignment_unit_index": 57,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "c3f7467d0c3cfaddbda9a8dfc9141d3d9b02bab0b7042df2ed49229c48b222fc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 65,
      "paragraph_index": 23,
      "origin": "ai",
      "text": "你摸摸你的肩膀，冷得這樣，你感受到肩膀的寒冷，自然就會做那樣的夢！”",
      "output_sha256": "417e2a549c297959e807c65cafb886c27bd68380f5a95409ed96cce49a60bd71",
      "alignment_unit_index": 58,
      "alignment_score": 0.607527,
