      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 68,
      "paragraph_index": 27,
      "origin": "human",
      "text": "怕是再去兩天，再去等幾個鐘頭，病人就會自然而然地好起來！",
      "output_sha256": "277cc4325e2f7570e7f6925617ac96f0c94a45f0d40b2838b1576a9e4767db83",
      "alignment_unit_index": 59,
