      ],
      "source_ai_sentence_index": 55,
      "source_ai_sha256": "cdd50854570162d7e758824fee0b43e51f356d26de0f698af683fc34eeeacefa",
      "ai_unit_sentence_indices": [
        55
      ]
    },
    {
      "sentence_index": 63,
      "paragraph_index": 25,
      "origin": "human",
      "text": "醫生告訴我，明天再來一次，好把藥給我。",
      "output_sha256": "077d4a2cc28a1de6ce0c1f7632143fa84b826642eb1f8d747506b7b9fb6aebfb",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 62,
