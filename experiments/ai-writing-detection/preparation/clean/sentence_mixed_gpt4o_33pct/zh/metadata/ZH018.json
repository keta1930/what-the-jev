      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 11,
      "origin": "human",
      "text": "一九三三年十二月",
      "output_sha256": "9df377e9b7227de811cc76dd8547593879d2ea111b11579e86dbd91b0c8524ef",
