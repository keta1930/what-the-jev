      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 13,
      "origin": "human",
      "text": "那天晚上我陪你在新亚等朋友，我曾向你给“良友”定货——短篇小说。",
      "output_sha256": "ff1f7af5b8908a4d37ac3b3dc47ee44c8eee4f3fac7e95e1e2aef54683ad256d",
      "alignment_unit_index": 58,
