      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 13,
      "origin": "human",
      "text": "那时天气实在很热，大概你后来就把我那定单化汗飞了，所以现在忘得干干净净。",
      "output_sha256": "1d0e5242976d92fe6d3dd4957c995e00132a68d0cdcfd076d21b88577714c003",
      "alignment_unit_index": 59,
      "alignment_score": null,
      "source_human_sentence_index": 64,
