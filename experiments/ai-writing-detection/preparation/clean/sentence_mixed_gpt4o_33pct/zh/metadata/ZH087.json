      ],
      "source_ai_sentence_index": 14,
      "source_ai_sha256": "735b7337d0b2ff5d0a08270aeac5e2828a8585b27313fff0396ac9b909563856",
      "ai_unit_sentence_indices": [
        14
      ]
    },
    {
      "sentence_index": 15,
      "paragraph_index": 5,
      "origin": "human",
      "text": "可不是嗎！",
      "output_sha256": "0370932bb260d7be169f54425399e9c33540fe8d04fdcda0db00fb47a96a93a3",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "0370932bb260d7be169f54425399e9c33540fe8d04fdcda0db00fb47a96a93a3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "差不多……海浪三尺，船高約二十三尺。”",
      "output_sha256": "38ac2df5c66c0ea2414d06ed2f8fbe4f2e5b5d4efea3f01a3062ac3ea28e38d6",
      "alignment_unit_index": 16,
      "alignment_score": 0.857143,
      "human_sentence_indices": [
        17
      ],
      "human_sha256": [
        "33c5d62e16475543deb287a072163ccca2f2742859c123e8f54bd46bfc19baad"
      ],
      "source_ai_sentence_index": 16,
      "source_ai_sha256": "38ac2df5c66c0ea2414d06ed2f8fbe4f2e5b5d4efea3f01a3062ac3ea28e38d6",
      "ai_unit_sentence_indices": [
        16
      ]
    },
    {
      "sentence_index": 17,
      "paragraph_index": 6,
      "origin": "human",
      "text": "也有時因爲我反覆着說：“有那麼高嗎？",
      "output_sha256": "815f0613f4dc6c1e2a070ca70deb22647150749f8be60564dd90c1bbd305caff",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "815f0613f4dc6c1e2a070ca70deb22647150749f8be60564dd90c1bbd305caff",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 6,
      "origin": "human",
      "text": "沒有吧！",
      "output_sha256": "a428b6385927646f8b615d86dfadd4f9e40c26265fe7fc790af2c48679c41929",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "a428b6385927646f8b615d86dfadd4f9e40c26265fe7fc790af2c48679c41929",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 6,
      "origin": "human",
      "text": "也許有！”",
      "output_sha256": "dde597bd97b15e029aa3d7cc82ece843b2eb44a46d40915a53915048049d7efc",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "dde597bd97b15e029aa3d7cc82ece843b2eb44a46d40915a53915048049d7efc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 7,
      "origin": "human",
      "text": "郎華聽了就生起氣了，因爲海船的事差不多在街上就吵架……",
      "output_sha256": "a61fd19e6529c64c4ad743ed4c2cb6d9894a9eb814300e680e9ab3dd5a07d889",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 21,
      "source_human_sha256": "a61fd19e6529c64c4ad743ed4c2cb6d9894a9eb814300e680e9ab3dd5a07d889",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 8,
      "origin": "human",
      "text": "可是朋友們不知道我們要走。",
      "output_sha256": "4e2ed5d8ef6b5a1ec5a2dcb026ced368ef74d0de6a05e7040c7ea6162b9a39ac",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "4e2ed5d8ef6b5a1ec5a2dcb026ced368ef74d0de6a05e7040c7ea6162b9a39ac",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "有一天，我們在胖朋友家裡舉杯暢飲，嘴裡嚼著燒雞，郎華想要發言，我卻制止了他，但他還是說了出來。",
      "output_sha256": "8c9e1b25a62b6348abfd26557952d6613d88c012980df03380adffabaead1b2a",
      "alignment_unit_index": 22,
      "alignment_score": 0.523367,
      "human_sentence_indices": [
        23
      ],
      "human_sha256": [
        "1cac9b04eb9cc0fb00e84450d95e54f14f05d8f42df384cc221c57a0183de354"
      ],
      "source_ai_sentence_index": 22,
      "source_ai_sha256": "8c9e1b25a62b6348abfd26557952d6613d88c012980df03380adffabaead1b2a",
      "ai_unit_sentence_indices": [
        22
      ]
    },
    {
      "sentence_index": 23,
      "paragraph_index": 9,
      "origin": "human",
      "text": "“走了好！",
      "output_sha256": "6e46cde13da2c30a0c8e484a74c2f50fbbb57420de2b25177ddac5b35884524e",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "6e46cde13da2c30a0c8e484a74c2f50fbbb57420de2b25177ddac5b35884524e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "我覺得你早就該走！”",
      "output_sha256": "e8e439b88f19471de689f2e7af07b1413b42ac362b7e6593ed993fdb154a7074",
      "alignment_unit_index": 24,
      "alignment_score": 0.693333,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "aa343d92ca5d1fcc9495ae6eda8d51f60dfba47206b08d06c6a9a398a88b2dc4"
      ],
      "source_ai_sentence_index": 24,
      "source_ai_sha256": "e8e439b88f19471de689f2e7af07b1413b42ac362b7e6593ed993fdb154a7074",
      "ai_unit_sentence_indices": [
        24
      ]
    },
    {
      "sentence_index": 25,
      "paragraph_index": 9,
      "origin": "human",
      "text": "以前胖朋友常這樣說：“郎華，你走吧！",
      "output_sha256": "eb5cbd565d0086d84552b888dca3d73d0b552a2623905bc026d873fcebc6606d",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "eb5cbd565d0086d84552b888dca3d73d0b552a2623905bc026d873fcebc6606d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 9,
      "origin": "human",
      "text": "我給你們對付點路費。",
      "output_sha256": "73acda3f503011c8331b35ca18d66176560d57da25a35d9e7a65b5defe1da8c7",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "73acda3f503011c8331b35ca18d66176560d57da25a35d9e7a65b5defe1da8c7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 9,
      "origin": "human",
      "text": "我天天在××科裏邊聽着問案子。",
      "output_sha256": "aa65edef0fc7cbd0973b73708472445c249729ae7a46d4272b3256fd416bb314",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "aa65edef0fc7cbd0973b73708472445c249729ae7a46d4272b3256fd416bb314",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 9,
      "origin": "human",
      "text": "皮鞭子打得那個響！",
      "output_sha256": "11c6e03e2976514aabb40c1cbd32c9fdb44125e7ef5184d541a80b1e94375458",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "11c6e03e2976514aabb40c1cbd32c9fdb44125e7ef5184d541a80b1e94375458",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 9,
      "origin": "human",
      "text": "哎，走吧！",
      "output_sha256": "f3db34d7b685d93d6d89062f3f107dc651db4db925ea18e7cdd65e86083a49ea",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 30,
      "source_human_sha256": "f3db34d7b685d93d6d89062f3f107dc651db4db925ea18e7cdd65e86083a49ea",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "如果我的朋友也能去……那聲音可怎麼聽？",
      "output_sha256": "58e19d906e1421c96f398e7a59e6413cdf6cee057420397a2c969e1ff1dce20e",
      "alignment_unit_index": 29,
      "alignment_score": 0.704038,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "cbf22eea21c91e304cb558ad2314b6c771895a9b337d962450e6c31257304374"
      ],
      "source_ai_sentence_index": 29,
      "source_ai_sha256": "58e19d906e1421c96f398e7a59e6413cdf6cee057420397a2c969e1ff1dce20e",
      "ai_unit_sentence_indices": [
        29
      ]
    },
    {
      "sentence_index": 31,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "看著路上的行人，我就想到了你……”",
      "output_sha256": "878a1832afc0f7fb8e412a43d513607eda34c46930f6bf53175fe6a812147115",
      "alignment_unit_index": 30,
      "alignment_score": 0.582466,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "5e22d5abc5d8b50d41a7f46828947a23e0a461426e68558f770ee4dde1195050"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "878a1832afc0f7fb8e412a43d513607eda34c46930f6bf53175fe6a812147115",
      "ai_unit_sentence_indices": [
        30
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 10,
      "origin": "human",
      "text": "老秦來了，他是穿着一件嶄新的外套，看起來帽子也是新的，不過沒有問他，他自己先說：",
      "output_sha256": "fddd6c67aca1df392acead1c8a4504104a079db13bb61db8f6d4652fbcf95a90",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "fddd6c67aca1df392acead1c8a4504104a079db13bb61db8f6d4652fbcf95a90",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 11,
      "origin": "human",
      "text": "“你們看我穿新外套了吧？",
      "output_sha256": "7d9b14d870a890249994e48da5fed70d74ce7b05fdd684b70705179a6b741e41",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "7d9b14d870a890249994e48da5fed70d74ce7b05fdd684b70705179a6b741e41",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 34,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "非去上海不可，忙著做了兩件衣服，好去典當行，賣掉舊物，新的也能值幾個錢……”",
      "output_sha256": "320a7e47b61b31ec5cd5bc6726459b73013f1381abacdcec9355dd28e41959a1",
      "alignment_unit_index": 33,
      "alignment_score": 0.671382,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "222403e9d4939d7b898b7ca5177bf612dd4dbe53488dfedfecb7a5d302381fb0"
      ],
      "source_ai_sentence_index": 33,
      "source_ai_sha256": "320a7e47b61b31ec5cd5bc6726459b73013f1381abacdcec9355dd28e41959a1",
      "ai_unit_sentence_indices": [
        33
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 12,
      "origin": "human",
      "text": "聽了這話，我們很高興，想不說也不可能：“我們也走，非走不可，在這個地方等着活剝皮嗎？”",
      "output_sha256": "fd806cd5a2c1d1316be979500b8290752f270bffa87b0f1491bdaa866d1f2cd9",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "fd806cd5a2c1d1316be979500b8290752f270bffa87b0f1491bdaa866d1f2cd9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "郎華說完便笑了：“你們什麼時候走？”",
      "output_sha256": "a0c9121f930b434f3e812f57c3fcf6fc40cabd7adb16c76eb83cb97d84cdf424",
      "alignment_unit_index": 35,
      "alignment_score": 0.769538,
      "human_sentence_indices": [
        37
      ],
      "human_sha256": [
        "19f268e7a61a428a4b371e6d4d37060e97ab8a62ef735dfce1fcc86fa9922bbf"
      ],
      "source_ai_sentence_index": 35,
      "source_ai_sha256": "a0c9121f930b434f3e812f57c3fcf6fc40cabd7adb16c76eb83cb97d84cdf424",
      "ai_unit_sentence_indices": [
        35
      ]
    },
    {
      "sentence_index": 37,
      "paragraph_index": 13,
      "origin": "human",
      "text": "“那麼你們呢？”",
      "output_sha256": "a385b71450832a4b08cbfa562e919a28d41faf4d397ca7e385120e69eaee22fe",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "a385b71450832a4b08cbfa562e919a28d41faf4d397ca7e385120e69eaee22fe",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 14,
      "origin": "human",
      "text": "“我們沒有一定。”",
      "output_sha256": "f1c180d5c38e02e8dbeb7fa44d2f8142b3bf39ed266ffcd8511621a129da203b",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "f1c180d5c38e02e8dbeb7fa44d2f8142b3bf39ed266ffcd8511621a129da203b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 15,
      "origin": "human",
      "text": "“走就五六月走，海上浪小……”",
      "output_sha256": "82b5efcf5018373f095976cb8562bc1abfb096bc3c0a121f989182695a1ed480",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "82b5efcf5018373f095976cb8562bc1abfb096bc3c0a121f989182695a1ed480",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 16,
      "origin": "ai",
      "text": "“那我們一起走吧！”",
      "output_sha256": "7fa9d907a50532e7d6967cfdfc9f015f9dcc7b776feb5100bfb285ad830d84e4",
      "alignment_unit_index": 39,
      "alignment_score": 0.65,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "97484d87165d721a5a36ed525992619c423f432b94cf780aa0b1d4f131e54800"
      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "7fa9d907a50532e7d6967cfdfc9f015f9dcc7b776feb5100bfb285ad830d84e4",
      "ai_unit_sentence_indices": [
        39
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 17,
      "origin": "human",
      "text": "老秦並不認爲我們是真話，大家隨便說了不少關於走的事情，怎樣走法呢？",
      "output_sha256": "8c74ac09bf447e8baae81e17f31f172733ee284469b7ac43a2dc3eeb66a82d62",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "8c74ac09bf447e8baae81e17f31f172733ee284469b7ac43a2dc3eeb66a82d62",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 17,
      "origin": "human",
      "text": "怕路上檢查，怕路上盤問，到上海什麼朋友也沒有，又沒有錢。",
      "output_sha256": "e77f88db3b152fb56662500868eef9196160d0769229d431f3d65bf400694f9c",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "e77f88db3b152fb56662500868eef9196160d0769229d431f3d65bf400694f9c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 17,
      "origin": "human",
      "text": "說得高興起來，逼真了！",
      "output_sha256": "e3bcce8e25247507666b51495c4f165044408ead47b7b84a00836b99f519ce85",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "e3bcce8e25247507666b51495c4f165044408ead47b7b84a00836b99f519ce85",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 17,
      "origin": "human",
      "text": "帶着幻想了！",
      "output_sha256": "868e69e4d4cb502b7265114023ff21c2b123a6d8cd009ccbd486623da7fd6da8",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "868e69e4d4cb502b7265114023ff21c2b123a6d8cd009ccbd486623da7fd6da8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 17,
      "origin": "human",
      "text": "老秦是到過上海的，他說四馬路怎樣怎樣！",
      "output_sha256": "c02a93549c5111e03453e1402f430ec50f0afe389ccd04c22afd2401b36a13f3",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "c02a93549c5111e03453e1402f430ec50f0afe389ccd04c22afd2401b36a13f3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 17,
      "origin": "human",
      "text": "他說上海的窮是怎樣的窮法……",
      "output_sha256": "31ea879a3760cda960299dacfc1e1a519725403e1d83a0b0ef17193cf6d7486e",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 47,
      "source_human_sha256": "31ea879a3760cda960299dacfc1e1a519725403e1d83a0b0ef17193cf6d7486e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 18,
      "origin": "human",
      "text": "他走了以後，雪還沒有停。",
      "output_sha256": "900f5aae065bae66bd9b72cec2485022d2c0236d6abb9cd0a5035d9f8d889130",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "900f5aae065bae66bd9b72cec2485022d2c0236d6abb9cd0a5035d9f8d889130",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 48,
      "paragraph_index": 18,
      "origin": "human",
      "text": "我把火爐又放進一塊木柈去。",
      "output_sha256": "0396a967b20b2fc700dd0590f3aecedd198999e91004d28de5ae21117b2927d6",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "0396a967b20b2fc700dd0590f3aecedd198999e91004d28de5ae21117b2927d6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 18,
      "origin": "human",
      "text": "又到燒晚飯的時間了！",
      "output_sha256": "fae8c9cf5d3d9bef189f0b26ce42f8bbc00aa1658455eeaf888313be3f5059a0",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "fae8c9cf5d3d9bef189f0b26ce42f8bbc00aa1658455eeaf888313be3f5059a0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 18,
      "origin": "ai",
      "text": "我回想起去年，想到今年，注意到自己的手骨節略微腫脹，身高依然這麼高，還是這麼瘦……",
      "output_sha256": "f9d4a06bb6b9a540ee83dd24f59a07e1789758351f8a6fb566b53cd6a6acf573",
      "alignment_unit_index": 46,
      "alignment_score": 0.573189,
      "human_sentence_indices": [
        51
      ],
      "human_sha256": [
        "1e2dd8d73257c74a12ed07a9bbe8b7838d53d66a46ea51de0b5cd13423bb3c43"
      ],
      "source_ai_sentence_index": 46,
      "source_ai_sha256": "f9d4a06bb6b9a540ee83dd24f59a07e1789758351f8a6fb566b53cd6a6acf573",
      "ai_unit_sentence_indices": [
        46
      ]
    },
    {
      "sentence_index": 51,
      "paragraph_index": 19,
      "origin": "human",
      "text": "這房子我看得太熟了，至於牆上或是棚頂有幾個多餘的釘子，我都知道。",
      "output_sha256": "7b17adeda1b9fcf6d3cd37c97dcf70f161a7706f971af870a037b097a222bdc5",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 52,
      "source_human_sha256": "7b17adeda1b9fcf6d3cd37c97dcf70f161a7706f971af870a037b097a222bdc5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 19,
      "origin": "human",
      "text": "郎華呢？",
      "output_sha256": "1446f84c6b07328388e61f769f9899030b6f34fd7ea3cebfb34c4529787b29ea",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "1446f84c6b07328388e61f769f9899030b6f34fd7ea3cebfb34c4529787b29ea",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 19,
      "origin": "ai",
      "text": "沒有變瘦或變胖，他還是那樣，從我認識他那時起，他就是那幅模樣，顴骨高，眼睛小，嘴巴大，鼻子像根柱子。",
      "output_sha256": "533bfe5f7644806e7a6186998a77be3aeff9c11a89e76d54cc9f5a1a6c2848cb",
      "alignment_unit_index": 49,
      "alignment_score": 0.657508,
      "human_sentence_indices": [
        54
      ],
      "human_sha256": [
        "713fa3fc8358fe0cf09c1319527517a67498f6a0bbea279505f7f2f31751421c"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "533bfe5f7644806e7a6186998a77be3aeff9c11a89e76d54cc9f5a1a6c2848cb",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 54,
      "paragraph_index": 20,
      "origin": "human",
      "text": "“我們吃什麼飯呢？",
      "output_sha256": "bfb2ae94971e2dcab605893100bfb323ec2dc63a2c077444e364f16629e7a75c",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "bfb2ae94971e2dcab605893100bfb323ec2dc63a2c077444e364f16629e7a75c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 20,
      "origin": "human",
      "text": "吃麪或是飯？”",
      "output_sha256": "62f68eaa77fb960127e22d9b335ce32d5c28aa89c0ea13287ee03ed8e7eb1a77",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "62f68eaa77fb960127e22d9b335ce32d5c28aa89c0ea13287ee03ed8e7eb1a77",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 21,
      "origin": "ai",
      "text": "居然我們有米有麵了，這與去年截然不同，突然那些回憶緊緊牽住了我……借到兩角錢或一角錢……空手跑回來……抱著新棉袍去典當行。",
      "output_sha256": "ceab2ef05c228c3bf515015371d3ea212d71393a0680c24e6bca91ea724c22d8",
      "alignment_unit_index": 52,
      "alignment_score": 0.719717,
      "human_sentence_indices": [
        57
      ],
      "human_sha256": [
        "62291ef5076dc77fd48fe380a9f779bfd8bf210fca41ff06d747c90509967fa3"
      ],
      "source_ai_sentence_index": 52,
      "source_ai_sha256": "ceab2ef05c228c3bf515015371d3ea212d71393a0680c24e6bca91ea724c22d8",
      "ai_unit_sentence_indices": [
        52
      ]
    },
    {
      "sentence_index": 57,
      "paragraph_index": 22,
      "origin": "human",
      "text": "我想到我凍傷的腳，下意識地看了一下腳。",
      "output_sha256": "e7d9dc4a27b6fa5e20b8a8860d735d712ad79d59f3b79ed72a3e1ef0b03d4ea1",
      "alignment_unit_index": 53,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "e7d9dc4a27b6fa5e20b8a8860d735d712ad79d59f3b79ed72a3e1ef0b03d4ea1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 22,
      "origin": "human",
      "text": "於是又想到柈子，那樣多的柈子，燒吧！",
      "output_sha256": "209985c6d7f2f277a9b0553c175908f931e8577c895cabb67bafef5a7049fc46",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "209985c6d7f2f277a9b0553c175908f931e8577c895cabb67bafef5a7049fc46",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 22,
      "origin": "ai",
      "text": "我便又去搬了一些木柴進來。",
      "output_sha256": "ea3c132af4b4196c9d2b710d4a221b91f2f3407c88d3393f97b8ce7aa3faca10",
      "alignment_unit_index": 55,
      "alignment_score": 0.593939,
      "human_sentence_indices": [
        60
      ],
      "human_sha256": [
        "8f7ffc12d2997234b69eaa505f3b520b392529559e0d1e29a9124a4b9a9c73a0"
      ],
      "source_ai_sentence_index": 55,
      "source_ai_sha256": "ea3c132af4b4196c9d2b710d4a221b91f2f3407c88d3393f97b8ce7aa3faca10",
      "ai_unit_sentence_indices": [
        55
      ]
    },
    {
      "sentence_index": 60,
      "paragraph_index": 23,
      "origin": "human",
      "text": "他仍把兩手插在褲袋，在地上打轉；一說到關於走，他不住地打轉，轉起半點鐘來也是常常的事。",
      "output_sha256": "3a421451231359c7d9948533f0aa06f4b241f9cf96303a264396d3e8e46cb7d6",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "3a421451231359c7d9948533f0aa06f4b241f9cf96303a264396d3e8e46cb7d6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 24,
      "origin": "ai",
      "text": "秋天，我們已經安裝好了電燈。",
      "output_sha256": "a84329d7f701c9f2e54a0a131bc2a24d5e3b5257b244cdcabc51e1ee32bc0e68",
      "alignment_unit_index": 57,
      "alignment_score": 0.680507,
      "human_sentence_indices": [
        62
      ],
      "human_sha256": [
        "16b5da67540d812a1189185006f27bbe41cc3dfd19082d32327efa58b694fc1b"
      ],
      "source_ai_sentence_index": 57,
      "source_ai_sha256": "a84329d7f701c9f2e54a0a131bc2a24d5e3b5257b244cdcabc51e1ee32bc0e68",
      "ai_unit_sentence_indices": [
        57
      ]
    },
    {
      "sentence_index": 62,
      "paragraph_index": 24,
      "origin": "ai",
      "text": "我在燈下抄寫自己的稿子。",
      "output_sha256": "e90803ce30c269d0306082cd33b8e2f744d02d1b1307860b98c3fb2e253ab949",
      "alignment_unit_index": 58,
      "alignment_score": 0.853571,
      "human_sentence_indices": [
        63
      ],
      "human_sha256": [
        "8728bb6c2fb05c14697b9e01272b967aa8092fab9a76b3d9919e25d54b9e311a"
      ],
      "source_ai_sentence_index": 58,
      "source_ai_sha256": "e90803ce30c269d0306082cd33b8e2f744d02d1b1307860b98c3fb2e253ab949",
      "ai_unit_sentence_indices": [
        58
      ]
    },
    {
      "sentence_index": 63,
      "paragraph_index": 24,
      "origin": "ai",
      "text": "郎華又跑出去玩，這與去年不同，今年他不再到外面當家庭教師了。",
      "output_sha256": "c8a09319d3a5be7fe43103e541b0e60f97361d170f24c48ac03ae35f64a7485f",
      "alignment_unit_index": 59,
      "alignment_score": 0.775106,
      "human_sentence_indices": [
        64
