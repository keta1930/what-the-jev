      "source_ai_sentence_index": 12,
      "source_ai_sha256": "315678ecf8dfad94981b28acc88eb02af6dd8861b4d30aa80395dfa1e7eaac89",
      "ai_unit_sentence_indices": [
        12
      ]
    },
    {
      "sentence_index": 13,
      "paragraph_index": 5,
      "origin": "human",
      "text": "“哪有六丈？”",
      "output_sha256": "bf280f2d32b9414e28a1620a7dd599c8445e7f860de7b9f4de2c06c342956d26",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "bf280f2d32b9414e28a1620a7dd599c8445e7f860de7b9f4de2c06c342956d26",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "郎華反駁我，他重新量了量：“哼！",
      "output_sha256": "735b7337d0b2ff5d0a08270aeac5e2828a8585b27313fff0396ac9b909563856",
      "alignment_unit_index": 14,
      "alignment_score": 0.593939,
      "human_sentence_indices": [
