      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "窗外的大雪如同白絨一般，持續不斷地飄落，整日未曾停歇。",
      "output_sha256": "3203287f0a7207a55202b20845db577af8687766d3989cd5e30af80b49a675d8",
      "alignment_unit_index": 1,
      "alignment_score": 0.490062,
