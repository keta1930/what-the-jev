      ],
      "human_sha256": [
        "9827d7327eb47be316e8658c407fbd5cf554ce84c324ff569a84b77049e33541"
      ],
      "source_ai_sentence_index": 70,
      "source_ai_sha256": "40f556abfcc5ed6483aec40889677cab9849afff8135735322e26d1eaf57c90f",
      "ai_unit_sentence_indices": [
        70
      ]
    },
    {
      "sentence_index": 74,
      "paragraph_index": 31,
      "origin": "ai",
      "text": "因此，我哭著，直到祖父去世的那一刻，我都在哭泣。",
      "output_sha256": "74f34953c2c2a923faf3629d5c54529f40602fd980886638a960247e516cfb46",
