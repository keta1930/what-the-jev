  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "搬家！",
      "output_sha256": "29452d6ce6e9c37726a40f0894e2ef7056eb03a60ffe07eb0682f282d6d86404",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
