      "ai_unit_sentence_indices": [
        64
      ]
    },
    {
      "sentence_index": 65,
      "paragraph_index": 33,
      "origin": "human",
      "text": "“十五歲吧！”",
      "output_sha256": "53783dc266824298aa033a01fd9b9d5ac0bd97dcfb80bb27d1e317c046db3b0b",
      "alignment_unit_index": 65,
      "alignment_score": null,
      "source_human_sentence_index": 65,
      "source_human_sha256": "53783dc266824298aa033a01fd9b9d5ac0bd97dcfb80bb27d1e317c046db3b0b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 66,
      "paragraph_index": 34,
      "origin": "ai",
      "text": "“你太小了，學校通常不太注意小同學。”",
      "output_sha256": "d7b2a21a1180fa44462cef2b80a536085af4d6ffc6f7820989797a881751421e",
      "alignment_unit_index": 66,
      "alignment_score": 0.627309,
      "human_sentence_indices": [
