      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Well, it is his own risk.",
      "output_sha256": "7707e3efa164fb034dbe0a868a65898f1b071c934c21c670b4a3d969de13b751",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 30,
