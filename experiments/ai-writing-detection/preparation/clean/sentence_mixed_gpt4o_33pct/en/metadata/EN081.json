      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Here goes. … What I say is that, if a man really likes potatoes, he must be a pretty decent sort of fellow.",
