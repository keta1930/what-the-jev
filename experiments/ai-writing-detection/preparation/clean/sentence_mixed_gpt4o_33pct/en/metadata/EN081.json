      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 7,
      "origin": "human",
      "text": "The panorama flashes by outside, nearer and nearer comes the beautiful West; you cross rivers and hurry by little villages, you pass slowly and reverently through strange old towns … and, inside, the waiter leaves the potatoes next to you and slips away.",
      "output_sha256": "573ee789e5c56ac6a78b558ee383785f6723178c2144685f2de09f23b08a8f19",
