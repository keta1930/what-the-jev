  "mixed_article_sha256": "e6e84899d3a039acf7e7d2f24dc8c73f215be860e882eece26a2423f27fdd4f0",
  "human_source_sentence_count": 50,
  "ai_source_sentence_count": 51,
  "alignment_unit_count": 48,
  "selected_alignment_unit_count": 15,
  "mixed_sentence_count": 53,
  "selected_ai_sentence_count": 18,
  "actual_ai_sentence_ratio": 0.339623,
