  "mixed_article_sha256": "d02a884562fd1028999ce3f5496e9438b19c254770cc4a741c6898b121f0cf13",
  "human_source_sentence_count": 70,
  "ai_source_sentence_count": 66,
  "alignment_unit_count": 65,
  "selected_alignment_unit_count": 22,
  "mixed_sentence_count": 66,
  "selected_ai_sentence_count": 22,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.243697,
