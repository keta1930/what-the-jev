  "ai_article_sha256": "322b60ff5ded1f4819a0a9fea21bbc9cd5fd24934aa714dbf3a7fca5c7d62cd3",
  "mixed_article_sha256": "d5e99cee25b297fdcffd3a0a27a7a27ab6fc574d874401e274b3bffe5bbe5b48",
  "human_source_sentence_count": 58,
  "ai_source_sentence_count": 57,
  "alignment_unit_count": 56,
  "selected_alignment_unit_count": 18,
  "mixed_sentence_count": 57,
  "selected_ai_sentence_count": 19,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.293785,
  "selected_alignment_score_median": 0.534694,
  "selected_alignment_score_max": 0.91,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "Mr. George Robey, C.B.E., often referred to as the Prime Minister of Mirth, tends to embody a more destructive philosophical outlook rather than one that offers reassurance in his songs.",
      "output_sha256": "f815b105102045618a31f7f1a314eda8c4e82bd4de0b85ac5851659ed3c03f61",
      "alignment_unit_index": 1,
      "alignment_score": 0.5615,
      "human_sentence_indices": [
        1
      ],
      "human_sha256": [
        "066959a68b54a0bd5001b60ef6ad2c3c5c238ee3e583159efecf36709d9d7ac0"
      ],
      "source_ai_sentence_index": 1,
      "source_ai_sha256": "f815b105102045618a31f7f1a314eda8c4e82bd4de0b85ac5851659ed3c03f61",
      "ai_unit_sentence_indices": [
        1
      ]
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Indeed, the cheerful cynicism of one whose prosperity is invulnerable may be said to be his prevailing characteristic on the stage.",
      "output_sha256": "c9523d0a83c4ce6de6480387c4515ce389c1451d57f54687f1870f74244754c5",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "c9523d0a83c4ce6de6480387c4515ce389c1451d57f54687f1870f74244754c5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "However, there was a moment when he adopted the persona of a landlady, singing a tune that offered solace to those who find themselves in less fortunate circumstances: \"It's a blessing that you never miss the things you've never had.\"",
      "output_sha256": "335de393e06eb1e40c99c1d36036872b95ad1245698a9178b5e42757e6318b8d",
      "alignment_unit_index": 3,
      "alignment_score": 0.569035,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "5e6b20b72680a70f8f05ce18cfb20bc2b9ff611260b04fe398911fe2cc394572"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "335de393e06eb1e40c99c1d36036872b95ad1245698a9178b5e42757e6318b8d",
      "ai_unit_sentence_indices": [
        3
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Upon the respective merits of this sentiment and of Tennyson's famous dictum \"'Tis better to have loved and lost than never to have loved at all\" much might be said in discussion, although the two statements are not antagonistic; but at the moment, thinking of my poor friend the Golden Eagle, I vote wholly for Mr. Robey's optimism.",
      "output_sha256": "cfa57ec84c3bf0ae1d07919037c8f3a455dc556ae404a4c49938d8e3f32e773a",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "cfa57ec84c3bf0ae1d07919037c8f3a455dc556ae404a4c49938d8e3f32e773a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It is a blessing that we never miss the things we've never had, and, conversely, it is a real calamity to lose something and be unable to forget it or to cease to regret it.",
      "output_sha256": "bf2a8a23aa9b288aea9ee1534b21366237a1edc3faec2c277af1a5c0e4645f05",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 5,
      "source_human_sha256": "bf2a8a23aa9b288aea9ee1534b21366237a1edc3faec2c277af1a5c0e4645f05",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "human",
      "text": "In other words, it is better not to have had a treasure than, being parted from it, to be eternally wistful.",
      "output_sha256": "f2a0815ea81dc8eb0239e5b8cea6a12101f24cc043bc0dd4b2772bf303016a93",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "f2a0815ea81dc8eb0239e5b8cea6a12101f24cc043bc0dd4b2772bf303016a93",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Better, that is, for unwilling auditors of the tragedy.",
      "output_sha256": "5028c7812f5880c58835b5aafb3001a1e3c68558837514e4020ca6383643041b",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 7,
      "source_human_sha256": "5028c7812f5880c58835b5aafb3001a1e3c68558837514e4020ca6383643041b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 2,
      "origin": "human",
      "text": "So much for prelude.",
      "output_sha256": "dcae80ba51bacbe5a486b6b7fb40c674dbbb61fdec6b59c10246d910180e231f",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "dcae80ba51bacbe5a486b6b7fb40c674dbbb61fdec6b59c10246d910180e231f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "It is undoubtedly challenging to be perceived as powerful while lacking the means to assist a trusting individual who relies on one's support.",
      "output_sha256": "e5e2885015ff3a0e1bff17da9248b9e677f860126645f8d72de90d14ba6c6af1",
      "alignment_unit_index": 9,
      "alignment_score": 0.385109,
      "human_sentence_indices": [
        9
      ],
      "human_sha256": [
        "6d517281185b80ec7ff44e26c66a8b624a58112d6c625c8171cf70da9ed6a60c"
      ],
      "source_ai_sentence_index": 9,
      "source_ai_sha256": "e5e2885015ff3a0e1bff17da9248b9e677f860126645f8d72de90d14ba6c6af1",
      "ai_unit_sentence_indices": [
        9
      ]
    },
    {
      "sentence_index": 10,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "This is a general observation, yet it was brought to mind by a recent comment about Baedeker.",
      "output_sha256": "c00e79afabf69095213826b7534e87c1b6a5444d96f7b16d21210a5d7a054dc0",
      "alignment_unit_index": 10,
      "alignment_score": 0.293785,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "3c3b4f082a18807618e0cc381d9669eda44d48e95fa1e3bfe11d34f4b24298d5"
      ],
      "source_ai_sentence_index": 10,
      "source_ai_sha256": "c00e79afabf69095213826b7534e87c1b6a5444d96f7b16d21210a5d7a054dc0",
      "ai_unit_sentence_indices": [
        10
      ]
    },
    {
      "sentence_index": 11,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "\"Will those of us who have retained our Baedekers have the courage to carry them?\" someone posed, and my thoughts immediately drifted to an Italian city and the proprietor of the Aquila d'Oro.",
      "output_sha256": "fce2cd5d000a3e92a3698d7818550ef09ad7fcaab247b5bacd2ea106572a16c1",
      "alignment_unit_index": 11,
      "alignment_score": 0.657839,
      "human_sentence_indices": [
        11
      ],
      "human_sha256": [
        "d8818c68e8766837a512cbc4bd2ef34fe334446c581c94deccf17c80de0339e8"
      ],
      "source_ai_sentence_index": 11,
      "source_ai_sha256": "fce2cd5d000a3e92a3698d7818550ef09ad7fcaab247b5bacd2ea106572a16c1",
      "ai_unit_sentence_indices": [
        11
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "During my brief stay at his establishment, I received an unprecedented level of attention from the host.",
      "output_sha256": "4a539dcbf4e49ac9dc17b1011d7a10e7514c4ee9d292d600455a9a90e9c51340",
      "alignment_unit_index": 12,
      "alignment_score": 0.300831,
      "human_sentence_indices": [
        12
      ],
      "human_sha256": [
        "d463cfe156e60cc2bb1142df00f4c4a660badb734995cf8cd76eb658f33256d3"
      ],
      "source_ai_sentence_index": 12,
      "source_ai_sha256": "4a539dcbf4e49ac9dc17b1011d7a10e7514c4ee9d292d600455a9a90e9c51340",
      "ai_unit_sentence_indices": [
        12,
        13
      ]
    },
    {
      "sentence_index": 13,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Indeed, the dedication I received from him and his entire staff was remarkable.",
      "output_sha256": "5a360dd25935f11a0f574c9ae2b8e851eeb9e258ceb95a22b26baff8ff939b93",
      "alignment_unit_index": 12,
      "alignment_score": 0.300831,
      "human_sentence_indices": [
        12
      ],
      "human_sha256": [
        "d463cfe156e60cc2bb1142df00f4c4a660badb734995cf8cd76eb658f33256d3"
      ],
      "source_ai_sentence_index": 13,
      "source_ai_sha256": "5a360dd25935f11a0f574c9ae2b8e851eeb9e258ceb95a22b26baff8ff939b93",
      "ai_unit_sentence_indices": [
        12,
        13
      ]
    },
    {
      "sentence_index": 14,
      "paragraph_index": 4,
      "origin": "human",
      "text": "And not only from the host, but from every one on the staff, who bent earnest glances on me from morning till night.",
      "output_sha256": "e633c324566b9f86cd7a4fdf47a4af2ccfb67320a7b1b90001f055c07630b3b2",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "e633c324566b9f86cd7a4fdf47a4af2ccfb67320a7b1b90001f055c07630b3b2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 4,
      "origin": "human",
      "text": "The Golden Eagle himself, however, did more than that: he buttonholed me.",
      "output_sha256": "a5b61d605d92c98ded12bc166276b7819b51c304fb2ac5ed52139e98629bea00",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "a5b61d605d92c98ded12bc166276b7819b51c304fb2ac5ed52139e98629bea00",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 4,
      "origin": "human",
      "text": "He was always somewhere near the door when I went out and again when I came in: a large, flabby Italian, usually in his shirt sleeves and wearing the loose slippers that strike such dismay into British travellers.",
      "output_sha256": "dc4aca2783afa8285875fc9d72ef2491dd3ca5832b70121c059d03b8489006a8",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "dc4aca2783afa8285875fc9d72ef2491dd3ca5832b70121c059d03b8489006a8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 4,
      "origin": "human",
      "text": "\"No foreigner,\" said an acute young observer to me recently, \"ever has a good dog\"; not less true is it that no Latin is ever soundly shod.",
      "output_sha256": "2fd18c36a6a744be7934a900d4fc1fffd08a34f47fba5d218300a8208ac59442",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "2fd18c36a6a744be7934a900d4fc1fffd08a34f47fba5d218300a8208ac59442",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 4,
      "origin": "human",
      "text": "But the Golden Eagle was not exactly slovenly; he owed it to his hotel not to be that; he was merely a vigilant padrone eternally concerned with his business.",
      "output_sha256": "762a8f39419c15c858b3d80b67affae4cdbafeee99e59407e869e3da453412f6",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "762a8f39419c15c858b3d80b67affae4cdbafeee99e59407e869e3da453412f6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Although there were other people staying under his roof, and they had better rooms than I and drank a better wine, it was I at whom he made this set.",
      "output_sha256": "eb850ec62586051f3f725d5cf166cbd67ebc154cf87a1700f4199c632f49f124",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "eb850ec62586051f3f725d5cf166cbd67ebc154cf87a1700f4199c632f49f124",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 5,
      "origin": "human",
      "text": "It was I for whom he waited and upon whom his great melancholy eyes rested so wistfully.",
      "output_sha256": "3936f761911b5f9f0b253c0a18ba91de8224b332643c8fec6919a6ea5beea73d",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "3936f761911b5f9f0b253c0a18ba91de8224b332643c8fec6919a6ea5beea73d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 5,
      "origin": "human",
      "text": "For he was a Golden Eagle with a grievance, and I, in whose bedroom he had been asked to place a writing-table, I, who never went out without a note-book and who bought so many photographs, I, who so obviously was engaged in studying the city, no doubt for the purposes of a book, I it was who beyond question was in a position, by removing that grievance, to restore him to prosperity and placidity again.",
      "output_sha256": "86b1b5e3965c2d985eae151870057510551999b0216fe56edcfe0519cb6f377d",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "86b1b5e3965c2d985eae151870057510551999b0216fe56edcfe0519cb6f377d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 6,
      "origin": "human",
      "text": "And his grievance?",
      "output_sha256": "047367ca983e2f5c5edab48bb296903c152518dd594368b4b6476db46c471935",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 21,
      "source_human_sha256": "047367ca983e2f5c5edab48bb296903c152518dd594368b4b6476db46c471935",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The melancholy stamped upon that vast white countenance, although much of it was temperamental, and you might say national (for the Italian features in repose suggest disillusionment and fatalism far oftener than light-heartedness), and the dejection in the great shoulders, were due to the same cause.",
      "output_sha256": "2e803b2fa1fb426f229f82b9487458662dec09b57e9087f923e15768ea28c4db",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "2e803b2fa1fb426f229f82b9487458662dec09b57e9087f923e15768ea28c4db",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "Baedeker, after years of commendation for the Aquila d'Oro, had suddenly stripped his establishment of its asterisk in the latest edition.",
      "output_sha256": "dbe6f8f0d4111ad2613fe973c275d23410f93dcbec97f1dda919a82286ab13de",
      "alignment_unit_index": 23,
      "alignment_score": 0.534694,
      "human_sentence_indices": [
        23
      ],
      "human_sha256": [
        "5540d61f424c710da3ff0e2489d37e6480d0706947935a30cd7ab3ac1653bb3c"
      ],
      "source_ai_sentence_index": 25,
      "source_ai_sha256": "dbe6f8f0d4111ad2613fe973c275d23410f93dcbec97f1dda919a82286ab13de",
      "ai_unit_sentence_indices": [
        25
      ]
    },
    {
      "sentence_index": 25,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The Golden Eagle had lost his star.",
      "output_sha256": "37ea544ee34738d1afc821fd921905515c6962e43ddce827b1ae175ed83905bb",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "37ea544ee34738d1afc821fd921905515c6962e43ddce827b1ae175ed83905bb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Now you see the connection between this pathetic innkeeper (the last man in the world to call Boniface), our triumphant lion comique and the late Lord Tennyson.",
      "output_sha256": "14bfc25249517734d0fbd23dcd8dc36da6f8e3f56964c51dde05c2e9d4e9bbbc",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 25,
      "source_human_sha256": "14bfc25249517734d0fbd23dcd8dc36da6f8e3f56964c51dde05c2e9d4e9bbbc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 6,
      "origin": "human",
      "text": "But in his case it was not better, either for him or me, that he had lost what he had loved.",
      "output_sha256": "b5aa561f4f2f6dee2ceea16e9874b6543ac4a339d035a2f2bc4ca39f3d2b5bf0",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "b5aa561f4f2f6dee2ceea16e9874b6543ac4a339d035a2f2bc4ca39f3d2b5bf0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 6,
      "origin": "human",
      "text": "It would have been better, both for him and for me, if he had never had a star.",
      "output_sha256": "7fba9163647420ee1ea81ffd4eb5023de80bec4bfae369f60baf540f402bdc98",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "7fba9163647420ee1ea81ffd4eb5023de80bec4bfae369f60baf540f402bdc98",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Why it had been taken from him he had no notion.",
      "output_sha256": "600c5ab9a8dc84a11f634cc0c99066c2bca8bd49867f1fc02611b72c97b21595",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "600c5ab9a8dc84a11f634cc0c99066c2bca8bd49867f1fc02611b72c97b21595",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He had always done his best; his wife had done her best; people were satisfied and came again; but the star had gone.",
      "output_sha256": "fd94e90a12a947d3d345aebaffb20ae4830577e7c00aac116782fcdbc9160587",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "fd94e90a12a947d3d345aebaffb20ae4830577e7c00aac116782fcdbc9160587",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Was his hotel not clean?",
      "output_sha256": "df5116745b1a81885fa70a2b668b273a667d6b716e21ca6ba377db2f0b4b02a4",
      "alignment_unit_index": 30,
      "alignment_score": 0.91,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "c3a1eb23e87a550610f1e002e86605f71b52288ec3ac0e6fa760553c917c81d7"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "df5116745b1a81885fa70a2b668b273a667d6b716e21ca6ba377db2f0b4b02a4",
      "ai_unit_sentence_indices": [
        31
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 7,
      "origin": "human",
      "text": "The linen was soft, the attendance was good.",
      "output_sha256": "b99333c9115d4693e429fc45ef17ca8e6b48fea70c77dd64bb49e34f9b0a0849",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 31,
      "source_human_sha256": "b99333c9115d4693e429fc45ef17ca8e6b48fea70c77dd64bb49e34f9b0a0849",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "He personally supervised everything, as did his wife.",
      "output_sha256": "0160efeea83099d3a75f321d1d7571a02b91255e082e61674dfcbad65a0dbd69",
      "alignment_unit_index": 32,
      "alignment_score": 0.406864,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "d97b59dbee134153912b448a4743fec4092381fe25a79b86722d0f9198c9fa6f"
      ],
      "source_ai_sentence_index": 33,
      "source_ai_sha256": "0160efeea83099d3a75f321d1d7571a02b91255e082e61674dfcbad65a0dbd69",
      "ai_unit_sentence_indices": [
        33
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "They left no stone unturned in their quest to ensure guest comfort.",
      "output_sha256": "ddbd7f81ad3dad31f20f3b20d5b28de1646b4f416b59cbc6dfee63be74b891bc",
      "alignment_unit_index": 33,
      "alignment_score": 0.328044,
      "human_sentence_indices": [
        33,
        34
      ],
      "human_sha256": [
        "740b8b6908dae47d8939da12fe3d70a6d23427c299353725e14891afdfba81f6",
        "41ceb1fc49259dcd46c6cb9c86c1a0478da49690506c1f77c400bf175e87a13d"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "ddbd7f81ad3dad31f20f3b20d5b28de1646b4f416b59cbc6dfee63be74b891bc",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "While foolish innkeepers might be penny-pinchers, he was not.",
      "output_sha256": "fa14b31d26f4cbf76f577a38f369eacf1c1a2885362ac360c2a92aa3368c9c2c",
      "alignment_unit_index": 34,
      "alignment_score": 0.365303,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "e9db573d2d7395ef63bcdc6695d139f253de59f87d604aeb9de7fe94de7a26e8"
      ],
      "source_ai_sentence_index": 35,
      "source_ai_sha256": "fa14b31d26f4cbf76f577a38f369eacf1c1a2885362ac360c2a92aa3368c9c2c",
      "ai_unit_sentence_indices": [
        35
      ]
    },
    {
      "sentence_index": 36,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He knew that wherever else economy was wise, it was not in the dining-room.",
      "output_sha256": "b0a50981f54646a394941ec87f6ef7dddf6359b63666e9061aabff37b9f2cb76",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "b0a50981f54646a394941ec87f6ef7dddf6359b63666e9061aabff37b9f2cb76",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Were not the meals generous and diversified?",
      "output_sha256": "548f5b2156708c47ac980119ebfa128d13833f268ecdd89dd564928a2259a678",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "548f5b2156708c47ac980119ebfa128d13833f268ecdd89dd564928a2259a678",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Could I name a more plentiful breakfast at 4 lire or a superior lunch at 5?",
      "output_sha256": "67ebe94429721d7c4ebecf15fea40206a7d79bfd9a4e9f36cf165c53ae9631f4",
      "alignment_unit_index": 37,
      "alignment_score": 0.716071,
      "human_sentence_indices": [
        38
      ],
      "human_sha256": [
        "ef482d6f54f5f303e06626cb355c10a04f27ec0d1d6cb0ee52b12a0739fad18d"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "67ebe94429721d7c4ebecf15fea40206a7d79bfd9a4e9f36cf165c53ae9631f4",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 39,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Or served with more despatch?",
      "output_sha256": "dbabfe6c88494e353ac8ec8472a1b7b42c1167a11cd93f07b79e0adc42b26a18",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "dbabfe6c88494e353ac8ec8472a1b7b42c1167a11cd93f07b79e0adc42b26a18",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Was not his wine both sound and reasonably priced?",
      "output_sha256": "3f3b24e0dd50f5fe91a3eca36eb4cb5473e0df1d3fe372b9cf1ffbc35aa9a33e",
      "alignment_unit_index": 39,
      "alignment_score": 0.635714,
      "human_sentence_indices": [
        40
      ],
      "human_sha256": [
        "49411a48cf9fc24f1d6c4aaab4ca748782d737defe1e2c11661bb56abff566ea"
      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "3f3b24e0dd50f5fe91a3eca36eb4cb5473e0df1d3fe372b9cf1ffbc35aa9a33e",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Yet, inexplicably, four years ago, the star had disappeared from his hotel.",
      "output_sha256": "ffe48134f1dcec7720a32f64f0b87c459fcf028198c6b692afb34825c5b86459",
      "alignment_unit_index": 40,
      "alignment_score": 0.703333,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "ad5c7e8abd7cf2a8d563207f1cd3b96478af58b004d8deeaf110c053c1fbbf85"
      ],
      "source_ai_sentence_index": 41,
      "source_ai_sha256": "ffe48134f1dcec7720a32f64f0b87c459fcf028198c6b692afb34825c5b86459",
      "ai_unit_sentence_indices": [
        41
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 8,
      "origin": "human",
      "text": "It was monstrous, an outrage.",
      "output_sha256": "40109c394c6fb9033f6b6de3a1d467e96606967fbcf1003e7800cd688b8700b3",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "40109c394c6fb9033f6b6de3a1d467e96606967fbcf1003e7800cd688b8700b3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Four years prior—without warning and for no discernible reason.",
      "output_sha256": "21e456012c77f670e0c5b1f2b8e8071aaff4222af5f236924052caebd2a05ae4",
      "alignment_unit_index": 42,
      "alignment_score": 0.711579,
      "human_sentence_indices": [
        43
      ],
      "human_sha256": [
        "62056f356c28363679c24c92c1660f2acddeaca6323f72d0e139b30e5925dabe"
      ],
      "source_ai_sentence_index": 43,
      "source_ai_sha256": "21e456012c77f670e0c5b1f2b8e8071aaff4222af5f236924052caebd2a05ae4",
      "ai_unit_sentence_indices": [
        43
      ]
    },
    {
      "sentence_index": 44,
      "paragraph_index": 9,
      "origin": "human",
      "text": "When he had looked at the new edition of Baedeker which a visitor had left about and saw it, he could not believe his eyes.",
      "output_sha256": "50a4cd2c80780fbad934b0c5a4200fb2f82422ae68afec13c45dbcba1be7ee62",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "50a4cd2c80780fbad934b0c5a4200fb2f82422ae68afec13c45dbcba1be7ee62",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 9,
      "origin": "human",
      "text": "He had called his wife—every one: they were also incredulous.",
      "output_sha256": "1587c1d423a05bc2c0d2cec9457d95aaecabf4e1326a13fa0b314ac060eedc1f",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "1587c1d423a05bc2c0d2cec9457d95aaecabf4e1326a13fa0b314ac060eedc1f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 9,
      "origin": "human",
      "text": "It was like a thunderbolt, and earthquake.",
      "output_sha256": "cea58b3c5e7f94933c320a202af35a22e64531729be14107b352cbf61c2300d1",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "cea58b3c5e7f94933c320a202af35a22e64531729be14107b352cbf61c2300d1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "After all their hard work, their sincere desire to please, and the regular customers who returned contented—was that not the true measure of success?",
      "output_sha256": "62855da554af9726eb5cda6d345ea9b5fcf9a1d5f7d1ba81aad9e790ee462363",
      "alignment_unit_index": 46,
      "alignment_score": 0.577362,
      "human_sentence_indices": [
        47,
        48
      ],
      "human_sha256": [
        "e7faecc455971e7f24b80a3681825e3785ce8d53ac220d7fa0861aea2b6fbe68",
        "b8fcf5708aab9ddf47044cc39362dbafd2c55dce054794f6a09ebf09151a0c8e"
      ],
      "source_ai_sentence_index": 47,
      "source_ai_sha256": "62855da554af9726eb5cda6d345ea9b5fcf9a1d5f7d1ba81aad9e790ee462363",
      "ai_unit_sentence_indices": [
        47
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 9,
      "origin": "human",
      "text": "Obviously then the guide-book was wrong, guilty of a wicked injustice.",
      "output_sha256": "6bd43d4dc6f6ad93398cb8da812a2b4d56e405c9bdb83ca3001fca475e271783",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "6bd43d4dc6f6ad93398cb8da812a2b4d56e405c9bdb83ca3001fca475e271783",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 10,
      "origin": "human",
      "text": "What did he think could have happened?",
      "output_sha256": "d5f3e149567d79241d281ede44fb2f718e8b67d0a51eafe585d77f831aca0868",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "d5f3e149567d79241d281ede44fb2f718e8b67d0a51eafe585d77f831aca0868",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 10,
      "origin": "human",
      "text": "All he could suppose was that one of Herr Baedeker's agents, staying there incognito, had had some piece of bad fortune; some accident of the kitchen impossible to prevent, but isolated, had occurred and he had taken offence.",
      "output_sha256": "bd6715681d580760070fe42ed404dba6dd274d067d5b8782d3a76d8193896d0e",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 51,
      "source_human_sha256": "bd6715681d580760070fe42ed404dba6dd274d067d5b8782d3a76d8193896d0e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 10,
      "origin": "human",
      "text": "But how unfair!",
      "output_sha256": "dc7a7f446b9028cfbc57467f6d8226a1f0a5b3b29302a96d3050bea8cd9f9d58",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 52,
      "source_human_sha256": "dc7a7f446b9028cfbc57467f6d8226a1f0a5b3b29302a96d3050bea8cd9f9d58",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 10,
      "origin": "human",
      "text": "No one should judge by a single lapse.",
      "output_sha256": "010ba951fcaeb0812bdab3ee821f919624f0e6a24578c7e2c64a85a8451d67c4",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "010ba951fcaeb0812bdab3ee821f919624f0e6a24578c7e2c64a85a8451d67c4",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "There were numerous competitors still shining with stars while he remained in the dark!",
      "output_sha256": "286972dc18b506ef0175d8a4be1ffce5a0432a75b4b48c2de3d4273d476031a9",
      "alignment_unit_index": 52,
      "alignment_score": 0.339639,
      "human_sentence_indices": [
        54
      ],
      "human_sha256": [
        "c4d0d7a5edecea6c47e134f14a994a9cc25cf33e5b858879f94b11a7a34502d0"
      ],
      "source_ai_sentence_index": 53,
      "source_ai_sha256": "286972dc18b506ef0175d8a4be1ffce5a0432a75b4b48c2de3d4273d476031a9",
      "ai_unit_sentence_indices": [
        53
      ]
    },
    {
      "sentence_index": 54,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "Thus, throughout my stay, the Golden Eagle lamented daily, always concluding with a plea for my assistance in reclaiming the star—hoping I would leverage my influence on his behalf.",
      "output_sha256": "f491d96782d9c121564f5553915f7996250e7588591d6bc14838214c3ec6d043",
      "alignment_unit_index": 53,
      "alignment_score": 0.416044,
      "human_sentence_indices": [
        55
      ],
      "human_sha256": [
        "e3d8e4e9fa149dc9f7f733bbe1c49b17adcf4fda531021aed7cc9ada55ea97e0"
      ],
      "source_ai_sentence_index": 54,
      "source_ai_sha256": "f491d96782d9c121564f5553915f7996250e7588591d6bc14838214c3ec6d043",
      "ai_unit_sentence_indices": [
        54
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 12,
      "origin": "human",
      "text": "And now there is to be, I suppose, a new system of guide-book astronomy.",
      "output_sha256": "ccd6a143a160f6251396a5a5d45838136777e22b1037e0ee2f34628e1c957702",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "ccd6a143a160f6251396a5a5d45838136777e22b1037e0ee2f34628e1c957702",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 12,
      "origin": "human",
      "text": "If the Golden Eagle has survived the War he may, in the eclipse of Baedeker, be more resigned to his lot: the substitute for that travelling companion may confer a star of his own.",
      "output_sha256": "45e6514c0d7f913c2d0eefd5a5ec3bb33e4c9256c6bc340b8670742eca309f9d",
      "alignment_unit_index": 55,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "45e6514c0d7f913c2d0eefd5a5ec3bb33e4c9256c6bc340b8670742eca309f9d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 12,
      "origin": "human",
      "text": "But I do not propose to stay with him in order to make sure.",
      "output_sha256": "7e1184465da8186442e0bf929aa326be7c602d9222c53e6408da9e6619250899",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "7e1184465da8186442e0bf929aa326be7c602d9222c53e6408da9e6619250899",
      "ai_unit_sentence_indices": []
    }
  ]
}
