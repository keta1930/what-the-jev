  "mixed_article_sha256": "63c5491d0c3019689997746e6bde206ef4bf214aa1a654db750d5e32411bc930",
  "human_source_sentence_count": 63,
  "ai_source_sentence_count": 57,
  "alignment_unit_count": 58,
  "selected_alignment_unit_count": 21,
