  "mixed_article_sha256": "cd24cd656ab9290ae5d9eb5f32ceb84c1fcd27d1e918b23e0fb1bae5c15432a5",
  "human_source_sentence_count": 66,
  "ai_source_sentence_count": 59,
  "alignment_unit_count": 56,
  "selected_alignment_unit_count": 21,
