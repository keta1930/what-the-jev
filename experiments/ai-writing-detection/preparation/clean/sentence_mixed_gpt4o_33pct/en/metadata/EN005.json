  "mixed_article_sha256": "cb173449aeff7f25cb2e3a3ff4db48dc9f6479e7986c3c543c1321ead5c5a275",
  "human_source_sentence_count": 52,
  "ai_source_sentence_count": 47,
  "alignment_unit_count": 48,
  "selected_alignment_unit_count": 17,
  "mixed_sentence_count": 50,
  "selected_ai_sentence_count": 17,
  "actual_ai_sentence_ratio": 0.34,
  "selected_alignment_score_min": 0.323629,
