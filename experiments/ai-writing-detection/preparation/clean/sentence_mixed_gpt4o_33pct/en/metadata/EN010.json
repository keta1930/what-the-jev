      "source_ai_sentence_index": 53,
      "source_ai_sha256": "386e28ffd895938b6ec15204846099d6d4b08e70e466d1f2196f919d3530e6ae",
      "ai_unit_sentence_indices": [
        53
      ]
    },
    {
      "sentence_index": 66,
      "paragraph_index": 12,
      "origin": "ai",
