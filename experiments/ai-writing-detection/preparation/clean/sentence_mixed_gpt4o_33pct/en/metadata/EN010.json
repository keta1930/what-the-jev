      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 65,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "You might feel inclined to retire early, slipping into a slumber with surprising ease, yet your day will commence with clarity and vigor, proceeding energetically and concluding with reserves of energy still intact.",
      "output_sha256": "386e28ffd895938b6ec15204846099d6d4b08e70e466d1f2196f919d3530e6ae",
      "alignment_unit_index": 53,
