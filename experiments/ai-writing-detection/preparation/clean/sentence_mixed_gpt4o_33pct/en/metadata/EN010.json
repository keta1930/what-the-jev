    },
    {
      "sentence_index": 64,
      "paragraph_index": 12,
      "origin": "human",
      "text": "And, strange to say, you have not to pay by going through the day unrefreshed.",
      "output_sha256": "f298565334472c21fc6eb9a72d0c82f27f879084552fd79d99ccdbee972f51b6",
      "alignment_unit_index": 52,
      "alignment_score": null,
