  "ai_article_sha256": "f5bb758219a5b1907fc0ab80824b237a576f0a526ad3b003e2789bb3ee84b481",
  "mixed_article_sha256": "b3a8c788176a1b910a9b65c590df7a2837b86ef8ebd76471ba0feaa6d38c9665",
  "human_source_sentence_count": 69,
  "ai_source_sentence_count": 54,
  "alignment_unit_count": 54,
  "selected_alignment_unit_count": 19,
  "mixed_sentence_count": 66,
  "selected_ai_sentence_count": 22,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.25222,
  "selected_alignment_score_median": 0.353986,
  "selected_alignment_score_max": 0.514515,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "There are moments when the stillness of night calls for contemplation, leaving you wide awake and aware of your surroundings.",
      "output_sha256": "9070f19f8711020da6ce3efcb553b01f063b77e09d36c5eefb50281237fda865",
      "alignment_unit_index": 1,
      "alignment_score": 0.254117,
      "human_sentence_indices": [
        1,
        2
      ],
      "human_sha256": [
        "94eb885bf580764625d8a841300f22166fc94e384bc094dab0c3de56115c621a",
        "a57628a828f0c872d86cf0b971b1d8f9476b9eb7798f4ed5bfbbefa682262426"
      ],
      "source_ai_sentence_index": 1,
      "source_ai_sha256": "9070f19f8711020da6ce3efcb553b01f063b77e09d36c5eefb50281237fda865",
      "ai_unit_sentence_indices": [
        1
      ]
    },
    {
      "sentence_index": 2,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Why this is so I have never been able to discover.",
      "output_sha256": "86a112b3da8e12325d7adb19f575f77061b51d42a2ed773a0aedc1cc918685e4",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 3,
      "source_human_sha256": "86a112b3da8e12325d7adb19f575f77061b51d42a2ed773a0aedc1cc918685e4",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 2,
      "origin": "human",
      "text": "It apparently comes from no predisposing uneasiness of indigestion, no rashness in the matter of too much tea or tobacco, no excitation of unusual incident or stimulating conversation.",
      "output_sha256": "d7b41e6103ede6e6b5d9f40c9079f2e28228ff3ca20b90b1fe63ca7e06711791",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "d7b41e6103ede6e6b5d9f40c9079f2e28228ff3ca20b90b1fe63ca7e06711791",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 4,
      "paragraph_index": 2,
      "origin": "human",
      "text": "In fact, you turn in with the expectation of rather a good night's rest.",
      "output_sha256": "18eb2841f8aa9673ec1a5a3f61f37a1a26de98700fd1059db4c9b8e72ebb7392",
      "alignment_unit_index": 3,
      "alignment_score": null,
      "source_human_sentence_index": 5,
      "source_human_sha256": "18eb2841f8aa9673ec1a5a3f61f37a1a26de98700fd1059db4c9b8e72ebb7392",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Almost at once the little noises of the forest grow larger, blend in the hollow bigness of the first drowse; your thoughts drift idly back and forth between reality and dream; when— snap! —you are broad awake!",
      "output_sha256": "2176703dfb6d3d61946deed0fb0bb8e8a22f75a749f94155830b6f3129902871",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "2176703dfb6d3d61946deed0fb0bb8e8a22f75a749f94155830b6f3129902871",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Perhaps it is the overflowing reservoir of your energy that prompts this awakening, or maybe the great Mother Nature herself beckons you to explore her deeper mysteries.",
      "output_sha256": "81f9c4534372893abd72f9649522d88a816ca23212e1166fa530f331fbdc7533",
      "alignment_unit_index": 5,
      "alignment_score": 0.422777,
      "human_sentence_indices": [
        7
      ],
      "human_sha256": [
        "25cde9bcb6ac7a67b1c06f04344c524765a13dbaec918867f14039f7d37cc332"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "81f9c4534372893abd72f9649522d88a816ca23212e1166fa530f331fbdc7533",
      "ai_unit_sentence_indices": [
        4
      ]
    },
    {
      "sentence_index": 7,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Unlike the torment of insomnia, the experience of lying awake in the woods holds a certain charm.",
      "output_sha256": "75caccd6ddb2b4e0c1adb24a73786db735a1b51f6e6565ed37da7979652a8176",
      "alignment_unit_index": 6,
      "alignment_score": 0.478326,
      "human_sentence_indices": [
        8
      ],
      "human_sha256": [
        "494c8e01e3e27092cbefd310c8d10d202a99eaa44391eaa38ce7a99a82f9c00e"
      ],
      "source_ai_sentence_index": 5,
      "source_ai_sha256": "75caccd6ddb2b4e0c1adb24a73786db735a1b51f6e6565ed37da7979652a8176",
      "ai_unit_sentence_indices": [
        5
      ]
    },
    {
      "sentence_index": 8,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "The initial urgency to find rest morphs into a delightful indifference.",
      "output_sha256": "7daab535fc9fc101e66689cf9a371c1b314bf6ce405598558fb9c9e7a48423fe",
      "alignment_unit_index": 7,
      "alignment_score": 0.409855,
      "human_sentence_indices": [
        9
      ],
      "human_sha256": [
        "115c55a69586ae50df32a98bc830ffd0616dbccf4ff7985f08f5e5194ca8981a"
      ],
      "source_ai_sentence_index": 6,
      "source_ai_sha256": "7daab535fc9fc101e66689cf9a371c1b314bf6ce405598558fb9c9e7a48423fe",
      "ai_unit_sentence_indices": [
        6
      ]
    },
    {
      "sentence_index": 9,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You do not care.",
      "output_sha256": "67e833a0121a081b9630651c452b0f0dc7eb0116e9bea6c4d2a27f107393ba2d",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 10,
      "source_human_sha256": "67e833a0121a081b9630651c452b0f0dc7eb0116e9bea6c4d2a27f107393ba2d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Your mind is cradled in an exquisite poppy-suspension of judgment and of thought.",
      "output_sha256": "abd63a057c852ee6a64a7287d22cc483891daf2ed6325a4ece84a1753e93ac0d",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "abd63a057c852ee6a64a7287d22cc483891daf2ed6325a4ece84a1753e93ac0d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Impressions slip vaguely into your consciousness and as vaguely out again.",
      "output_sha256": "9f3da07b5de18bf9679d7f8897ded94225aea6637593b80bc630bb1ede65ecd1",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "9f3da07b5de18bf9679d7f8897ded94225aea6637593b80bc630bb1ede65ecd1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 12,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Sometimes they stand stark and naked for your inspection; sometimes they lose themselves in the mist of half-sleep.",
      "output_sha256": "f8ddab9055d303a4c298868ff8f4b0ae2e81ca986ecbf1e332af03559ac78945",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "f8ddab9055d303a4c298868ff8f4b0ae2e81ca986ecbf1e332af03559ac78945",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Always they lay soft velvet fingers on the drowsy imagination, so that in their caressing you feel the vaster spaces from which they have come.",
      "output_sha256": "afb1238f26cddac80e10fc988d81f8a0e68c7fa7c0d5fd04db65abedc195ddc6",
      "alignment_unit_index": 10,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "afb1238f26cddac80e10fc988d81f8a0e68c7fa7c0d5fd04db65abedc195ddc6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Your senses become acutely attuned to the sounds, sights, and fragrances wafting through the night, while your mind remains in a state of gentle repose, allowing these experiences to wash over you like petals scattered on the breeze.",
      "output_sha256": "e3187458c498da8d7214c6ce3e45aeb6b6ea950e67d54f33f44ca64cf18a2717",
      "alignment_unit_index": 11,
      "alignment_score": 0.263747,
      "human_sentence_indices": [
        15,
        16
      ],
      "human_sha256": [
        "6ec2bc6c7d7ee65c86ba49a5170bb75788ae3687784ca5aab06bf955c329eb39",
        "68c996a8f0d65de749ee87a71990d147a4b42de6025f7551f27024a1ca1a756c"
      ],
      "source_ai_sentence_index": 10,
      "source_ai_sha256": "e3187458c498da8d7214c6ce3e45aeb6b6ea950e67d54f33f44ca64cf18a2717",
      "ai_unit_sentence_indices": [
        10
      ]
    },
    {
      "sentence_index": 15,
      "paragraph_index": 5,
      "origin": "human",
      "text": "In such circumstance you will hear what the voyageurs call the voices of the rapids.",
      "output_sha256": "d4444088b84d9c19dc44cc7b839281e8e7b7181221602e9053de280e0a50476d",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "d4444088b84d9c19dc44cc7b839281e8e7b7181221602e9053de280e0a50476d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Many people never hear them at all.",
      "output_sha256": "9c5a78f903b8511b66a7b84d42d2fe15e730889e6a580826f1dc18287c6436b3",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "9c5a78f903b8511b66a7b84d42d2fe15e730889e6a580826f1dc18287c6436b3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 5,
      "origin": "human",
      "text": "They speak very soft and low and distinct beneath the steady roar and dashing, beneath even the lesser tinklings and gurglings whose quality superimposes them over the louder sounds.",
      "output_sha256": "c368c771ddff8c7ab7d751c5bf0dfcbd84fcf82be9d8e32fa5c644f1bd85160c",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "c368c771ddff8c7ab7d751c5bf0dfcbd84fcf82be9d8e32fa5c644f1bd85160c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 5,
      "origin": "human",
      "text": "They are like the tear-forms swimming across the field of vision, which disappear so quickly when you concentrate your sight to look at them, and which reappear so magically when again your gaze turns vacant.",
      "output_sha256": "e2195db83b82212eccadd677adaa143e053dfce820dbe9055623c18695620ac7",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "e2195db83b82212eccadd677adaa143e053dfce820dbe9055623c18695620ac7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "In this tranquil state of half-awareness, these voices emerge; however, when you strain to listen, they retreat, leaving only the cacophony of the stream in their wake.",
      "output_sha256": "61e428168c0543feaf46cbeaeb7f08103b1d03d1b72600812ae864b95ef1a647",
      "alignment_unit_index": 15,
      "alignment_score": 0.451282,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "d22d2eb45b6d019db5721c8039605f03dfffea969b2755b298bd5e6fa1cd06f8"
      ],
      "source_ai_sentence_index": 14,
      "source_ai_sha256": "61e428168c0543feaf46cbeaeb7f08103b1d03d1b72600812ae864b95ef1a647",
      "ai_unit_sentence_indices": [
        14
      ]
    },
    {
      "sentence_index": 20,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "During those rare moments when the voices are audible, they possess a remarkable clarity.",
      "output_sha256": "cfae9d5b75a5c505aca5e5a794db5c05b81f7e687cb45615ff12196447247fda",
      "alignment_unit_index": 16,
      "alignment_score": 0.25222,
      "human_sentence_indices": [
        22
      ],
      "human_sha256": [
        "4f5d5e736511756e56446496600a7c5d5af08dab46e9757b3febfeb91d0169ad"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "cfae9d5b75a5c505aca5e5a794db5c05b81f7e687cb45615ff12196447247fda",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 21,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Just as often an odor will wake all a vanished memory, so these voices, by the force of a large impressionism, suggest whole scenes.",
      "output_sha256": "cbe5b244e7f11c44ce19900bd5d1a211520b87cca4b4445d26f0acb3592e95df",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "cbe5b244e7f11c44ce19900bd5d1a211520b87cca4b4445d26f0acb3592e95df",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Far off are the cling-clang-cling of chimes and the swell-and-fall murmur of a multitude en fête , so that subtly you feel the gray old town, with its walls, the crowded market-place, the decent peasant crowd, the booths, the mellow church building with its bells, the warm, dust-moted sun.",
      "output_sha256": "1969552251bd22a1d4b55f8d1494840705783187b6a44a8739409991aa9e76d0",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "1969552251bd22a1d4b55f8d1494840705783187b6a44a8739409991aa9e76d0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Or, in the pauses between the swish-dash-dashings of the waters, sound faint and clear voices singing intermittently, calls, distant notes of laughter, as though many canoes were working against the current—only the flotilla never gets any nearer, nor the voices louder.",
      "output_sha256": "a2847056cacba8d259c73d56674455cfdaeff853ce015856466d6afd90349570",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 25,
      "source_human_sha256": "a2847056cacba8d259c73d56674455cfdaeff853ce015856466d6afd90349570",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The voyageurs call these mist people the Huntsmen; and look frightened.",
      "output_sha256": "d1189c53b1118b332f802924ea57b7a0e86f980ddb7d68d31450413e4560ed1d",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "d1189c53b1118b332f802924ea57b7a0e86f980ddb7d68d31450413e4560ed1d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 6,
      "origin": "human",
      "text": "To each is his vision, according to his experience.",
      "output_sha256": "f71b14b914d1e4324a2aa0549e64f0f16fdaca19d511303f305919b8580b6eaf",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "f71b14b914d1e4324a2aa0549e64f0f16fdaca19d511303f305919b8580b6eaf",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "The murmurs of the rapids seem to convey comforting images—a field ready for harvest, a festive gathering, or carefree wanderers—never the strife or chaos of life.",
      "output_sha256": "1f39b4f52fe5266fa95c1af1cb5864587a1f57f671941a6919e6a2f58bf98462",
      "alignment_unit_index": 22,
      "alignment_score": 0.253695,
      "human_sentence_indices": [
        28,
        29
      ],
      "human_sha256": [
        "08b821c31f597a1c18b2f1eb3abe318ba2c6851f4f75acc881f485179d3f61b3",
        "b9c13f6778d5afbbf53c4644095052842f0d1e93c4f13eb636dff83b44a086ff"
      ],
      "source_ai_sentence_index": 21,
      "source_ai_sha256": "1f39b4f52fe5266fa95c1af1cb5864587a1f57f671941a6919e6a2f58bf98462",
      "ai_unit_sentence_indices": [
        21
      ]
    },
    {
      "sentence_index": 27,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Perhaps this is the great Mother's compensation in a harsh mode of life.",
      "output_sha256": "18f4cb8cb60ea1b6ef66b770d63706f0b77e371ddc869affd08f5870eedf694d",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 30,
      "source_human_sha256": "18f4cb8cb60ea1b6ef66b770d63706f0b77e371ddc869affd08f5870eedf694d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Nothing is more fantastically unreal to tell about, nothing more concretely real to experience, than this undernote of the quick water.",
      "output_sha256": "11467c8d014424cb2b9f9ae5d261b103377ee46a2db69a8c9be800d32d09f508",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 31,
      "source_human_sha256": "11467c8d014424cb2b9f9ae5d261b103377ee46a2db69a8c9be800d32d09f508",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 7,
      "origin": "human",
      "text": "And when you do lie awake at night, it is always making its unobtrusive appeal.",
      "output_sha256": "b2bd3449b2a9a796debc1ec54e1734a4a948775a9d4c1f61daf700fc870a26f9",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 32,
      "source_human_sha256": "b2bd3449b2a9a796debc1ec54e1734a4a948775a9d4c1f61daf700fc870a26f9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Gradually its hypnotic spell works.",
      "output_sha256": "9946d2939ce806136f92c1f5b84944dd158df46eebbc4e5437643a860c284a03",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "9946d2939ce806136f92c1f5b84944dd158df46eebbc4e5437643a860c284a03",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 7,
      "origin": "human",
      "text": "The distant chimes ring louder and nearer as you cross the borderland of sleep.",
      "output_sha256": "d70541f76b239de20d6bd485dd706cca0dfcf0a33bc8ad43e7978df555032fee",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "d70541f76b239de20d6bd485dd706cca0dfcf0a33bc8ad43e7978df555032fee",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Just as you sense the distant chimes growing louder, a sudden noise—an owl’s hoot, the call of a whippoorwill, or the crack of a twig—snaps you back to the present.",
      "output_sha256": "f4762e7ea4ec86807b6b9afd962ce5905b0a0c6aa2a6b2dfb96ee7dd1a0eddb9",
      "alignment_unit_index": 27,
      "alignment_score": 0.361596,
      "human_sentence_indices": [
        35,
        36
      ],
      "human_sha256": [
        "1e2b8634782ba764d7533c1f7ce21bbfbee09b2487ae68d3db27813364cd84ce",
        "80307257a4cedbdd487202f73fa9be67222aacdf3edc3d43792b8d458e08ed82"
      ],
      "source_ai_sentence_index": 25,
      "source_ai_sha256": "f4762e7ea4ec86807b6b9afd962ce5905b0a0c6aa2a6b2dfb96ee7dd1a0eddb9",
      "ai_unit_sentence_indices": [
        25,
        26
      ]
    },
    {
      "sentence_index": 33,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Gone are the sunlit meadows of France; instead, you find yourself gazing at the moon's blurred silhouette filtering through your tent's fabric.",
      "output_sha256": "a3a1336e6e96a3e5bfba90160f7aa13a5fa8757b2915a1232428ab7e53327630",
      "alignment_unit_index": 27,
      "alignment_score": 0.361596,
      "human_sentence_indices": [
        35,
        36
      ],
      "human_sha256": [
        "1e2b8634782ba764d7533c1f7ce21bbfbee09b2487ae68d3db27813364cd84ce",
        "80307257a4cedbdd487202f73fa9be67222aacdf3edc3d43792b8d458e08ed82"
      ],
      "source_ai_sentence_index": 26,
      "source_ai_sha256": "a3a1336e6e96a3e5bfba90160f7aa13a5fa8757b2915a1232428ab7e53327630",
      "ai_unit_sentence_indices": [
        25,
        26
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 8,
      "origin": "human",
      "text": "The voices of the rapids have dropped into the background, as have the dashing noises of the stream.",
      "output_sha256": "d51dc019493c83f03450a6e44fa987d7fd37a2d44ac80ecee3b96ee93dc1cdc0",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "d51dc019493c83f03450a6e44fa987d7fd37a2d44ac80ecee3b96ee93dc1cdc0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 35,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Through the forest is a great silence, but no stillness at all.",
      "output_sha256": "36b11164f63e5ff3b29d1c7872acd7876dfc5e42a3d68ee7c0a208904685e68d",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "36b11164f63e5ff3b29d1c7872acd7876dfc5e42a3d68ee7c0a208904685e68d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "The whippoorwill continues its melodic ascent and descent, while an owl's repetitive calls punctuate the night.",
      "output_sha256": "f25b23e7f122e6279ef70742c64d22160d236e900a7c4e12a9a42e046907cf9c",
      "alignment_unit_index": 29,
      "alignment_score": 0.286377,
      "human_sentence_indices": [
        39
      ],
      "human_sha256": [
        "e27522de905ea3c22119ecc08f56a0f45c7b9c3ae1be6e72817980708f4000ff"
      ],
      "source_ai_sentence_index": 28,
      "source_ai_sha256": "f25b23e7f122e6279ef70742c64d22160d236e900a7c4e12a9a42e046907cf9c",
      "ai_unit_sentence_indices": [
        28
      ]
    },
    {
      "sentence_index": 37,
      "paragraph_index": 8,
      "origin": "human",
      "text": "These, with the ceaseless dash of the rapids, are the web on which the night traces her more delicate embroideries of the unexpected.",
      "output_sha256": "fa94af9d646a577145bfa6ce689230e89d5ea00d04e61c01c858574ccffb35a9",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "fa94af9d646a577145bfa6ce689230e89d5ea00d04e61c01c858574ccffb35a9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "There are distant crashes that resonate with significance, stealthy movements nearby, the soft scraping of claws, a faint sniffing sound full of curiosity, and the bright call of a tiny owl.",
      "output_sha256": "0a8a0b5f149c5e77ff05ad598ffe0218b6ce38947d726871c0f255141be768e3",
      "alignment_unit_index": 31,
      "alignment_score": 0.339574,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "24fee7780c03f10f0ef9eb55d2adc6f48bba4f654815ff1be3aa4477cffd056f"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "0a8a0b5f149c5e77ff05ad598ffe0218b6ce38947d726871c0f255141be768e3",
      "ai_unit_sentence_indices": [
        30,
        31,
        32
      ]
    },
    {
      "sentence_index": 39,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "The haunting cry of a loon embodies the essence of solitude, while the ethereal notes of migrating birds drift high above.",
      "output_sha256": "611f726b371ef70815495005f6ecb13ba292b8fdf7a572e96c4001b7f162aaa6",
      "alignment_unit_index": 31,
      "alignment_score": 0.339574,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "24fee7780c03f10f0ef9eb55d2adc6f48bba4f654815ff1be3aa4477cffd056f"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "611f726b371ef70815495005f6ecb13ba292b8fdf7a572e96c4001b7f162aaa6",
      "ai_unit_sentence_indices": [
        30,
        31,
        32
      ]
    },
    {
      "sentence_index": 40,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Among the rustling leaves, a gentle patter quickly subsides, followed by the exquisite, trembling song of the white-throated sparrow, the nightingale of the North, as if a moonbeam had transformed into sound.",
      "output_sha256": "75df84419769b055b30981e81857fc13cbe530e832794b3ebcb80d027582919f",
      "alignment_unit_index": 31,
      "alignment_score": 0.339574,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "24fee7780c03f10f0ef9eb55d2adc6f48bba4f654815ff1be3aa4477cffd056f"
      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "75df84419769b055b30981e81857fc13cbe530e832794b3ebcb80d027582919f",
      "ai_unit_sentence_indices": [
        30,
        31,
        32
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "In moments like these, nothing is more refreshing than a sip of spring water, nor is there a more invigorating experience than surveying the darkened woods around you.",
      "output_sha256": "af5bfe92c2bd95f797d6329f0e95942ae9a66edb3f16496fa3abdb8a8ecc00b1",
      "alignment_unit_index": 33,
      "alignment_score": 0.396278,
      "human_sentence_indices": [
        42
      ],
      "human_sha256": [
        "27deb174db383c04e2a42ce91088563854d37e47d0d3e5e1310cda39d5c5b428"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "af5bfe92c2bd95f797d6329f0e95942ae9a66edb3f16496fa3abdb8a8ecc00b1",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 9,
      "origin": "human",
      "text": "You have cast from you with the warm blanket the drowsiness of dreams.",
      "output_sha256": "7946b566038f5baeec4276ece37f9aeab0b03fa6f31e8db206ddd7c9347a456f",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "7946b566038f5baeec4276ece37f9aeab0b03fa6f31e8db206ddd7c9347a456f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 9,
      "origin": "human",
      "text": "A coolness, physical and spiritual, bathes you from head to foot.",
      "output_sha256": "1f705a202fefb21379f5a79c00dde7ee1f54ea386be4162beb6ca49963a1ba4f",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "1f705a202fefb21379f5a79c00dde7ee1f54ea386be4162beb6ca49963a1ba4f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 9,
      "origin": "human",
      "text": "All your senses are keyed to the last vibrations.",
      "output_sha256": "4b8622358798acd93213aacbd0bbae850c37634ca4c7b0655221a6b790fcd6b1",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "4b8622358798acd93213aacbd0bbae850c37634ca4c7b0655221a6b790fcd6b1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 9,
      "origin": "human",
      "text": "You hear the littler night prowlers; you glimpse the greater.",
      "output_sha256": "e44fdc50902464bded005265bbaf2aa0d8c212d83c1b69681589c4b39c7beabc",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "e44fdc50902464bded005265bbaf2aa0d8c212d83c1b69681589c4b39c7beabc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 9,
      "origin": "human",
      "text": "A faint, searching woods perfume of dampness greets your nostrils.",
      "output_sha256": "629aee1e304cd2540d19660f973064de094deb92d59c421300f5c68a0b10494a",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 47,
      "source_human_sha256": "629aee1e304cd2540d19660f973064de094deb92d59c421300f5c68a0b10494a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "The damp, earthy scent of the forest fills the air, and somehow, in an inexplicable way, the very essence of the world seems poised in anticipation—waiting for a single touch to unleash boundless potential and movement.",
      "output_sha256": "d017edaec5827de446caa086b894bea197247de5f7cccca8ad67e1bf668eda2a",
      "alignment_unit_index": 37,
      "alignment_score": 0.338156,
      "human_sentence_indices": [
        48
      ],
      "human_sha256": [
        "723c8fa6e4247d6517490a79146f1ed0581110fc5646768536fc7ed194d5b8b4"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "d017edaec5827de446caa086b894bea197247de5f7cccca8ad67e1bf668eda2a",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 9,
      "origin": "human",
      "text": "But the touch lacks.",
      "output_sha256": "aa1b687cdca2c3805f4dfdf0f7eebd2f86cf5a0995693bbb0200315486c8a9fd",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "aa1b687cdca2c3805f4dfdf0f7eebd2f86cf5a0995693bbb0200315486c8a9fd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 9,
      "origin": "human",
      "text": "The forces hover on the edge of action, unheeding the little noises.",
      "output_sha256": "a7187164006a1c4e69c7b338c34974006665a9bda9738fcb373a8402d35f3043",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "a7187164006a1c4e69c7b338c34974006665a9bda9738fcb373a8402d35f3043",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "In that moment, you find yourself humbled and awed as a resident of the Silent Places.",
      "output_sha256": "3353d3e7ace9e6cea872904802dc7875fca93c55bb23c76392bf2c139b58be4e",
      "alignment_unit_index": 39,
      "alignment_score": 0.479741,
      "human_sentence_indices": [
        51
      ],
      "human_sha256": [
        "cf3e810fa580c17d2cbd0e39739079c9572f5477c39353d22eee43e1678ea53c"
      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "3353d3e7ace9e6cea872904802dc7875fca93c55bb23c76392bf2c139b58be4e",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 51,
      "paragraph_index": 10,
      "origin": "human",
      "text": "At such a time you will meet with adventures.",
      "output_sha256": "69181e9265dfa052e6f6de07c4a6e34bd90bf15bc5b7ec2bb4e4ebd00db788ff",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 52,
      "source_human_sha256": "69181e9265dfa052e6f6de07c4a6e34bd90bf15bc5b7ec2bb4e4ebd00db788ff",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 10,
      "origin": "human",
      "text": "One night we put fourteen inquisitive porcupines out of camp.",
      "output_sha256": "6ee6975ad4c5f21081aae9590e8b560827342453609c1df8a57c4dff159dbf6b",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "6ee6975ad4c5f21081aae9590e8b560827342453609c1df8a57c4dff159dbf6b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Near McGregor's Bay I discovered in the large grass park of my camp-site nine deer, cropping the herbage like so many beautiful ghosts.",
      "output_sha256": "12e6e43e25f4c4122bf77de3845259a44b364af3d41222495550c003ba76bb5f",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "12e6e43e25f4c4122bf77de3845259a44b364af3d41222495550c003ba76bb5f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "A friend shared a tale of a fawn that would curl up just outside his tent each night, seeking refuge close to him, likely to avoid predators.",
      "output_sha256": "d963e06ba7a4bd3ef522d5ff8fd53d8e2a44dbb10ce1b660deec9f0476c9352c",
      "alignment_unit_index": 43,
      "alignment_score": 0.395492,
      "human_sentence_indices": [
        55
      ],
      "human_sha256": [
        "6d6a9fa5c22dca19d1d2cad8d0453b0f3d21fe856bde916b966da6abfa7f79a1"
      ],
      "source_ai_sentence_index": 44,
      "source_ai_sha256": "d963e06ba7a4bd3ef522d5ff8fd53d8e2a44dbb10ce1b660deec9f0476c9352c",
      "ai_unit_sentence_indices": [
        44
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Its mother had in all likelihood been killed.",
      "output_sha256": "e8bf594ad7913b6427a04ffc35b0985823508a5b333a48a52add78c4a8dda390",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "e8bf594ad7913b6427a04ffc35b0985823508a5b333a48a52add78c4a8dda390",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 10,
      "origin": "human",
      "text": "The instant my friend moved toward the tent opening the little creature would disappear, and it was always gone by earliest daylight.",
      "output_sha256": "b26b80f5a83c4d8312faf176d9391e6cf8fc5a89c699e728e5fe8909ad746c2f",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "b26b80f5a83c4d8312faf176d9391e6cf8fc5a89c699e728e5fe8909ad746c2f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Nocturnal bears in search of pork are not uncommon.",
      "output_sha256": "82b42f0e66de2803335af8cec5d6d88f541e92bf176e97e395fef7c78d55bd04",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "82b42f0e66de2803335af8cec5d6d88f541e92bf176e97e395fef7c78d55bd04",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 10,
      "origin": "human",
      "text": "But even though your interest meets nothing but the bats and the woods shadows and the stars, that few moments of the sleeping world forces is a psychical experience to be gained in no other way.",
      "output_sha256": "6876c5e9f148d9b9974e4ec7c0f0aef6995db3c92c31a913fd717f2ca64edf76",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "6876c5e9f148d9b9974e4ec7c0f0aef6995db3c92c31a913fd717f2ca64edf76",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "You cannot truly know the night by merely staying awake; she will engage with you when you approach her from the brink of sleep, allowing you to encounter her intimate essence.",
      "output_sha256": "6d541e89aa711b3fcbd7b161107a21ab2a09ba8ad88c5b320c93bb3b1b3c1d64",
      "alignment_unit_index": 48,
      "alignment_score": 0.514515,
      "human_sentence_indices": [
        60,
        61
      ],
      "human_sha256": [
        "f606bbc448eb055a08057945452d807587d5881d26c63f1cf24b693cb2135196",
        "aa8b2cef18469121b6b6cfc3236af864297b15c40327c73ac79de19e391523f5"
      ],
      "source_ai_sentence_index": 48,
      "source_ai_sha256": "6d541e89aa711b3fcbd7b161107a21ab2a09ba8ad88c5b320c93bb3b1b3c1d64",
      "ai_unit_sentence_indices": [
        48
      ]
    },
    {
      "sentence_index": 60,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "Eventually, the night breeze from the river or the wild open spaces begins to chill you.",
      "output_sha256": "182225d884d0fe04b55f9e4c78bc101fb79c09d4ce2e2910267de5d4211d9c98",
      "alignment_unit_index": 49,
      "alignment_score": 0.511278,
      "human_sentence_indices": [
        62
      ],
      "human_sha256": [
        "7b0d4ef18424eb08eb2d788e72053abf3fc0b91132ccd33625fa6796d87585c4"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "182225d884d0fe04b55f9e4c78bc101fb79c09d4ce2e2910267de5d4211d9c98",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 61,
      "paragraph_index": 11,
      "origin": "human",
      "text": "You begin to think of your blankets.",
      "output_sha256": "11957369de1855568dd48bbb323a1ab20436b6dd62043ae8d876c54a03586b25",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 63,
      "source_human_sha256": "11957369de1855568dd48bbb323a1ab20436b6dd62043ae8d876c54a03586b25",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 11,
      "origin": "human",
      "text": "In a few moments you roll yourself in their soft wool.",
      "output_sha256": "2551acbce9d847a00ef5e9a8f123eb7eb4e8d0befc4c5485f6d5764f70856fa2",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "2551acbce9d847a00ef5e9a8f123eb7eb4e8d0befc4c5485f6d5764f70856fa2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 63,
      "paragraph_index": 11,
      "origin": "human",
      "text": "Instantly it is morning.",
      "output_sha256": "a5d0bac30f326aa55df9845737b7f3bde66180b0545b67b0b4f3d67cee2c2b6a",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 65,
      "source_human_sha256": "a5d0bac30f326aa55df9845737b7f3bde66180b0545b67b0b4f3d67cee2c2b6a",
