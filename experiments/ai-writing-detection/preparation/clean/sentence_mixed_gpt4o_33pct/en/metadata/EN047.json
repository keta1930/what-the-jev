  "mixed_article_sha256": "e4c92d4a74aef3cf9f1fef8466e4c83ba75460c24036913333d85a308074fa47",
  "human_source_sentence_count": 53,
  "ai_source_sentence_count": 51,
  "alignment_unit_count": 50,
  "selected_alignment_unit_count": 18,
