  "selected_alignment_score_max": 0.707817,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "F ORCES astir in the deepest roots grow restless beneath the lock of frost.",
      "output_sha256": "f289847b7d4801df6d800b5952605e8745263fe301cfc7e25699710626899530",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "f289847b7d4801df6d800b5952605e8745263fe301cfc7e25699710626899530",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Bulbs try the door.",
      "output_sha256": "f446bad337ffa760035f016d5690f29bfd0543263eef3a7b8ef6528a02e71baa",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "f446bad337ffa760035f016d5690f29bfd0543263eef3a7b8ef6528a02e71baa",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "It’s as if the light’s power, pushing upward from the core of the earth and pouring down from the sun’s growing strength, has disturbed the dormant seeds, prompting them to respond to their liberator.",
      "output_sha256": "55066b624fe0dff9d0f7899397c4083ca1227c5b32499c4c82dfd764260da968",
      "alignment_unit_index": 3,
      "alignment_score": 0.410429,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "49e7309e4fa5147e648b41ac7c968043e14d6f754c20facb5f4af4c25a819de2"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "55066b624fe0dff9d0f7899397c4083ca1227c5b32499c4c82dfd764260da968",
      "ai_unit_sentence_indices": [
        3,
        4
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "Yet, the protective mother urges them to remain patient, whispering insistently, \"Not yet, not yet!\"",
      "output_sha256": "941422d3ff324bd5fccda960a93e820236ae81b831c0ab15f6a1e6cb74c4c15a",
      "alignment_unit_index": 3,
      "alignment_score": 0.410429,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "49e7309e4fa5147e648b41ac7c968043e14d6f754c20facb5f4af4c25a819de2"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "941422d3ff324bd5fccda960a93e820236ae81b831c0ab15f6a1e6cb74c4c15a",
      "ai_unit_sentence_indices": [
        3,
        4
      ]
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Better to stay behind the frozen gate than to come too early up into realms where the wolves of cold are still aprowl.",
      "output_sha256": "abb305a5f16afe216dc4107096beb20e20572980ed74316c00f4a67414ee0239",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "abb305a5f16afe216dc4107096beb20e20572980ed74316c00f4a67414ee0239",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "The snow blankets this eager life, a gentle reminder of restraint, though the stirring is felt in February's woods, much like a swimmer sensing the varying currents in a spring-fed lake.",
      "output_sha256": "da1a95e1013976afe596f85661eac8747bcacd8eddf5bc3460864fa1f7730e41",
      "alignment_unit_index": 5,
      "alignment_score": 0.469013,
      "human_sentence_indices": [
        5
      ],
      "human_sha256": [
        "5ed2b3e5dda364f6ec4bb9a0469a4262af777802cc8e9f3dcd0bbc77b8ddddbe"
      ],
      "source_ai_sentence_index": 6,
      "source_ai_sha256": "da1a95e1013976afe596f85661eac8747bcacd8eddf5bc3460864fa1f7730e41",
      "ai_unit_sentence_indices": [
        6
      ]
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Only the thick stars, closer and more companionable than in months of foliage, burn alert and serene.",
      "output_sha256": "5261cc234336a87784a523d9a31b00407ec9a969132dbf3166dbb5e2deae29a2",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "5261cc234336a87784a523d9a31b00407ec9a969132dbf3166dbb5e2deae29a2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 1,
      "origin": "human",
      "text": "In February the Milky Way is revealed divinely lucent to lonely peoples—herdsmen, mountaineers, fishermen, trappers—who are abroad in the starlight hours of this grave and silent time of year.",
      "output_sha256": "09149b7014c13671064b5241373326c1fcff3bdd6efb338a5b5a27f8ca56d50b",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 7,
      "source_human_sha256": "09149b7014c13671064b5241373326c1fcff3bdd6efb338a5b5a27f8ca56d50b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It is in the long, frozen nights that the sky has most red flowers.",
      "output_sha256": "d69b4378753e56d9bccaa85c648a8f92ee1488725a57f697d6d134f1ee156f8c",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "d69b4378753e56d9bccaa85c648a8f92ee1488725a57f697d6d134f1ee156f8c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 2,
      "origin": "human",
      "text": "February knows the beat of twilight wings.",
      "output_sha256": "ac82a3c4e1cc95fcadaf3c05b3528f8326e965ab13b64f0831036b40fd06d71c",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "ac82a3c4e1cc95fcadaf3c05b3528f8326e965ab13b64f0831036b40fd06d71c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Birds that seemed to have abandoned us return, adventurers not overly fond of safety, eager to discover how the snow bunting and pine finch have raided the evergreens’ cones.",
      "output_sha256": "7111fef3b67bad30ee64db97a4fbeced848f73cb89b920af37623e726ad9ebf6",
      "alignment_unit_index": 10,
      "alignment_score": 0.542582,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "8b849c75c942e7373d5d687a41426d0302a8519804adbd4c2c856776e788eef3"
      ],
      "source_ai_sentence_index": 11,
      "source_ai_sha256": "7111fef3b67bad30ee64db97a4fbeced848f73cb89b920af37623e726ad9ebf6",
      "ai_unit_sentence_indices": [
        11,
        12
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Meanwhile, chickadees, sparrows, and crows monitor the more domestic food sources from their established perches, with a sparrow often managing to irritate even a duck into relinquishing her share of cracked corn.",
      "output_sha256": "7ab74a65dfd13ed55f3f7749d4dc2692f41e268e099a51ef0adeab1544f92141",
      "alignment_unit_index": 10,
      "alignment_score": 0.542582,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "8b849c75c942e7373d5d687a41426d0302a8519804adbd4c2c856776e788eef3"
      ],
      "source_ai_sentence_index": 12,
      "source_ai_sha256": "7ab74a65dfd13ed55f3f7749d4dc2692f41e268e099a51ef0adeab1544f92141",
      "ai_unit_sentence_indices": [
        11,
        12
      ]
    },
    {
      "sentence_index": 13,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Ranged along a brown-draped oak branch in the waxing light, crows show a lordly glistening of feathers.",
      "output_sha256": "c0f1fe08848d41f2a055d7ef701b3330283e50a8e30dd8b41def6c9626c8553b",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "c0f1fe08848d41f2a055d7ef701b3330283e50a8e30dd8b41def6c9626c8553b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 2,
      "origin": "human",
      "text": "(Sun on a sweeping wing in flight has the quality of sun on a ripple.)",
      "output_sha256": "de21aeac1402fecaad887bb6d316152586a96af92d2f66c5bbd8da1da99ef71c",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "de21aeac1402fecaad887bb6d316152586a96af92d2f66c5bbd8da1da99ef71c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Where hemlocks gather, deep in somber woods, the great horned owl has thus soon, perhaps working amid snows at her task, built a nest wherein March will find sturdy balls of fluff.",
      "output_sha256": "631eaaa7e4067d0a4417cd63d58c9c1d49ee620d2de533ea82ee6d59dabd5797",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "631eaaa7e4067d0a4417cd63d58c9c1d49ee620d2de533ea82ee6d59dabd5797",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "The echoing love call of her mate reverberates through the woods.",
      "output_sha256": "ea591f0be4cd97ce8ceb21e7a69fbf9697aa2530d3b954365653912a9d893f6a",
      "alignment_unit_index": 14,
      "alignment_score": 0.618182,
      "human_sentence_indices": [
        14
      ],
      "human_sha256": [
        "f938cc22d7e83cd4240ec7140b6586db177dc4e060740565d3743dfd73b702a6"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "ea591f0be4cd97ce8ceb21e7a69fbf9697aa2530d3b954365653912a9d893f6a",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 17,
      "paragraph_index": 2,
      "origin": "human",
      "text": "By the time the wren has nested these winter babies will be solemn with the wisdom of their famous race.",
      "output_sha256": "4cd9e3717cb1bf5936d90f79bdcc0d957a92db881ca047bb37816557ffbc829b",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "4cd9e3717cb1bf5936d90f79bdcc0d957a92db881ca047bb37816557ffbc829b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 3,
      "origin": "human",
      "text": "There is no season like the end of February for cleaning out brooks.",
      "output_sha256": "18ada27cb57c98552ddba5d6221454b2f1a233a39ab3ed5c7e6058a9b0141aff",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "18ada27cb57c98552ddba5d6221454b2f1a233a39ab3ed5c7e6058a9b0141aff",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Rushing yellow waters carry a somber assortment of torn leaves, twigs, acorn caps, and stranded bark rafts, remnants that will never seed.",
      "output_sha256": "d03b6c9fc8f53ce1e8c521103545ccdf73f09ce4c4d51991643a196c3ca5f485",
      "alignment_unit_index": 17,
      "alignment_score": 0.485711,
      "human_sentence_indices": [
        17
      ],
      "human_sha256": [
        "53151902c19efe0d09cf4b93e0bb6644364c7d309a91c328beba87adc32947c4"
      ],
      "source_ai_sentence_index": 18,
      "source_ai_sha256": "d03b6c9fc8f53ce1e8c521103545ccdf73f09ce4c4d51991643a196c3ca5f485",
      "ai_unit_sentence_indices": [
        18
      ]
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Standing on one bank or both, according to the sundering flood's ambition, the knight with staff and bold forefinger sets the water princess free.",
      "output_sha256": "eac00ed095988a183fcc2838eb659b7b0367e1df54c79f5aefd4de56049b2c4d",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "eac00ed095988a183fcc2838eb659b7b0367e1df54c79f5aefd4de56049b2c4d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "human",
      "text": "She goes then curtsying and dimpling over the shining gravel, sliding from beneath the ice that roofs her on the uplands down to the softer valleys, where her quickened step will be heard by the frogs in their mansions of mud, and the fish, recluses in rayless pools, will rise to the light she brings.",
      "output_sha256": "6b8e507c13ca93f72fe8e18d9aca28f20a3116e0e3b2dbfe41a513cb8bef3c3f",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "6b8e507c13ca93f72fe8e18d9aca28f20a3116e0e3b2dbfe41a513cb8bef3c3f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Down from the frozen mountains, in summer, birds and winds must bear the seed of alpine flowers—lilies that lean against unmelting snows, poppies, bright-colored herbs, and the palely gleaming, fringed beauties that change names with countries.",
      "output_sha256": "0bcd263ced487750b908c3a102ce6b80a11cb70cfbe3c21642449f2d30fd27ea",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "0bcd263ced487750b908c3a102ce6b80a11cb70cfbe3c21642449f2d30fd27ea",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "It seems only fair that flowers gracing the icy heights in July should also bloom in the warmer lowlands during February.",
      "output_sha256": "18074ccdf4231a99adb6a175bf5f183b7285b6a27c850a4b4934181503f1bc85",
      "alignment_unit_index": 21,
      "alignment_score": 0.458806,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "aa68af621e8f8302ce273b535e7ff83f815f7ef94879a3ba28da20b3b332fa66"
      ],
      "source_ai_sentence_index": 22,
      "source_ai_sha256": "18074ccdf4231a99adb6a175bf5f183b7285b6a27c850a4b4934181503f1bc85",
      "ai_unit_sentence_indices": [
        22
      ]
    },
    {
      "sentence_index": 24,
      "paragraph_index": 4,
      "origin": "human",
      "text": "The pageant of blue, magenta, and scarlet on the austere upper slopes of the Rockies, where nights are bitter to the summer wanderer—why should it not flourish to leeward of a valley barn in months when icicles hang from the eaves in this tamer setting?",
      "output_sha256": "27d23885a6fc0a3816a5490cc3e60d741c8a43c03d4a382ce29995716c8716ba",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "27d23885a6fc0a3816a5490cc3e60d741c8a43c03d4a382ce29995716c8716ba",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 4,
      "origin": "human",
      "text": "But no. Mountain tempests are endurable to the silken-petaled.",
      "output_sha256": "e8fec9b8043e954d3f335826b2c19ed3844982cc61bef31d9e446df08abdf9e8",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "e8fec9b8043e954d3f335826b2c19ed3844982cc61bef31d9e446df08abdf9e8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 4,
      "origin": "human",
      "text": "The treacherous lowland winter, with its coaxing suns followed by roaring desolation, is for blooms bred in a different tradition.",
      "output_sha256": "43d1e9c50bca08f854c0ce15e4ea4287331dbead22b425f79eb0e336405b5b4f",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "43d1e9c50bca08f854c0ce15e4ea4287331dbead22b425f79eb0e336405b5b4f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 5,
      "origin": "human",
      "text": "The light is clear but hesitant, a delicate wine, by no means the mighty vintage of April.",
      "output_sha256": "3b9f8028f6bacec8b42136b5e61571c1d42b766744d713079211038b382232ba",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 25,
      "source_human_sha256": "3b9f8028f6bacec8b42136b5e61571c1d42b766744d713079211038b382232ba",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 5,
      "origin": "human",
      "text": "February has no intoxication; the vague eagerness that gives the air a pulse where fields lie voiceless comes from the secret stirring of imprisoned life.",
      "output_sha256": "0b4598358f18fc4977de8a359212aea8761bc25d8fb9f059fc8d21e9fdc7ca05",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "0b4598358f18fc4977de8a359212aea8761bc25d8fb9f059fc8d21e9fdc7ca05",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Spring and sunrise are forever miracles, but the early hour of the wonder hardly hints the exuberance of its fulfilment.",
      "output_sha256": "6ce24a7b70ad9035f51226633f1c28d5c1258a754d8f6971f32a454d092ad489",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "6ce24a7b70ad9035f51226633f1c28d5c1258a754d8f6971f32a454d092ad489",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Even the forest dwellers move gravely, thankful for any promise of kindness from the lord of day as he hangs above a sea-gray landscape, but knowing well that their long duress is not yet to end.",
      "output_sha256": "321c03fc1e6a2508ec940da34c19787a29b3760512df35b372821ddec170327a",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "321c03fc1e6a2508ec940da34c19787a29b3760512df35b372821ddec170327a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Deer wander pathetically at the edges of farms, gazing at the cattle feasting on winter's pasture from the haystacks, often venturing after dark to clear fences and pilfer from this disheveled larder.",
      "output_sha256": "f679d43938a46bc05a33b959f0f3ac6ccb981df4dba5cb7cc95f16acb5414f43",
      "alignment_unit_index": 29,
      "alignment_score": 0.579758,
      "human_sentence_indices": [
        29
      ],
      "human_sha256": [
        "0c76fd6df7ddfd8fd8110a68877af81d73a80a7bbdd9e52520588f0fae1e14ee"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "f679d43938a46bc05a33b959f0f3ac6ccb981df4dba5cb7cc95f16acb5414f43",
      "ai_unit_sentence_indices": [
        31
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "No chipmunk dares to peek from the fence’s top rail.",
      "output_sha256": "a9b5f9a62420bd5b6a430e3ab100f8a9d01a9ff9e2b2d2f43772fb4007060417",
      "alignment_unit_index": 30,
      "alignment_score": 0.5225,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "5705858007245ff055e439303adfe293318cba6197616fcdcd4e726fb33608c7"
      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "a9b5f9a62420bd5b6a430e3ab100f8a9d01a9ff9e2b2d2f43772fb4007060417",
      "ai_unit_sentence_indices": [
        32
      ]
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "The woodchuck, after his solitary excursion on Candlemas—a duty performed for the enlightenment of mankind—has withdrawn from sight, whether in sunlight or shadow, and shows no inclination to stir just yet.",
      "output_sha256": "a207a8f560d9dfae89431565445486a5c67f4d3a2f7147c0edf2698c6d60894a",
      "alignment_unit_index": 31,
      "alignment_score": 0.473825,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "75de112d422de81396f27e8be49951f92faa9906d0893086e39abb11fdcaa6ac"
      ],
      "source_ai_sentence_index": 33,
      "source_ai_sha256": "a207a8f560d9dfae89431565445486a5c67f4d3a2f7147c0edf2698c6d60894a",
      "ai_unit_sentence_indices": [
        33
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "While snowdrops may feel a flutter of unease, he is well aware of the ominous Ides of March!",
      "output_sha256": "72c8d1a1a6ae86c25e7d600b45284599365fd9afc92df756fe843254540c05ab",
      "alignment_unit_index": 32,
      "alignment_score": 0.493791,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "49682c06300d8759da741f158a60ed28fa06d7eda345619dbb01db6c0309be10"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "72c8d1a1a6ae86c25e7d600b45284599365fd9afc92df756fe843254540c05ab",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Quietest of all Northern woods creatures, the otter slides from one ice-hung waterfall to the next.",
      "output_sha256": "77ce6ec96d2c6a4a6c9229c31c5ee8f160014fe783ccc8a7c2a5b0df89087047",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "77ce6ec96d2c6a4a6c9229c31c5ee8f160014fe783ccc8a7c2a5b0df89087047",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 5,
      "origin": "human",
      "text": "The solitary scamperer left is the cottontail, appealing because he is the most pursued and politest of the furry; faithfully trying to give no offense, except when starvation points to winter cabbage, he is none the less fey.",
      "output_sha256": "aed0d589b396d42a1fbecdf88060dfb6337ca5822b8fce1532d4d66995411f2f",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "aed0d589b396d42a1fbecdf88060dfb6337ca5822b8fce1532d4d66995411f2f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "The mink, too, flits like a ghost through the landscape.",
      "output_sha256": "d008a2ca18d98feb0569f4d2c50eea4685434bb7faffc67378db2f06d0def3e7",
      "alignment_unit_index": 35,
      "alignment_score": 0.44,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "ab0e9d61b42a22e1ad9de5de5c8ede80f43137d2678cdd556b2ddaf2a8654097"
      ],
      "source_ai_sentence_index": 37,
      "source_ai_sha256": "d008a2ca18d98feb0569f4d2c50eea4685434bb7faffc67378db2f06d0def3e7",
      "ai_unit_sentence_indices": [
        37
      ]
    },
    {
      "sentence_index": 38,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "As March approaches, mosses, the first to feel its tread, reveal a brighter hue in the swamps.",
      "output_sha256": "e3b67d82474bab961edb80d750c7b5b1e90bba0aec069f1997a58d8d9e07a4c9",
      "alignment_unit_index": 36,
      "alignment_score": 0.475566,
      "human_sentence_indices": [
        36
      ],
      "human_sha256": [
        "08ebacad59f63e9253784f6645318a70c848da86e6882b5270c1e6e2ab957ad7"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "e3b67d82474bab961edb80d750c7b5b1e90bba0aec069f1997a58d8d9e07a4c9",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 39,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Pussy willows have made a gray dawn in viny caverns where the day's own dawn looks in but faintly, and the flushing of the red willow betrays reveries of a not impossible cowslip upon the bank beneath.",
      "output_sha256": "1fb1150eb78459914282c6adfc56264fce9238c61d8f647c57e9b735d890e657",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "1fb1150eb78459914282c6adfc56264fce9238c61d8f647c57e9b735d890e657",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The blue jay has mentioned it in the course of his voluble recollections.",
      "output_sha256": "f74c762a63a0e909f984a74b37329a15346842568ec7945e11f5d0de8661cf46",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "f74c762a63a0e909f984a74b37329a15346842568ec7945e11f5d0de8661cf46",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 6,
      "origin": "human",
      "text": "He is unwilling to prophesy arbutus, but he will just hint that when the leaves in the wood lot show through snow as early as this....",
      "output_sha256": "8d6d16c9c02e04751dc6c3d0c60714e83b93b192eaaa7713d3ba36ece66ddac9",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "8d6d16c9c02e04751dc6c3d0c60714e83b93b192eaaa7713d3ba36ece66ddac9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Once he found a hepatica bud the last day of February....",
      "output_sha256": "2b61bfac5718a5e01a82b607094aa23a7bbc03a2d75ccc3d7bbb6ff9ecf2f5ea",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "2b61bfac5718a5e01a82b607094aa23a7bbc03a2d75ccc3d7bbb6ff9ecf2f5ea",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Speaking with his old friend, the muskrat, last week....",
      "output_sha256": "aaea29332360421e8a3e4b32137524cc25bbfd5af734528b7c113aad9eaff225",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "aaea29332360421e8a3e4b32137524cc25bbfd5af734528b7c113aad9eaff225",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 6,
      "origin": "human",
      "text": "And when you can see red pebbles in the creek at five o'clock in the afternoon....",
      "output_sha256": "9740657097c2bc28f4d8ecacfcbbb2f29c78f567145fa09934abe8f09ed741c3",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "9740657097c2bc28f4d8ecacfcbbb2f29c78f567145fa09934abe8f09ed741c3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "However, it is futile to anticipate yellow orchids on the western knoll this spring, since some people found them there last year, and after that, one might as well...",
      "output_sha256": "44beed0feb73bd900ca25bd86c8d9f1fd97923274f308c30d6b0415fc7e49e0a",
      "alignment_unit_index": 42,
      "alignment_score": 0.707817,
      "human_sentence_indices": [
        43
      ],
      "human_sha256": [
        "173d7fa4874de923cc1fb5040a042211a1dee92d7cacbf0efa25bf908da39f61"
      ],
      "source_ai_sentence_index": 44,
      "source_ai_sha256": "44beed0feb73bd900ca25bd86c8d9f1fd97923274f308c30d6b0415fc7e49e0a",
      "ai_unit_sentence_indices": [
        44
      ]
    },
    {
      "sentence_index": 46,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Of course cowslips beside red willows are remarkably pretty, just as blue jays in a cedar with blue berries....",
      "output_sha256": "0f802089c9cbef64003329a7b2b4772fee722ad5743afbb8c91bf0f944109cfb",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "0f802089c9cbef64003329a7b2b4772fee722ad5743afbb8c91bf0f944109cfb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "His tales are endless, but he has witnessed much throughout his life.",
      "output_sha256": "0553cf8e8c96bde25df81747c0c8a87cb526575496371f94797056fb751fc772",
      "alignment_unit_index": 44,
      "alignment_score": 0.355888,
      "human_sentence_indices": [
        45
      ],
      "human_sha256": [
        "1414268736be8bd59a37672f056c4082615d8046687fce78a775313585717b4a"
      ],
      "source_ai_sentence_index": 46,
      "source_ai_sha256": "0553cf8e8c96bde25df81747c0c8a87cb526575496371f94797056fb751fc772",
      "ai_unit_sentence_indices": [
        46
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 6,
      "origin": "human",
      "text": "And February needs her blue jays' unwearied and conquering faith.",
      "output_sha256": "891ff656f13ef2697f31000ab4780808f231e2126f1f21c91026d079f13afe2c",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "891ff656f13ef2697f31000ab4780808f231e2126f1f21c91026d079f13afe2c",
      "ai_unit_sentence_indices": []
    }
  ]
}
