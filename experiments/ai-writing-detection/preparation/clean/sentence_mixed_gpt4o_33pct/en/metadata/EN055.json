    {
      "sentence_index": 66,
      "paragraph_index": 9,
      "origin": "human",
      "text": "I looked at the strange cabman as he lessened in the distance and the mists.",
      "output_sha256": "756b71dadffea3825cdf79bc0b448ee03cbd53976d6f521210073e00e05b515c",
      "alignment_unit_index": 59,
      "alignment_score": null,
