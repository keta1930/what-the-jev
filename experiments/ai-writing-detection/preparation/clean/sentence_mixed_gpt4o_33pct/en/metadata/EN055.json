      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 67,
      "paragraph_index": 9,
      "origin": "human",
      "text": "I do not know whether I was right in fancying that although his face had seemed so honest there was something unearthly and demoniac about him when seen from behind.",
      "output_sha256": "30e2d5d375240040fde86e244d7637efcaed8e20260c9264ad4bd9519ef12b15",
      "alignment_unit_index": 59,
      "alignment_score": null,
      "source_human_sentence_index": 66,
      "source_human_sha256": "30e2d5d375240040fde86e244d7637efcaed8e20260c9264ad4bd9519ef12b15",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 68,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "Perhaps he had come to challenge my commitment to the certainties I had defended earlier that day.",
      "output_sha256": "ecfb3ec51d4148db488b31f30730496066867e53e2fb9b2117b0ace5839505e6",
      "alignment_unit_index": 60,
      "alignment_score": 0.570466,
