      ],
      "source_ai_sentence_index": 66,
      "source_ai_sha256": "ecfb3ec51d4148db488b31f30730496066867e53e2fb9b2117b0ace5839505e6",
      "ai_unit_sentence_indices": [
        66
      ]
    },
    {
      "sentence_index": 69,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "Regardless, it brought me comfort to reflect on the fact that my understanding of reality, though shaken for a brief moment, remained intact.",
