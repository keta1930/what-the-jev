  "mixed_article_sha256": "bec52599995f6cc3eca5033b6ffc7507216612c0b63c79691c6ca4bb7f48b78c",
  "human_source_sentence_count": 43,
  "ai_source_sentence_count": 44,
  "alignment_unit_count": 43,
  "selected_alignment_unit_count": 14,
  "mixed_sentence_count": 44,
  "selected_ai_sentence_count": 15,
  "actual_ai_sentence_ratio": 0.340909,
  "selected_alignment_score_min": 0.363333,
