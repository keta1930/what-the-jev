      "ai_unit_sentence_indices": [
        64
      ]
    },
    {
      "sentence_index": 73,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "\"No rain today,\" Brant assures us, \"and the barometer is rising.\"",
      "output_sha256": "454b09f5cb5ad9f62fe5dde34fc3b2842b300e438c511c625acd2bad69a5d332",
