      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 76,
      "paragraph_index": 12,
      "origin": "human",
      "text": "Besides, I haven't any coppers.",
      "output_sha256": "a2ec299bebad91a1fd091e472484b4fca9f808974545555270d0de416037efbf",
      "alignment_unit_index": 69,
      "alignment_score": null,
