      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 71,
      "paragraph_index": 12,
      "origin": "human",
      "text": "We greet each other happily and climb into the wagonette.",
      "output_sha256": "506d27e261e2c82beae32576f60e8957e587645af5b3dfd7d7e3736958c805e3",
      "alignment_unit_index": 64,
      "alignment_score": null,
      "source_human_sentence_index": 72,
