      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 70,
      "paragraph_index": 11,
      "origin": "human",
      "text": "And if Cynthia really thinks that she can play croquet …",
      "output_sha256": "4afab3d3569e52871e8b204de00310202e6068c7997a765c2d3abd89b1805d5c",
