      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 72,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "The countryside appears more beautiful than ever.",
      "output_sha256": "6f476871c427d6ad99efaedb626a36ed0a6ef261d92ef9548c401a69b17c4573",
      "alignment_unit_index": 65,
