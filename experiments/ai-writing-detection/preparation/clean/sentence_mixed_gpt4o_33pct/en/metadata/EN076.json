      "ai_unit_sentence_indices": [
        66
      ]
    },
    {
      "sentence_index": 75,
      "paragraph_index": 12,
      "origin": "human",
      "text": "It is a rotten life being a porter, and I do so want everybody to enjoy this afternoon.",
      "output_sha256": "3a059e123b29baa7d01d9c9cfb72deb0eedd9e08e599651405d1d8c8ba1b749f",
      "alignment_unit_index": 68,
