      "ai_unit_sentence_indices": [
        65
      ]
    },
    {
      "sentence_index": 74,
      "paragraph_index": 12,
      "origin": "ai",
      "text": "The porter loads our luggage into the cart and smiles at us.",
      "output_sha256": "09f08ea95b2ba2bf4b6ec086cac1bc4473f9271950f5304107e45b141bf700eb",
      "alignment_unit_index": 67,
      "alignment_score": 0.545554,
