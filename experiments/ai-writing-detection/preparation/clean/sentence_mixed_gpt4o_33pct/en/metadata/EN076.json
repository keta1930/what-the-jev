      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 69,
      "paragraph_index": 11,
      "origin": "human",
      "text": "I must get that shilling back from Bob that I lost to him at billiards last time.",
      "output_sha256": "386be787588b2e0769b8b5113b2a500cff79497e063be6db4ce09c3cf96a4d41",
      "alignment_unit_index": 62,
