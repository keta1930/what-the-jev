      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 77,
      "paragraph_index": 13,
      "origin": "human",
      "text": "I slip half a crown into his palm.",
      "output_sha256": "afc77ea686033905fbd25a266a0734028dd5acf9982a630e32dbd7afbb62a19f",
      "alignment_unit_index": 70,
