    {
      "sentence_index": 78,
      "paragraph_index": 13,
      "origin": "human",
      "text": "Now we are all very, very happy.",
      "output_sha256": "1aef0a043899a576c9a832f418ddb95b211e1ec10dbc597fa8d53022ca65a29b",
