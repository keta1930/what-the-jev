  "selected_alignment_score_max": 0.564286,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "The other day, to my great astonishment, I caught a train; it was a train going into the Eastern Counties, and I only just caught it.",
      "output_sha256": "52e6e0723001a524c4eabbc3c3fd52db451f6d985cfae4f34bdc7d9c8192b062",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "52e6e0723001a524c4eabbc3c3fd52db451f6d985cfae4f34bdc7d9c8192b062",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "And while I was running along the train (amid general admiration) I noticed that there were a quite peculiar and unusual number of carriages marked “Engaged.”",
      "output_sha256": "a05c64af03ac9c30c7d54badfa23344c81b561c5bc5141e885d89d779a127cf8",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "a05c64af03ac9c30c7d54badfa23344c81b561c5bc5141e885d89d779a127cf8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "The notices were visible on five, six, seven, or even eight carriages, with large, imposing men gazing out from the windows, their expressions reflecting a peculiar pride.",
      "output_sha256": "07b5de0a8d47ecf1d9ffec29d062df36050730f0d69d272038fa4b9164063948",
      "alignment_unit_index": 3,
      "alignment_score": 0.413849,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "4e240bca0887e150b01eb9ae49eb14c551b464bba3606d02df55fe3430e986d8"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "07b5de0a8d47ecf1d9ffec29d062df36050730f0d69d272038fa4b9164063948",
      "ai_unit_sentence_indices": [
        3
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "Their demeanor seemed especially impenetrable, and their faces wore an unusual calmness.",
      "output_sha256": "8aaeb16eee27e74cc18e82fead685bec8519f0d0e55eabf65a0631007ca9e908",
      "alignment_unit_index": 4,
      "alignment_score": 0.478901,
      "human_sentence_indices": [
        4
      ],
      "human_sha256": [
        "a765914eb072657ba29387d770327e379af9880cb0714f4f8c3fc89beed8d478"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "8aaeb16eee27e74cc18e82fead685bec8519f0d0e55eabf65a0631007ca9e908",
      "ai_unit_sentence_indices": [
        4
      ]
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "It was not Derby Day, as the train was headed in the opposite direction and it was not the appropriate time.",
      "output_sha256": "fea78c90c6b5a27165023f4e8024d2fd8dba849b311f6c93b66be6cd61e7ad60",
      "alignment_unit_index": 5,
      "alignment_score": 0.463062,
      "human_sentence_indices": [
        5
      ],
      "human_sha256": [
        "f572d614cebfe58f264870dc1e5b02a34b49fa80e7f4f772bf063d03f78ba7bf"
      ],
      "source_ai_sentence_index": 5,
      "source_ai_sha256": "fea78c90c6b5a27165023f4e8024d2fd8dba849b311f6c93b66be6cd61e7ad60",
      "ai_unit_sentence_indices": [
        5
      ]
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It could hardly be the King.",
      "output_sha256": "9ec5fc19e7642bbf14ff0858a8a80c6d480cb7b654104c3d94c8bcf114011e88",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "9ec5fc19e7642bbf14ff0858a8a80c6d480cb7b654104c3d94c8bcf114011e88",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It could hardly be the French President.",
      "output_sha256": "a755ee0edf4d51107c9d061e8b28c6c8ec159677b3595a236d8fe940ab0068c3",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 7,
      "source_human_sha256": "a755ee0edf4d51107c9d061e8b28c6c8ec159677b3595a236d8fe940ab0068c3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 1,
      "origin": "human",
      "text": "For, though these distinguished persons naturally like to be private for three hours, they are at least public for three minutes.",
      "output_sha256": "e1cb109bcbaba4c4be7fd2d44fb88fc30d9b058850024c7fc73e4760c7da4430",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "e1cb109bcbaba4c4be7fd2d44fb88fc30d9b058850024c7fc73e4760c7da4430",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 1,
      "origin": "human",
      "text": "A crowd can gather to see them step into the train; and there was no crowd here, or any police ceremonial.",
      "output_sha256": "b8e7f014bb90af7a108f0afbf8cead562daab16da9d69eb608e848b895c83a44",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "b8e7f014bb90af7a108f0afbf8cead562daab16da9d69eb608e848b895c83a44",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Who were these formidable individuals occupying a substantial portion of the train, outnumbering a gathering of revelers yet exhibiting a peculiar delicacy that seemed more fitting for the royal entourage?",
      "output_sha256": "95e98cdcd4d2868a797230e180da0482a8f63a535e88140d072cac87129cd7c4",
      "alignment_unit_index": 9,
      "alignment_score": 0.376138,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "f1a771ee7dfb04a9025b207335b2b4ceb415d461f9ac529d4464ad18e548a9ee"
      ],
      "source_ai_sentence_index": 9,
      "source_ai_sha256": "95e98cdcd4d2868a797230e180da0482a8f63a535e88140d072cac87129cd7c4",
      "ai_unit_sentence_indices": [
        9
      ]
    },
    {
      "sentence_index": 11,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Who were these that were larger than a mob, yet more mysterious than a monarch?",
      "output_sha256": "5282d69a5d344f98e4851ae8cf612234adada907719317f37a5f72589fa485d6",
      "alignment_unit_index": 10,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "5282d69a5d344f98e4851ae8cf612234adada907719317f37a5f72589fa485d6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 12,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Was it possible that instead of our Royal House visiting the Tsar, he was really visiting us?",
      "output_sha256": "4191896f36c127c8b27e3fb7df8d3b6aba30ca583493188def97edbf268727d1",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "4191896f36c127c8b27e3fb7df8d3b6aba30ca583493188def97edbf268727d1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Or perhaps there was a breakfast gathering of the House of Lords?",
      "output_sha256": "aea20b42bf9ed25e9a63149a843827cad9fc4d125a9d47484a0ca34fc2270360",
      "alignment_unit_index": 12,
      "alignment_score": 0.564286,
      "human_sentence_indices": [
        13
      ],
      "human_sha256": [
        "141ea8934113d858eaa607ca91b875e830d6421b80d1cfd69a2e13372987dd34"
      ],
      "source_ai_sentence_index": 11,
      "source_ai_sha256": "aea20b42bf9ed25e9a63149a843827cad9fc4d125a9d47484a0ca34fc2270360",
      "ai_unit_sentence_indices": [
        11
      ]
    },
    {
      "sentence_index": 14,
      "paragraph_index": 2,
      "origin": "human",
      "text": "I waited and wondered until the train slowed down at some station in the direction of Cambridge.",
      "output_sha256": "a508ce15ea2ebb9e18ba3f7d1fc3b5e5ed3c4c2003e7ee9444c09d35ac93503f",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "a508ce15ea2ebb9e18ba3f7d1fc3b5e5ed3c4c2003e7ee9444c09d35ac93503f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Then the large, impenetrable men got out, and after them got out the distinguished holders of the engaged seats.",
      "output_sha256": "b999919a4cc6e4c4a2f2565031024fffc00e1f628e7d0c1a25a56ed5c7347b15",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "b999919a4cc6e4c4a2f2565031024fffc00e1f628e7d0c1a25a56ed5c7347b15",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 2,
      "origin": "human",
      "text": "They were all dressed decorously in one colour; they had neatly cropped hair; and they were chained together.",
      "output_sha256": "849f9790c44cbc9795ff378abd429eb5a17f3400883717355b54e4914024a3f6",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "849f9790c44cbc9795ff378abd429eb5a17f3400883717355b54e4914024a3f6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 3,
      "origin": "human",
      "text": "I looked across the carriage at its only other occupant, and our eyes met.",
      "output_sha256": "b72628a72a2586d2f10841c3ac8e3a5963b36e310a746f12fcc8469c8bcd85ae",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "b72628a72a2586d2f10841c3ac8e3a5963b36e310a746f12fcc8469c8bcd85ae",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "He was a small, weary-looking man, who I later learned hailed from Cambridge.",
      "output_sha256": "e6d412412a92f530ec22ae80b28f58e1574498b0f6ebefa05ecd12454db878ef",
      "alignment_unit_index": 16,
      "alignment_score": 0.473939,
      "human_sentence_indices": [
        18
      ],
      "human_sha256": [
        "9b30a4004013278ed367ed9376a6a06189bca134998e7378554ba16e2ab201e0"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "e6d412412a92f530ec22ae80b28f58e1574498b0f6ebefa05ecd12454db878ef",
      "ai_unit_sentence_indices": [
        15,
        16
      ]
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Judging by his appearance, he seemed to be a local tradesman, perhaps a journeyman tailor or a clock mender.",
      "output_sha256": "449e62dd5eefaf950f738775f6beec50cd57bac11544b32f20e24ad13bfb24c2",
      "alignment_unit_index": 16,
      "alignment_score": 0.473939,
      "human_sentence_indices": [
        18
      ],
      "human_sha256": [
        "9b30a4004013278ed367ed9376a6a06189bca134998e7378554ba16e2ab201e0"
      ],
      "source_ai_sentence_index": 16,
      "source_ai_sha256": "449e62dd5eefaf950f738775f6beec50cd57bac11544b32f20e24ad13bfb24c2",
      "ai_unit_sentence_indices": [
        15,
        16
      ]
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "In an effort to strike up a conversation, I expressed my curiosity about where the convicts might be headed.",
      "output_sha256": "0c7ede14fa9e363654b35e8f30aaa499aac35424097dd8b9477658abbc5058d9",
      "alignment_unit_index": 17,
      "alignment_score": 0.444528,
      "human_sentence_indices": [
        19
      ],
      "human_sha256": [
        "4f7e512e75b3c9e251634934e05fb44596af8463b9f6e1c5183b9724b2f87c86"
      ],
      "source_ai_sentence_index": 17,
      "source_ai_sha256": "0c7ede14fa9e363654b35e8f30aaa499aac35424097dd8b9477658abbc5058d9",
      "ai_unit_sentence_indices": [
        17
      ]
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "human",
      "text": "His mouth twitched with the instinctive irony of our poor, and he said: “I don’t s’pose they’re goin’ on an ’oliday at the seaside with little spades and pails.”",
      "output_sha256": "de7b9baf85ec3c14ce4976bf10fcb2f50f8d7ff556f2fb4bc7c26b06fc71991c",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "de7b9baf85ec3c14ce4976bf10fcb2f50f8d7ff556f2fb4bc7c26b06fc71991c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "I found his humor delightful and continued to play along, suggesting that maybe academics were being escorted to Cambridge in similar chains.",
      "output_sha256": "29fc7ab9391ff365411ddb3b864882bdc6dbea3ae39abd539e2c2a297e0391b5",
      "alignment_unit_index": 19,
      "alignment_score": 0.342076,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "8098e06981c9dc5069cca86eb4689779d31c777ea8bffaa2fa13abbc96f7d251"
      ],
      "source_ai_sentence_index": 19,
      "source_ai_sha256": "29fc7ab9391ff365411ddb3b864882bdc6dbea3ae39abd539e2c2a297e0391b5",
      "ai_unit_sentence_indices": [
        19
      ]
    },
    {
      "sentence_index": 23,
      "paragraph_index": 3,
      "origin": "human",
      "text": "And as he lived in Cambridge, and had seen several dons, he was pleased with such a scheme.",
      "output_sha256": "0052534544d8c046909086565e1b11e463725a3153f999877d338de53df4e800",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "0052534544d8c046909086565e1b11e463725a3153f999877d338de53df4e800",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Then when we had ceased to laugh, we suddenly became quite silent; and the bleak, grey eyes of the little man grew sadder and emptier than an open sea.",
      "output_sha256": "b16e8dc5ad216d35fa1056ce53120749d5ee3ee8048d623937fb858bb68c2190",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "b16e8dc5ad216d35fa1056ce53120749d5ee3ee8048d623937fb858bb68c2190",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 3,
      "origin": "human",
      "text": "I knew what he was thinking, because I was thinking the same, because all modern sophists are only sophists, and there is such a thing as mankind.",
      "output_sha256": "56dcf0bd2a868e74ef6f2335efe2240745c3cbd5df9c3375819aeb3b0054698c",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "56dcf0bd2a868e74ef6f2335efe2240745c3cbd5df9c3375819aeb3b0054698c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Then at last (and it fell in as exactly as the right last note of a tune one is trying to remember) he said: “Well, I s’pose we ’ave to do it.”",
      "output_sha256": "503f641d2b167e97cdfdc54010cbfd07caa288cf09bf98dbdd218057bb6c2677",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 25,
      "source_human_sha256": "503f641d2b167e97cdfdc54010cbfd07caa288cf09bf98dbdd218057bb6c2677",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 3,
      "origin": "human",
      "text": "And in those three things, his first speech and his silence and his second speech, there were all the three great fundamental facts of the English democracy, its profound sense of humour, its profound sense of pathos, and its profound sense of helplessness.",
      "output_sha256": "5f6b5ea472391bcddbbac12b1530c8fc0ab6411817c6774b275161d099088c35",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "5f6b5ea472391bcddbbac12b1530c8fc0ab6411817c6774b275161d099088c35",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 4,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 5,
      "origin": "human",
      "text": "It cannot be too often repeated that all real democracy is an attempt (like that of a jolly hostess) to bring the shy people out.",
      "output_sha256": "8608f66b9e3b6d0d82ac7893e11e64e0ce1ae287275ae30791d14c5adbb263f4",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "8608f66b9e3b6d0d82ac7893e11e64e0ce1ae287275ae30791d14c5adbb263f4",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "For the practical operations of a political entity, as well as the social dynamics of a tea party, it is clear that those who humble themselves will find elevation.",
      "output_sha256": "f94e977518527d9bd4370f60cecb81f2b990f616868e18f37eeb65f66cda5086",
      "alignment_unit_index": 26,
      "alignment_score": 0.367901,
      "human_sentence_indices": [
        29
      ],
      "human_sha256": [
        "1f5a78883c2a0b572217cc1dfcd740e7b448d87ba706d974369fbf804865e12c"
      ],
      "source_ai_sentence_index": 26,
      "source_ai_sha256": "f94e977518527d9bd4370f60cecb81f2b990f616868e18f37eeb65f66cda5086",
      "ai_unit_sentence_indices": [
        26
      ]
    },
    {
      "sentence_index": 31,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Conversely, those who seek to elevate themselves must be brought low, ideally without resorting to physical force.",
      "output_sha256": "4a3223affafe4a09dba163bf76d8e00f9917789126522c99784eb3ed799d4f52",
      "alignment_unit_index": 27,
      "alignment_score": 0.270246,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "456a83a0a520a72e7453fb53bb46314227c917f174d1b460b28eb4b17a13870b"
      ],
      "source_ai_sentence_index": 27,
      "source_ai_sha256": "4a3223affafe4a09dba163bf76d8e00f9917789126522c99784eb3ed799d4f52",
      "ai_unit_sentence_indices": [
        27
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "People often perceive democracy as rough and unruly, which is a misconception rooted in historical ignorance.",
      "output_sha256": "26858c86119ff085459f37e7c1fdb99c838831a260ab28e5097b1596214d0f39",
      "alignment_unit_index": 28,
      "alignment_score": 0.394651,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "93c29787f4816fb6c4cccd9a3137277633981fe570402dc0df0a3f29267e79cd"
      ],
      "source_ai_sentence_index": 28,
      "source_ai_sha256": "26858c86119ff085459f37e7c1fdb99c838831a260ab28e5097b1596214d0f39",
      "ai_unit_sentence_indices": [
        28
      ]
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "It is aristocracy that tends to be coarse and disorderly, as it appeals to those who possess self-assurance.",
      "output_sha256": "44f36c084b52983b3e4d9e362089c686600aecc0c7a8a4b0620582f0b7e5f1a0",
      "alignment_unit_index": 29,
      "alignment_score": 0.39,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "decc080359d490b7fe9b40e1712fc7fcabd6ac5d170cf0f0187ba1089ab25c60"
      ],
      "source_ai_sentence_index": 29,
      "source_ai_sha256": "44f36c084b52983b3e4d9e362089c686600aecc0c7a8a4b0620582f0b7e5f1a0",
      "ai_unit_sentence_indices": [
        29
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Democracy, on the other hand, seeks to engage those who may hesitate to govern themselves; according to Christian principles, the very individuals who ought to rule are precisely those who lack the audacity to take charge.",
      "output_sha256": "9e56c32fdd1efbfc52ac22d5da4606f21710b6c5ec6d3317b51018133abf8c91",
      "alignment_unit_index": 30,
      "alignment_score": 0.440719,
      "human_sentence_indices": [
        33,
        34
      ],
      "human_sha256": [
        "384b05a911faebbe4a54c4e80cbc17d08721b59ceac3dae758e236626380a411",
        "e71c023b8376bc1290749583646353a242ac46556c77f8210e27d54157e41627"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "9e56c32fdd1efbfc52ac22d5da4606f21710b6c5ec6d3317b51018133abf8c91",
      "ai_unit_sentence_indices": [
        30
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "My encounter with the man on the train serves as a compelling illustration of this principle.",
      "output_sha256": "2d7f4201b12728027ac92b2fa663f22f86e31acde03112bbe860822b572eff9a",
      "alignment_unit_index": 31,
      "alignment_score": 0.292273,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "506a9664c775901b34b64c259e57a9693ac97cd980c4a386659059d5b54fa41e"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "2d7f4201b12728027ac92b2fa663f22f86e31acde03112bbe860822b572eff9a",
      "ai_unit_sentence_indices": [
        31
      ]
    },
    {
      "sentence_index": 36,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "The discussions surrounding crime and punishment typically highlight two rare and extreme perspectives.",
      "output_sha256": "12685e72b1a1e33a9e1041d766c006e3b0d6856ed1c1a080d7de1d269ba9d719",
      "alignment_unit_index": 32,
      "alignment_score": 0.429692,
      "human_sentence_indices": [
        36
      ],
      "human_sha256": [
        "0fec7d5286ad2dea10a0fe6d4cdb800b77b313b62e16a6f659dd116381a656b3"
      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "12685e72b1a1e33a9e1041d766c006e3b0d6856ed1c1a080d7de1d269ba9d719",
      "ai_unit_sentence_indices": [
        32
      ]
    },
    {
      "sentence_index": 37,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "On one hand, we have the stark sentimentalist who suggests that no issues exist, advocating that physical kindness could resolve everything, as if all that was required was to offer a pat to figures like Nero or Ivan the Terrible.",
      "output_sha256": "43a73ae1cc5ac03d21bf37b9a9401e319915da789652e1033cce043b69f80dff",
      "alignment_unit_index": 33,
      "alignment_score": 0.513129,
      "human_sentence_indices": [
        37
      ],
      "human_sha256": [
        "11270f466b63f05bea32caa2ec47d51ba5d2ba240512bec4d6dc122edacfc8d9"
      ],
      "source_ai_sentence_index": 33,
      "source_ai_sha256": "43a73ae1cc5ac03d21bf37b9a9401e319915da789652e1033cce043b69f80dff",
      "ai_unit_sentence_indices": [
        33
      ]
    },
    {
      "sentence_index": 38,
      "paragraph_index": 6,
      "origin": "human",
      "text": "This mere belief in bodily humanitarianism is not sentimental; it is simply snobbish.",
      "output_sha256": "4761aa6a4bb9f3a8760a94dc67a4ad0b16bd8516b68e91a036db977702ea9a1f",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "4761aa6a4bb9f3a8760a94dc67a4ad0b16bd8516b68e91a036db977702ea9a1f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 6,
      "origin": "human",
      "text": "For if comfort gives men virtue, the comfortable classes ought to be virtuous—which is absurd.",
      "output_sha256": "871ea45951cc9ef245c8d3fb2a1db1d313c8b682ef9f4155c95b7c91fa2c6bf2",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "871ea45951cc9ef245c8d3fb2a1db1d313c8b682ef9f4155c95b7c91fa2c6bf2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Then, again, we do hear of the yet weaker and more watery type of sentimentalists: I mean the sentimentalist who says, with a sort of splutter, “Flog the brutes!” or who tells you with innocent obscenity “what he would do” with a certain man—always supposing the man’s hands were tied.",
      "output_sha256": "03014aed53d4191b622b5a169a302674c60f50f9ecd9d798eee20fcd9e4401b2",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "03014aed53d4191b622b5a169a302674c60f50f9ecd9d798eee20fcd9e4401b2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 7,
      "origin": "human",
      "text": "This is the more effeminate type of the two; but both are weak and unbalanced.",
      "output_sha256": "f8c9049527b49d2aa5e14afd964c6a9ae530b2fe50f15d0aa58c9ecf43c39267",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "f8c9049527b49d2aa5e14afd964c6a9ae530b2fe50f15d0aa58c9ecf43c39267",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 7,
      "origin": "human",
      "text": "And it is only these two types, the sentimental humanitarian and the sentimental brutalitarian, whom one hears in the modern babel.",
      "output_sha256": "7130c2d556072a0781f8dac12e3bcaab24066592fdf3ff9865e8f005351e34b7",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "7130c2d556072a0781f8dac12e3bcaab24066592fdf3ff9865e8f005351e34b7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Yet you very rarely meet either of them in a train.",
      "output_sha256": "ab8d4feec538608c39b3cb9cc06313748719431f4440aca2796a86bcb1fd00fd",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "ab8d4feec538608c39b3cb9cc06313748719431f4440aca2796a86bcb1fd00fd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 7,
      "origin": "human",
      "text": "You never meet anyone else in a controversy.",
      "output_sha256": "434325a0e080a6196bb7baf6c6af7d85b20f7145d9db4adb0fa452b56dec623b",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "434325a0e080a6196bb7baf6c6af7d85b20f7145d9db4adb0fa452b56dec623b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 7,
      "origin": "human",
      "text": "The man you meet in a train is like this man that I met: he is emotionally decent, only he is intellectually doubtful.",
      "output_sha256": "2b72cecc12caaacef81023edfa5ede00095e2f414977448354d7475cd6bc6455",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "2b72cecc12caaacef81023edfa5ede00095e2f414977448354d7475cd6bc6455",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 7,
      "origin": "human",
      "text": "So far from luxuriating in the loathsome things that could be “done” to criminals, he feels bitterly how much better it would be if nothing need be done.",
      "output_sha256": "d554f06ab2c1937a5d9c6007b8b068ca52c006ccc91afbf14d97a0571f2e25a8",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "d554f06ab2c1937a5d9c6007b8b068ca52c006ccc91afbf14d97a0571f2e25a8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 7,
      "origin": "human",
      "text": "But something must be done.",
      "output_sha256": "56e56cd75a078e9bb648c5eedcff085c3b2d686b448456be2144a667af9a4865",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 47,
      "source_human_sha256": "56e56cd75a078e9bb648c5eedcff085c3b2d686b448456be2144a667af9a4865",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 48,
      "paragraph_index": 7,
      "origin": "human",
      "text": "“I s’pose we ’ave to do it.”",
      "output_sha256": "84ff673e87ca1d9418c2f424337dd7c59e3280ee86638dbdc90793fdeaf45e0c",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "84ff673e87ca1d9418c2f424337dd7c59e3280ee86638dbdc90793fdeaf45e0c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 7,
      "origin": "human",
      "text": "In short, he is simply a sane man, and of a sane man there is only one safe definition.",
      "output_sha256": "9417445b8045e8a9aa2705ba88e958fa2ca27f081902414d406cfea837e90c86",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "9417445b8045e8a9aa2705ba88e958fa2ca27f081902414d406cfea837e90c86",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He is a man who can have tragedy in his heart and comedy in his head.",
      "output_sha256": "cbe09218ca626a639307ea3c95ee28495a2327f24fea471cebc98da514d057b6",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "cbe09218ca626a639307ea3c95ee28495a2327f24fea471cebc98da514d057b6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 8,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 51,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "The challenge in addressing the issue of how to treat criminals with decency lies in the detachment exhibited by both sides of the argument.",
      "output_sha256": "1b031035426acd3ae9155c523d00462a0397ba1b68689b4bb5e5a35dbd93ff30",
      "alignment_unit_index": 44,
      "alignment_score": 0.269056,
      "human_sentence_indices": [
        52
      ],
      "human_sha256": [
        "b22d9bd621df47f7f8460aaf498da4e85abdcafbb6e11e1e090e132bcbc9b823"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "1b031035426acd3ae9155c523d00462a0397ba1b68689b4bb5e5a35dbd93ff30",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 53,
      "paragraph_index": 9,
      "origin": "human",
      "text": "The denouncers of wrong are as cold as the organisers of wrong.",
      "output_sha256": "5eb2931343e7d5cdbe2c1f733db5caaa4c38ab6eadb697c8bdcb7446d59b9ee8",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "5eb2931343e7d5cdbe2c1f733db5caaa4c38ab6eadb697c8bdcb7446d59b9ee8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "Humanitarianism can sometimes be as harsh as inhumanity itself.",
      "output_sha256": "880b7c0d6d72d79362adb94acb63422c259dce985052a4c1f2015ba5dbe27549",
      "alignment_unit_index": 46,
      "alignment_score": 0.509048,
      "human_sentence_indices": [
        54
      ],
      "human_sha256": [
        "21233203ba3a9fa42a40cc4ec3b4fddfa31bb74b325273b01aad4527cf990a10"
      ],
      "source_ai_sentence_index": 44,
      "source_ai_sha256": "880b7c0d6d72d79362adb94acb63422c259dce985052a4c1f2015ba5dbe27549",
      "ai_unit_sentence_indices": [
        44
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Let me take one practical instance.",
      "output_sha256": "fbb35ef65f118fd1fa73059ff5a58bae5bfad16dd9c5c3e7c1b037a7d0e63cd5",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "fbb35ef65f118fd1fa73059ff5a58bae5bfad16dd9c5c3e7c1b037a7d0e63cd5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 10,
      "origin": "human",
      "text": "I think the flogging arranged in our modern prisons is a filthy torture; all its scientific paraphernalia, the photographing, the medical attendance, prove that it goes to the last foul limit of the boot and rack.",
      "output_sha256": "75cb7ee512e83f2d4093b0380d509dee84ada4f6662febdc4c17890c4749eea1",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "75cb7ee512e83f2d4093b0380d509dee84ada4f6662febdc4c17890c4749eea1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "The cat-o'-nine-tails is merely a modern version of the rack, stripped of any intellectual justification.",
      "output_sha256": "2857b38e4fc0012c6a1d20e47c585abd334b3e5076c3b63cdd986e33d2917457",
      "alignment_unit_index": 48,
      "alignment_score": 0.479231,
      "human_sentence_indices": [
        57
      ],
      "human_sha256": [
        "54c1ca09d1b43cfc14b5820a7d4ff31128b0fcc5b0fc4d3afc49634b4f2d95a2"
      ],
      "source_ai_sentence_index": 47,
      "source_ai_sha256": "2857b38e4fc0012c6a1d20e47c585abd334b3e5076c3b63cdd986e33d2917457",
      "ai_unit_sentence_indices": [
        47
      ]
    },
    {
      "sentence_index": 58,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Holding this view strongly, I open the ordinary humanitarian books or papers and I find a phrase like this, “The lash is a relic of barbarism.”",
      "output_sha256": "03232b87068d37a608d1822f9c3f81ba0c255dacfdf08ea52cfcb1409988c16c",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "03232b87068d37a608d1822f9c3f81ba0c255dacfdf08ea52cfcb1409988c16c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 10,
      "origin": "human",
      "text": "So is the plough.",
      "output_sha256": "a55f50581daf2b8885cd46217b072d35ea9ab90cb0f487d5589b49706a0648d6",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "a55f50581daf2b8885cd46217b072d35ea9ab90cb0f487d5589b49706a0648d6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 10,
      "origin": "human",
      "text": "So is the fishing net.",
      "output_sha256": "2a7f758d10f882fa0f2fc910ebc4cc0e8517eaa3a20c5dedd70a4288f951a696",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 60,
      "source_human_sha256": "2a7f758d10f882fa0f2fc910ebc4cc0e8517eaa3a20c5dedd70a4288f951a696",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 10,
      "origin": "human",
      "text": "So is the horn or the staff or the fire lit in winter.",
      "output_sha256": "13b9a8c0967b30869c8fea19b4c40312d554f4ba539d146cc9c63b25a9490900",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "13b9a8c0967b30869c8fea19b4c40312d554f4ba539d146cc9c63b25a9490900",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 10,
      "origin": "human",
      "text": "What an inexpressibly feeble phrase for anything one wants to attack—a relic of barbarism!",
      "output_sha256": "45bb7a0792731319ad3433beca7b8646ee4b7fbea3b24883784b688bbfaafb9a",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 62,
      "source_human_sha256": "45bb7a0792731319ad3433beca7b8646ee4b7fbea3b24883784b688bbfaafb9a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 63,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "It’s akin to a person walking naked down the street, and our response is to critique their outdated fashion choices.",
      "output_sha256": "6e59fe6ab8e187d60d721f5f2a5a7dd9480bb20b7e18d0895a0013b8a7ee4911",
      "alignment_unit_index": 53,
      "alignment_score": 0.413158,
      "human_sentence_indices": [
        63
      ],
      "human_sha256": [
        "5d453c6c64cf768c38962aeeda2e82f12bfe1ad132243b22f067eab652367aa1"
      ],
      "source_ai_sentence_index": 50,
      "source_ai_sha256": "6e59fe6ab8e187d60d721f5f2a5a7dd9480bb20b7e18d0895a0013b8a7ee4911",
      "ai_unit_sentence_indices": [
        50
      ]
    },
    {
      "sentence_index": 64,
      "paragraph_index": 10,
      "origin": "human",
      "text": "There is nothing particularly nasty about being a relic of barbarism.",
      "output_sha256": "5b5493f79ed698b2537851e09ec7a5ead4c9aa3a389e5b840eae9be4ccbf1106",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "5b5493f79ed698b2537851e09ec7a5ead4c9aa3a389e5b840eae9be4ccbf1106",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 65,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Man is a relic of barbarism.",
      "output_sha256": "d4d63e48672900568a23878cc09669b10c85c8969cb7d3e5bb777194a4258066",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 65,
      "source_human_sha256": "d4d63e48672900568a23878cc09669b10c85c8969cb7d3e5bb777194a4258066",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 66,
      "paragraph_index": 10,
      "origin": "human",
      "text": "Civilisation is a relic of barbarism.",
      "output_sha256": "37b82fa14299d602eda61b7955a4b0592d60aef49806df589d31ec698046a214",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 66,
      "source_human_sha256": "37b82fa14299d602eda61b7955a4b0592d60aef49806df589d31ec698046a214",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 67,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "However, torture cannot simply be dismissed as a relic of barbarism.",
      "output_sha256": "5eaca73ecbd998dc04e9604842236b2c649c760903b1c3c2ad2c462eb08ad535",
      "alignment_unit_index": 55,
      "alignment_score": 0.508604,
      "human_sentence_indices": [
        67
      ],
      "human_sha256": [
        "c1464ef2f3438bdb6c1561293c47ba9de30316719d911c51d1e7298e32b54afa"
      ],
      "source_ai_sentence_index": 52,
      "source_ai_sha256": "5eaca73ecbd998dc04e9604842236b2c649c760903b1c3c2ad2c462eb08ad535",
      "ai_unit_sentence_indices": [
        52
      ]
    },
    {
      "sentence_index": 68,
      "paragraph_index": 11,
      "origin": "human",
      "text": "In actuality it is simply a relic of sin; but in comparative history it may well be called a relic of civilisation.",
      "output_sha256": "bc05357b4e121de1435747f56266198db415e6ba0ebfdc372d6cb31bc390ddda",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 68,
      "source_human_sha256": "bc05357b4e121de1435747f56266198db415e6ba0ebfdc372d6cb31bc390ddda",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 69,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "Historically, torture has thrived alongside the most sophisticated cultures, reaching its peak in artistic expressions during the late Roman Empire, the ornate sixteenth century, the centralized French monarchy before the Revolution, and continues to exist in refined forms within certain modern societies.",
      "output_sha256": "b3bc78d0531d6f4c27415c9ac212a9f1a2c6fb2c8e1a18a6a22f6ca14c87f33b",
      "alignment_unit_index": 57,
      "alignment_score": 0.422767,
      "human_sentence_indices": [
        69,
        70
      ],
      "human_sha256": [
        "b89d226b9c719bfaf246663d7985b258c3ed3f6c93935c5ee9e6b1bfd9ea2a05",
        "968a6b12c0da5e5c572be3f0366056918b0a067d70828894d8faa835a3df4d59"
      ],
      "source_ai_sentence_index": 54,
      "source_ai_sha256": "b3bc78d0531d6f4c27415c9ac212a9f1a2c6fb2c8e1a18a6a22f6ca14c87f33b",
      "ai_unit_sentence_indices": [
        54
      ]
    },
    {
      "sentence_index": 70,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "This is a sobering realization we must confront.",
      "output_sha256": "30d660fb56d3946c4ea99cd1cadf9a2c120d4033c4ec823cc3eadc922950c87e",
      "alignment_unit_index": 58,
      "alignment_score": 0.418262,
      "human_sentence_indices": [
        71
      ],
      "human_sha256": [
        "16eb1ff1f07835cd0363df6d554b5335ff8e0d0110165b0c6f0126fdd7e8fe6a"
      ],
      "source_ai_sentence_index": 55,
      "source_ai_sha256": "30d660fb56d3946c4ea99cd1cadf9a2c120d4033c4ec823cc3eadc922950c87e",
      "ai_unit_sentence_indices": [
        55
      ]
    },
    {
      "sentence_index": 71,
      "paragraph_index": 11,
      "origin": "human",
      "text": "In so far as we grow instructed and refined we are not (in any sense whatever) naturally moving away from torture.",
      "output_sha256": "ab4c22ee37b76c6d9951884ca070a80f8d8b0c05994546161322608254fa4b98",
      "alignment_unit_index": 59,
      "alignment_score": null,
      "source_human_sentence_index": 72,
      "source_human_sha256": "ab4c22ee37b76c6d9951884ca070a80f8d8b0c05994546161322608254fa4b98",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 72,
      "paragraph_index": 11,
      "origin": "human",
      "text": "We may be moving towards torture.",
      "output_sha256": "bb15a5900690f742e338e8d1c6bcca629cb99109ee506b5d57f7c72b7dcee18a",
      "alignment_unit_index": 60,
      "alignment_score": null,
      "source_human_sentence_index": 73,
      "source_human_sha256": "bb15a5900690f742e338e8d1c6bcca629cb99109ee506b5d57f7c72b7dcee18a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 73,
      "paragraph_index": 11,
      "origin": "ai",
      "text": "It is crucial to be aware of our direction if we are to evade the immense hidden cruelty that has accompanied every civilization throughout history.",
      "output_sha256": "c97f5573ae1c949f5ef8f6ce10202d744eba2b28214b37797a4085fe00ac76a0",
      "alignment_unit_index": 61,
      "alignment_score": 0.356464,
      "human_sentence_indices": [
        74
      ],
      "human_sha256": [
        "2884705c2a3d1a6fc5320854d549e782bbcf4d9ba4c287ba18230cfad233ad30"
      ],
      "source_ai_sentence_index": 58,
      "source_ai_sha256": "c97f5573ae1c949f5ef8f6ce10202d744eba2b28214b37797a4085fe00ac76a0",
      "ai_unit_sentence_indices": [
        58
      ]
    },
    {
      "sentence_index": 74,
      "paragraph_index": 12,
      "origin": "human",
      "text": "The train moves more swiftly through the sunny English fields.",
      "output_sha256": "b823316f7852148ed5a86d5dc691bb5d32e9d0be8d508dbfc4e9d1a05cf26ff8",
      "alignment_unit_index": 62,
      "alignment_score": null,
      "source_human_sentence_index": 75,
      "source_human_sha256": "b823316f7852148ed5a86d5dc691bb5d32e9d0be8d508dbfc4e9d1a05cf26ff8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 75,
      "paragraph_index": 12,
      "origin": "human",
      "text": "They have taken the prisoners away, and I do not know what they have done with them.",
      "output_sha256": "e76193ed6674ee558f636e9c83937582f01711892688efca8932590074729249",
      "alignment_unit_index": 63,
      "alignment_score": null,
      "source_human_sentence_index": 76,
      "source_human_sha256": "e76193ed6674ee558f636e9c83937582f01711892688efca8932590074729249",
      "ai_unit_sentence_indices": []
    }
  ]
}
