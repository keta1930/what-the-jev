  "ai_article_sha256": "d75a58ccff2e346016ff30a9b069b7a5b97801bf662360ec883f2e3470d2928a",
  "mixed_article_sha256": "01768b3fdce7a8e4ff4a6c19aefe113f54cd7cac72bf8f296b572afbaeee5939",
  "human_source_sentence_count": 45,
  "ai_source_sentence_count": 45,
  "alignment_unit_count": 42,
  "selected_alignment_unit_count": 14,
