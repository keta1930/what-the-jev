      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 68,
      "paragraph_index": 21,
      "origin": "ai",
      "text": "Sir Thomas More's methods of courting were perhaps the most unusual on record.",
      "output_sha256": "705f4ada9419b382b01e78b82322311c5ca3a7d15aa95c4444abeec3a432462d",
      "alignment_unit_index": 61,
