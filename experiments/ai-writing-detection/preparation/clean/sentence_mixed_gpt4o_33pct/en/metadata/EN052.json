      ],
      "source_ai_sentence_index": 64,
      "source_ai_sha256": "b0b55a93d240bb915434034be4887ef41fa28cf8dca6b54a701b8b9c6fb345f8",
      "ai_unit_sentence_indices": [
        64
      ]
    },
    {
      "sentence_index": 70,
      "paragraph_index": 22,
      "origin": "human",
      "text": "\"And all beit his mynde most served him to the seconde daughter, for that he thoughte her the fayrest and best favoured, yet when he considered that it woulde be bothe great griefe and some shame alsoe to the eldest to see her yonger sister in mariage preferred before her, he then of a certeyn pittye framed his fancye towardes her, and soon after maryed her.\"",
      "output_sha256": "309391e363483f00e179852b32c3c649bcb810396f1b48e17ad108c85c864c36",
      "alignment_unit_index": 63,
      "alignment_score": null,
      "source_human_sentence_index": 71,
      "source_human_sha256": "309391e363483f00e179852b32c3c649bcb810396f1b48e17ad108c85c864c36",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 71,
      "paragraph_index": 23,
      "origin": "ai",
      "text": "This illustrates a calculated form of love, yet it resulted in one of the most beautiful family lives imaginable, centered around this remarkable figure of English heritage.",
      "output_sha256": "9b0fcc019669559be293a2f0eb7cdbf5c26a79067e559935c5fa2263ae9e112e",
      "alignment_unit_index": 64,
