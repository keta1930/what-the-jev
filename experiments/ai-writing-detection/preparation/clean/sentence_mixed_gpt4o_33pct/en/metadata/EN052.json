      "ai_unit_sentence_indices": [
        63
      ]
    },
    {
      "sentence_index": 69,
      "paragraph_index": 21,
      "origin": "ai",
      "text": "He had developed a preference for the second of three sisters and was poised to marry her when he experienced a moment of realization—But let me share the words of Roper, his son-in-law, who documented the event:",
      "output_sha256": "b0b55a93d240bb915434034be4887ef41fa28cf8dca6b54a701b8b9c6fb345f8",
      "alignment_unit_index": 62,
      "alignment_score": 0.596421,
      "human_sentence_indices": [
        70
