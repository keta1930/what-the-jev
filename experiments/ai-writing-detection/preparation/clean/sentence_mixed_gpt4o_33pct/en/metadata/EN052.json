    {
      "sentence_index": 67,
      "paragraph_index": 21,
      "origin": "human",
      "text": "A more hum-drum way of falling in love seems better fitted to earthly conditions.",
      "output_sha256": "f641c0c7387dcee54d2a9406b3a0df208a954de7caacea9ca98e58cc2b5c4f71",
      "alignment_unit_index": 60,
