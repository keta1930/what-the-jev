  "mixed_article_sha256": "5584ae12fe1f138ebc2713e1b7b434cfaa20b56cc978595a645c886d34741d60",
  "human_source_sentence_count": 83,
  "ai_source_sentence_count": 77,
  "alignment_unit_count": 76,
  "selected_alignment_unit_count": 26,
  "mixed_sentence_count": 81,
  "selected_ai_sentence_count": 27,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.310926,
