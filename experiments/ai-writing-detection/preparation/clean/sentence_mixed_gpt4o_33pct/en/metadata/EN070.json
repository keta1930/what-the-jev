  "mixed_article_sha256": "ff3afcc8f0ee7b50fedfb84e29ffb5aea5f06d265dad73c1a9c1bd4bdd15b21c",
  "human_source_sentence_count": 68,
  "ai_source_sentence_count": 58,
  "alignment_unit_count": 57,
  "selected_alignment_unit_count": 21,
  "mixed_sentence_count": 69,
  "selected_ai_sentence_count": 23,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.245151,
  "selected_alignment_score_median": 0.453135,
  "selected_alignment_score_max": 0.631136,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "On my final morning along the Flemish coastline, with the knowledge that I would soon be crossing over to England, my attention was caught by a piece of Gothic carving, a common sight in Flanders.",
      "output_sha256": "7fa536b0ac4f1769c74eae3cba9f0849eb306ff279d813351f4474ca8a5296f9",
      "alignment_unit_index": 1,
      "alignment_score": 0.457939,
      "human_sentence_indices": [
        1
      ],
      "human_sha256": [
        "aeae1da999744e19244a8a31341bc20ecbd716665bb371a7fe3d8ca66275b2be"
      ],
      "source_ai_sentence_index": 1,
      "source_ai_sha256": "7fa536b0ac4f1769c74eae3cba9f0849eb306ff279d813351f4474ca8a5296f9",
      "ai_unit_sentence_indices": [
        1
      ]
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "I do not know whether the thing is old, though it was certainly knocked about and indecipherable, but at least it was certainly in the style and tradition of the early Middle Ages.",
      "output_sha256": "329571250e3eeb2d01cf614a9bbf22f5421e48af3a716ca0a403808c2e1578fc",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "329571250e3eeb2d01cf614a9bbf22f5421e48af3a716ca0a403808c2e1578fc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It seemed to represent men bending themselves (not to say twisting themselves) to certain primary employments.",
      "output_sha256": "d2a5148b5f91416f7fa5b828ffecec7a5daef8dd16fb9b6cbef81e577c2210eb",
      "alignment_unit_index": 3,
      "alignment_score": null,
      "source_human_sentence_index": 3,
      "source_human_sha256": "d2a5148b5f91416f7fa5b828ffecec7a5daef8dd16fb9b6cbef81e577c2210eb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Some seemed to be sailors tugging at ropes; others, I think, were reaping; others were energetically pouring something into something else.",
      "output_sha256": "d9fc2e33bc3b8261af8b23acc7cfc665e43342f7c4554428f63ae083e89eb669",
      "alignment_unit_index": 3,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "d9fc2e33bc3b8261af8b23acc7cfc665e43342f7c4554428f63ae083e89eb669",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "This portrayal is emblematic of the early thirteenth century, a period renowned for its vigorous spirit.",
      "output_sha256": "64d0fd31f8ac0459790a9cdecb1fb1a09af69aa9f50641c64dcb7c46d2b4ca5d",
      "alignment_unit_index": 4,
      "alignment_score": 0.436904,
      "human_sentence_indices": [
        5
      ],
      "human_sha256": [
        "7ef160ec4c26711e36a7bbdb07b324cca2743ac131499e1520f17549bbad2a9e"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "64d0fd31f8ac0459790a9cdecb1fb1a09af69aa9f50641c64dcb7c46d2b4ca5d",
      "ai_unit_sentence_indices": [
        4
      ]
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "In contrast, the ancient Greeks tended to immortalize their gods and heroes in moments of stillness.",
      "output_sha256": "6f62f0968e79558c14bfc2a6569cc63fc9bcdfd1fdb13ac3c50a1c555a0a7aa5",
      "alignment_unit_index": 5,
      "alignment_score": 0.455952,
      "human_sentence_indices": [
        6
      ],
      "human_sha256": [
        "0cf2a791dc2cad1cb76a60243d8c27c38fe000215d21d2aae40fb8daa64ad7a8"
      ],
      "source_ai_sentence_index": 5,
      "source_ai_sha256": "6f62f0968e79558c14bfc2a6569cc63fc9bcdfd1fdb13ac3c50a1c555a0a7aa5",
      "ai_unit_sentence_indices": [
        5
      ]
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "Their art, while splendid and philosophical in its poise, often conveyed a sense of detachment, as if they were masters presiding over a multitude of laborers.",
      "output_sha256": "d0699a4ed367fe5c8894ad2ba822cfaabc44f18ed34230c67af6a20d352efa5f",
      "alignment_unit_index": 6,
      "alignment_score": 0.245151,
      "human_sentence_indices": [
        7
      ],
      "human_sha256": [
        "34d0541e9d9a5e8e5a2d6b64de1041829584e206fbcb2d2f1a9ca2f75d14f7c8"
      ],
      "source_ai_sentence_index": 6,
      "source_ai_sha256": "d0699a4ed367fe5c8894ad2ba822cfaabc44f18ed34230c67af6a20d352efa5f",
      "ai_unit_sentence_indices": [
        6
      ]
    },
    {
      "sentence_index": 8,
      "paragraph_index": 1,
      "origin": "human",
      "text": "But if there was one thing the early mediaevals liked it was representing people doing something—hunting or hawking, or rowing boats, or treading grapes, or making shoes, or cooking something in a pot.",
      "output_sha256": "c32636a9f4788af09ec1c38a66e0a636b6acceacda04c13715ff04324a61506a",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "c32636a9f4788af09ec1c38a66e0a636b6acceacda04c13715ff04324a61506a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 1,
      "origin": "human",
      "text": "“Quicquid agunt homines, votum, timor, ira voluptas.”",
      "output_sha256": "a02ec4d4d0d5e95461bf1741a716811effdd6b1b16903da188b8e449f16ec48a",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "a02ec4d4d0d5e95461bf1741a716811effdd6b1b16903da188b8e449f16ec48a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 1,
      "origin": "human",
      "text": "(I quote from memory.)",
      "output_sha256": "87ce42bc1ae80f9e0ed45c596bf47a1449d0d9f6e3eac5c7eab0bbe2b46c4a0b",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 10,
      "source_human_sha256": "87ce42bc1ae80f9e0ed45c596bf47a1449d0d9f6e3eac5c7eab0bbe2b46c4a0b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 1,
      "origin": "human",
      "text": "The Middle Ages is full of that spirit in all its monuments and manuscripts.",
      "output_sha256": "cc8bc8fd2ff78991ba250847b6cfd3e3a6f6bcb3883ccfc038377cc4cafa25bd",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "cc8bc8fd2ff78991ba250847b6cfd3e3a6f6bcb3883ccfc038377cc4cafa25bd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 12,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Chaucer retains it in his jolly insistence on everybody’s type of trade and toil.",
      "output_sha256": "1277ad91a785d42b2dd6ad7c1d2d91417f426f2e861b83f04e1e562cfcfa9c17",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "1277ad91a785d42b2dd6ad7c1d2d91417f426f2e861b83f04e1e562cfcfa9c17",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "The Middle Ages, a time of burgeoning social order, was marked by strong religious convictions that had yet to become burdensome.",
      "output_sha256": "5cc61a222da163c626b5f395ff3b095571a70fde7aad950948f01454adc39c33",
      "alignment_unit_index": 10,
      "alignment_score": 0.344026,
      "human_sentence_indices": [
        13
      ],
      "human_sha256": [
        "5a45f17fce4c2019745f7a4f4fe4ae9731ad044922423ec3fe830b14e7bf938b"
      ],
      "source_ai_sentence_index": 9,
      "source_ai_sha256": "5cc61a222da163c626b5f395ff3b095571a70fde7aad950948f01454adc39c33",
      "ai_unit_sentence_indices": [
        9
      ]
    },
    {
      "sentence_index": 14,
      "paragraph_index": 1,
      "origin": "human",
      "text": "For this reason the whole effect of Greek and Gothic carving is different.",
      "output_sha256": "4d61fec953ff3a49b759bcaa71cd897d98e364bac45fc7b4bcda76572f7365fe",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "4d61fec953ff3a49b759bcaa71cd897d98e364bac45fc7b4bcda76572f7365fe",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 1,
      "origin": "human",
      "text": "The figures in the Elgin marbles, though often reining their steeds for an instant in the air, seem frozen for ever at that perfect instant.",
      "output_sha256": "4715a9a6739a4d5a46118fdbce1069895bc2ee34def57ac73d90096035f3c105",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "4715a9a6739a4d5a46118fdbce1069895bc2ee34def57ac73d90096035f3c105",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 1,
      "origin": "human",
      "text": "But a mass of mediaeval carving seems actually a sort of bustle or hubbub in stone.",
      "output_sha256": "60d432e54b3e66ddd4e2de536cee1cef61ce5bb0be62c41177cf73db3f8cca82",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "60d432e54b3e66ddd4e2de536cee1cef61ce5bb0be62c41177cf73db3f8cca82",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Sometimes one cannot help feeling that the groups actually move and mix, and the whole front of a great cathedral has the hum of a huge hive.",
      "output_sha256": "e428e85638ab7fcc9dfcca3046b788ad7a760ab7515be5908def11f0387798e9",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "e428e85638ab7fcc9dfcca3046b788ad7a760ab7515be5908def11f0387798e9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 2,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "human",
      "text": "But about these particular figures there was a peculiarity of which I could not be sure.",
      "output_sha256": "54e866b2f5a197dd948d4d05d1910b70b03fe6227f7794e08ef8a5651922acfe",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "54e866b2f5a197dd948d4d05d1910b70b03fe6227f7794e08ef8a5651922acfe",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Those that had heads bore oddly shaped features, and it seemed to me that their mouths were open.",
      "output_sha256": "c1997d2e7acd356170112a2be76eabdfd154bc9fcdab27c48fbb7abca2c5ed26",
      "alignment_unit_index": 14,
      "alignment_score": 0.631136,
      "human_sentence_indices": [
        20
      ],
      "human_sha256": [
        "037e8fc646562331f182bbe0107c94f97f129fca93ea3e2c1e92d83afb74c9d1"
      ],
      "source_ai_sentence_index": 12,
      "source_ai_sha256": "c1997d2e7acd356170112a2be76eabdfd154bc9fcdab27c48fbb7abca2c5ed26",
      "ai_unit_sentence_indices": [
        12
      ]
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "I couldn’t tell if this was a deliberate artistic choice or merely an artifact of nascent creativity.",
      "output_sha256": "beca0fd7e8bf2840d202253ef0c7d1b93390f5db6e6f3262a19b66543283dd91",
      "alignment_unit_index": 15,
      "alignment_score": 0.453135,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "ee80e3c7585ea1b0c4bd25997959d180b88695f6ba0c291398d22d9bd0663bf6"
      ],
      "source_ai_sentence_index": 13,
      "source_ai_sha256": "beca0fd7e8bf2840d202253ef0c7d1b93390f5db6e6f3262a19b66543283dd91",
      "ai_unit_sentence_indices": [
        13,
        14
      ]
    },
    {
      "sentence_index": 22,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "As I pondered this, I recalled how singing was often intertwined with many of the tasks depicted—there are songs for reapers and for sailors hauling ropes.",
      "output_sha256": "77de3d6ce3f69b36e4566906d770871db71c5e3f31436b01d1301f251b23fa1e",
      "alignment_unit_index": 15,
      "alignment_score": 0.453135,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "ee80e3c7585ea1b0c4bd25997959d180b88695f6ba0c291398d22d9bd0663bf6"
      ],
      "source_ai_sentence_index": 14,
      "source_ai_sha256": "77de3d6ce3f69b36e4566906d770871db71c5e3f31436b01d1301f251b23fa1e",
      "ai_unit_sentence_indices": [
        13,
        14
      ]
    },
    {
      "sentence_index": 23,
      "paragraph_index": 3,
      "origin": "human",
      "text": "I was still thinking about this small problem when I walked along the pier at Ostend; and I heard some sailors uttering a measured shout as they laboured, and I remembered that sailors still sing in chorus while they work, and even sing different songs according to what part of their work they are doing.",
      "output_sha256": "296d0528600198fcd5dfbb23bb2df2ddcaf689b069553a9814ab9633977c24af",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "296d0528600198fcd5dfbb23bb2df2ddcaf689b069553a9814ab9633977c24af",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 3,
      "origin": "human",
      "text": "And a little while afterwards, when my sea journey was over, the sight of men working in the English fields reminded me again that there are still songs for harvest and for many agricultural routines.",
      "output_sha256": "ce3601353670d83a1c4c5572d49ee0794650d33a3775043c532d4e20ee6c48f8",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "ce3601353670d83a1c4c5572d49ee0794650d33a3775043c532d4e20ee6c48f8",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "It struck me as curious that, despite this rich history, no modern trades seem to possess a ritualistic form of poetry.",
      "output_sha256": "d49578ff1b71c8e5d22f0e8e083482e2a5fe5c64dd07839470de2bea8e65b6b5",
      "alignment_unit_index": 18,
      "alignment_score": 0.312154,
      "human_sentence_indices": [
        24
      ],
      "human_sha256": [
        "3d952977ac24b13036f7342b290ea5b8cfe3e86e36fc68adf4a422a0fe00b245"
      ],
      "source_ai_sentence_index": 18,
      "source_ai_sha256": "d49578ff1b71c8e5d22f0e8e083482e2a5fe5c64dd07839470de2bea8e65b6b5",
      "ai_unit_sentence_indices": [
        18
      ]
    },
    {
      "sentence_index": 26,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "How did it come to be that people sang simple verses while performing specific tasks like pulling ropes or gathering fruit?",
      "output_sha256": "0c76a6f6c5eeef1bed5aaeed9ab3c7296fddfb8b340840640acc9353a11be635",
      "alignment_unit_index": 19,
      "alignment_score": 0.474151,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "e247e4f29b3e6de4ec805b231260d7a30364a9b25a6f6b1e9a3201d3ae0cf1aa"
      ],
      "source_ai_sentence_index": 19,
      "source_ai_sha256": "0c76a6f6c5eeef1bed5aaeed9ab3c7296fddfb8b340840640acc9353a11be635",
      "ai_unit_sentence_indices": [
        19,
        20
      ]
    },
    {
      "sentence_index": 27,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Why is it that no one engages in similar practices while creating modern products?",
      "output_sha256": "ca7c37adc2b6622ae01af567d0294529252724d68f97a892de18508bff0f7025",
      "alignment_unit_index": 19,
      "alignment_score": 0.474151,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "e247e4f29b3e6de4ec805b231260d7a30364a9b25a6f6b1e9a3201d3ae0cf1aa"
      ],
      "source_ai_sentence_index": 20,
      "source_ai_sha256": "ca7c37adc2b6622ae01af567d0294529252724d68f97a892de18508bff0f7025",
      "ai_unit_sentence_indices": [
        19,
        20
      ]
    },
    {
      "sentence_index": 28,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Why is a modern newspaper never printed by people singing in chorus?",
      "output_sha256": "7bbe900db715b9162145ad3c7258c855fefc902fbf287a37d8138d979ee3ea16",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "7bbe900db715b9162145ad3c7258c855fefc902fbf287a37d8138d979ee3ea16",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Why do shopmen seldom, if ever, sing?",
      "output_sha256": "6f4ae0d6bf1ae3cb40584767d74f28bb7a17e72224a37d065144f8eef1741fdd",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "6f4ae0d6bf1ae3cb40584767d74f28bb7a17e72224a37d065144f8eef1741fdd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 4,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 5,
      "origin": "human",
      "text": "If reapers sing while reaping, why should not auditors sing while auditing and bankers while banking?",
      "output_sha256": "bc5550e7a91f54899a4e7a1fed3a53f60eef5bb5d3411559e35d8cb51aaf8ca9",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "bc5550e7a91f54899a4e7a1fed3a53f60eef5bb5d3411559e35d8cb51aaf8ca9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "If there are songs dedicated to the various duties aboard a ship, then surely there should be songs for the myriad tasks performed in a bank.",
      "output_sha256": "f03af30bb8e9dfbab3c11e47adeeaac0d05764f440f293a890a61c0d557d43ce",
      "alignment_unit_index": 22,
      "alignment_score": 0.4072,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "2adfed09168f5d0b6b26c8aa8f616d5a9f5dd1dcae5b231493ab4008cd593052"
      ],
      "source_ai_sentence_index": 23,
      "source_ai_sha256": "f03af30bb8e9dfbab3c11e47adeeaac0d05764f440f293a890a61c0d557d43ce",
      "ai_unit_sentence_indices": [
        23
      ]
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "As the train sped from Dover through the lush Kentish gardens, I found myself attempting to compose a few verses that might suit the work of bank clerks.",
      "output_sha256": "5133e6bb36b2faf87769c3c5967f8125b7c1afe5c2cd18e01586ed258874c72d",
      "alignment_unit_index": 23,
      "alignment_score": 0.510776,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "f35f040f447af9b81432c566530fb193400084dc2fb14ae252d7a1ecbd7daf72"
      ],
      "source_ai_sentence_index": 24,
      "source_ai_sha256": "5133e6bb36b2faf87769c3c5967f8125b7c1afe5c2cd18e01586ed258874c72d",
      "ai_unit_sentence_indices": [
        24
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Thus, the work of bank clerks when casting up columns might begin with a thundering chorus in praise of Simple Addition.",
      "output_sha256": "93986e5072da9ebe7a59ba8f2ea658162e16ddbcc1fda43cc26c50fbc7e2b6f2",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 32,
      "source_human_sha256": "93986e5072da9ebe7a59ba8f2ea658162e16ddbcc1fda43cc26c50fbc7e2b6f2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 35,
      "paragraph_index": 6,
      "origin": "human",
      "text": "“Up my lads and lift the ledgers, sleep and ease are o’er.",
      "output_sha256": "720befd61c6da69c1f3ec27140e11548ed9e62ecec1fa6d8afe0670b26b77df2",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "720befd61c6da69c1f3ec27140e11548ed9e62ecec1fa6d8afe0670b26b77df2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Hear the Stars of Morning shouting: ‘Two and Two are four.’",
      "output_sha256": "25bc9c8d8d50c1fc375fc02b3982c7d55840b7fcc51c9c7d5e545624059193cc",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "25bc9c8d8d50c1fc375fc02b3982c7d55840b7fcc51c9c7d5e545624059193cc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Though the creeds and realms are reeling, though the sophists roar, Though we weep and pawn our watches, Two and Two are Four.”",
      "output_sha256": "bab3a8266714ed6cd9c4cbeedb3c29a04b0e3a75bc011dd9c9863af5fe85ed02",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 35,
      "source_human_sha256": "bab3a8266714ed6cd9c4cbeedb3c29a04b0e3a75bc011dd9c9863af5fe85ed02",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 7,
      "origin": "human",
      "text": "“There’s a run upon the Bank—Stand away!",
      "output_sha256": "02a48a7c89728abea23b1357515629187d15336e7a55e000f2fe5bc33c53ad89",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "02a48a7c89728abea23b1357515629187d15336e7a55e000f2fe5bc33c53ad89",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 7,
      "origin": "human",
      "text": "For the Manager’s a crank and the Secretary drank, and the",
      "output_sha256": "d4d98a481f5343a797a70c0964facb790539b94f16ab5c3381e24265ead93452",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "d4d98a481f5343a797a70c0964facb790539b94f16ab5c3381e24265ead93452",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Upper Tooting Bank Turns to bay!",
      "output_sha256": "a7f2cb2b8825e1865de25288795f55fda8b2df65a5731f233927a25ec174622f",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "a7f2cb2b8825e1865de25288795f55fda8b2df65a5731f233927a25ec174622f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Stand close: there is a run On the Bank.",
      "output_sha256": "bcd0d6cb854d3b0c66b0caf181b10af6ef105e09c02db91ca3f64f0b7be2a927",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "bcd0d6cb854d3b0c66b0caf181b10af6ef105e09c02db91ca3f64f0b7be2a927",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Of our ship, our royal one, let the ringing legend run, That she fired with every gun Ere she sank.”",
      "output_sha256": "bf7dc34ceac16caf70ec5060d6eab3efa3b0ee16aba9cff4efb10bd2f8055fb0",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "bf7dc34ceac16caf70ec5060d6eab3efa3b0ee16aba9cff4efb10bd2f8055fb0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 9,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 10,
      "origin": "human",
      "text": "And as I came into the cloud of London I met a friend of mine who actually is in a bank, and submitted these suggestions in rhyme to him for use among his colleagues.",
      "output_sha256": "c47e040d997ef510fc2706fa12dc6dc173c5b195773214c2d94329c96a0dc19e",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "c47e040d997ef510fc2706fa12dc6dc173c5b195773214c2d94329c96a0dc19e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "However, he was not particularly optimistic about their reception.",
      "output_sha256": "13ab561f814c4ee45b676cdff2b83385e8aa64344c9024aa59516db052d41152",
      "alignment_unit_index": 33,
      "alignment_score": 0.4375,
      "human_sentence_indices": [
        43
      ],
      "human_sha256": [
        "68025e93df5a21e20126998e6b2996c9cd7eb66928760136edcd6d42474966f8"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "13ab561f814c4ee45b676cdff2b83385e8aa64344c9024aa59516db052d41152",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 46,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "He clarified that his reluctance didn't stem from any judgment about the quality of the verses or their polish.",
      "output_sha256": "74782b6565afc4ad86481d123dc581301f6fbecda41f69e5fde45c3a21fe0867",
      "alignment_unit_index": 34,
      "alignment_score": 0.411538,
      "human_sentence_indices": [
        44
      ],
      "human_sha256": [
        "0e514da58a7b50be1bc535d7220c9d1892f5ce6bcdaeb60cd90be9b2b66fce09"
      ],
      "source_ai_sentence_index": 35,
      "source_ai_sha256": "74782b6565afc4ad86481d123dc581301f6fbecda41f69e5fde45c3a21fe0867",
      "ai_unit_sentence_indices": [
        35
      ]
    },
    {
      "sentence_index": 47,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "Rather, he sensed an indefinable atmosphere within our society that makes it inherently difficult to sing in such environments.",
      "output_sha256": "a5d3aaefb7e5c36e0f3fcc11dbf2586b30ecc28704388f24322a931e52e41cf7",
      "alignment_unit_index": 35,
      "alignment_score": 0.485311,
      "human_sentence_indices": [
        45
      ],
      "human_sha256": [
        "b5a9a013dfa02a6af66d9223b71a18d0fbc2ad47fa6091a8e540dcd6a1ab12f9"
      ],
      "source_ai_sentence_index": 36,
      "source_ai_sha256": "a5d3aaefb7e5c36e0f3fcc11dbf2586b30ecc28704388f24322a931e52e41cf7",
      "ai_unit_sentence_indices": [
        36
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 10,
      "origin": "human",
      "text": "And I think he must be right; though the matter is very mysterious.",
      "output_sha256": "67c4f1574aae682fdff3bf1b26156fa21207b931b91f8436406e5e5949495f35",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "67c4f1574aae682fdff3bf1b26156fa21207b931b91f8436406e5e5949495f35",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "It also made me reflect on the views of Socialists, who often attribute societal distress not to moral issues but to the chaos inherent in private enterprise.",
      "output_sha256": "c946b204400947b123118ef0c3f4b48bc194c65a30a8e094a374df09a23224a0",
      "alignment_unit_index": 37,
      "alignment_score": 0.419048,
      "human_sentence_indices": [
        47,
        48
      ],
      "human_sha256": [
        "ed9a65ad1d0885fcbd48d54eae42a41aed307d0aaf4ef348a8a31bffac571b1c",
        "12edcca57234c97e639e6a74ae43898471efd14c0c2aac25c76885d4e21bcffa"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "c946b204400947b123118ef0c3f4b48bc194c65a30a8e094a374df09a23224a0",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 50,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "Given that banks are private entities, I had expected the post office, which operates on a collectivist model, to embrace the concept of choral singing.",
      "output_sha256": "95571ae374c463e5968e7ac5e1d2d94c4b7e926cc7b73ea7f3e168cff7175302",
      "alignment_unit_index": 38,
      "alignment_score": 0.386939,
      "human_sentence_indices": [
        49
      ],
      "human_sha256": [
        "fa3f41bd7495641715258bad2f5dbcf65a748f1112d51eacf0c20d9bfbf5b8c4"
      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "95571ae374c463e5968e7ac5e1d2d94c4b7e926cc7b73ea7f3e168cff7175302",
      "ai_unit_sentence_indices": [
        39
      ]
    },
    {
      "sentence_index": 51,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "To my surprise, when I encouraged a lady at my local post office to sing, she met the idea with a far colder reception than the bank clerk had.",
      "output_sha256": "4df77043a5f1d9f9db09d14bac16d664ba9085d7eda232685fd28790e773a5f4",
      "alignment_unit_index": 39,
      "alignment_score": 0.588793,
      "human_sentence_indices": [
        50
      ],
      "human_sha256": [
        "089aa381d46f4a108357c7ba55095d26345de1060ac0662ca69dd9eec2bc8f88"
      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "4df77043a5f1d9f9db09d14bac16d664ba9085d7eda232685fd28790e773a5f4",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 52,
      "paragraph_index": 10,
      "origin": "human",
      "text": "She seemed indeed, to be in a considerably greater state of depression than he.",
      "output_sha256": "75047615c103a7c4ef0f85052a48f00690ce7bcf2d88dd2ef8280a4b8123fd64",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 51,
      "source_human_sha256": "75047615c103a7c4ef0f85052a48f00690ce7bcf2d88dd2ef8280a4b8123fd64",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "Some might argue that my verses were to blame for her demeanor, yet it is only fair to mention that the sample verse from the hypothetical Post-Office Hymn read:",
      "output_sha256": "28fbb8bd89dc1b8ed7ff63a6d31856dbcd6efbd08a12fdb14f6400c08cbfbde6",
      "alignment_unit_index": 41,
      "alignment_score": 0.495955,
      "human_sentence_indices": [
        52
      ],
      "human_sha256": [
        "581a8b748eef21160732899a38a57a264aaea2b9d15394c7bc5875c340821ebc"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "28fbb8bd89dc1b8ed7ff63a6d31856dbcd6efbd08a12fdb14f6400c08cbfbde6",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 54,
      "paragraph_index": 11,
      "origin": "human",
      "text": "“O’er London our letters are shaken like snow, Our wires o’er the world like the thunderbolts go.",
      "output_sha256": "50058328ab1945579ee86f96183740b40ffed64d158d6bc1b905d00fc8d127d3",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "50058328ab1945579ee86f96183740b40ffed64d158d6bc1b905d00fc8d127d3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 11,
      "origin": "human",
      "text": "The news that may marry a maiden in Sark, Or kill an old lady in Finsbury Park.”",
      "output_sha256": "76dcdf3c22011e24c68b0bb56d597d1534554f787e784fbbe0d04475f4a3c4c1",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "76dcdf3c22011e24c68b0bb56d597d1534554f787e784fbbe0d04475f4a3c4c1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 12,
      "origin": "human",
      "text": "Chorus (with a swing of joy and energy):",
      "output_sha256": "8dd0f9c12d18cf027577000f0d015d5b48916aa7102047055578a86b6e695abb",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "8dd0f9c12d18cf027577000f0d015d5b48916aa7102047055578a86b6e695abb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 13,
      "origin": "human",
      "text": "“Or kill an old lady in Finsbury Park.”",
      "output_sha256": "c705d791d7ec3190bdf8b01d7dfd9ddb4d4c07ecf4429d9b64d4a44a7baf60de",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "c705d791d7ec3190bdf8b01d7dfd9ddb4d4c07ecf4429d9b64d4a44a7baf60de",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 14,
      "origin": "human",
      "text": "And the more I thought about the matter the more painfully certain it seemed that the most important and typical modern things could not be done with a chorus.",
      "output_sha256": "55e6abb3358b2d3b739aa3516463631e269ffdb9dd34d42147ffd14738ce1689",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "55e6abb3358b2d3b739aa3516463631e269ffdb9dd34d42147ffd14738ce1689",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 14,
      "origin": "human",
      "text": "One could not, for instance, be a great financier and sing; because the essence of being a great financier is that you keep quiet.",
      "output_sha256": "fe810a6d0a964ec88425ce50fbca30ee7c05a7a286c6461c8534168f3a78d4d1",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 58,
      "source_human_sha256": "fe810a6d0a964ec88425ce50fbca30ee7c05a7a286c6461c8534168f3a78d4d1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 14,
      "origin": "human",
      "text": "You could not even in many modern circles be a public man and sing; because in those circles the essence of being a public man is that you do nearly everything in private.",
      "output_sha256": "5e2a9840af32d9245d23a4ff42df8ed9ca1b4e3de2c8df237c978657525c9cb9",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "5e2a9840af32d9245d23a4ff42df8ed9ca1b4e3de2c8df237c978657525c9cb9",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "The notion of a chorus of money-lenders is almost laughable.",
      "output_sha256": "929089456a16cd84770dbf9aa2a28154c995dea526cf18938e4be88ff6371884",
      "alignment_unit_index": 49,
      "alignment_score": 0.426765,
      "human_sentence_indices": [
        60
      ],
      "human_sha256": [
        "b556534d387bedf08b9f2481197ed289f60a500530689bb40048b20d14084f50"
      ],
      "source_ai_sentence_index": 50,
      "source_ai_sha256": "929089456a16cd84770dbf9aa2a28154c995dea526cf18938e4be88ff6371884",
      "ai_unit_sentence_indices": [
        50
      ]
    },
    {
      "sentence_index": 62,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "The well-known story of the solicitors’ corps, who, upon hearing “Charge!” from their Colonel, collectively responded with “Six-and-eightpence,” illustrates this stark contrast.",
      "output_sha256": "6aaf377dbb8f210093acf561d88ef0cf29d410f2d64a15ea6215f7b5de14127f",
      "alignment_unit_index": 50,
      "alignment_score": 0.46442,
      "human_sentence_indices": [
        61
      ],
      "human_sha256": [
        "9e65debdcfd46bb784ded45d530a026d516ff001b05891b1c21939536d36d225"
      ],
      "source_ai_sentence_index": 51,
      "source_ai_sha256": "6aaf377dbb8f210093acf561d88ef0cf29d410f2d64a15ea6215f7b5de14127f",
      "ai_unit_sentence_indices": [
        51
      ]
    },
    {
      "sentence_index": 63,
      "paragraph_index": 14,
      "origin": "ai",
      "text": "In military settings, men can sing while charging, yet the same cannot be said for legal proceedings.",
      "output_sha256": "b3dea7a175c7836a04d4492b1cb131bae469ebeea9c4499a86ad57c31cc33f69",
      "alignment_unit_index": 51,
      "alignment_score": 0.478899,
      "human_sentence_indices": [
        62
      ],
      "human_sha256": [
        "53c48c02909d20fce8bf44a461ff125c9470ad5577e23a4b816183b595f22c85"
      ],
      "source_ai_sentence_index": 52,
      "source_ai_sha256": "b3dea7a175c7836a04d4492b1cb131bae469ebeea9c4499a86ad57c31cc33f69",
      "ai_unit_sentence_indices": [
        52
      ]
    },
    {
      "sentence_index": 64,
      "paragraph_index": 14,
      "origin": "human",
      "text": "And at the end of my reflections I had really got no further than the sub-conscious feeling of my friend the bank-clerk—that there is something spiritually suffocating about our life; not about our laws merely, but about our life.",
      "output_sha256": "df4fbdcb6595234070d13b0a0dca19a311ae35d0cf173e3037a3f144cb0d8a63",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 63,
      "source_human_sha256": "df4fbdcb6595234070d13b0a0dca19a311ae35d0cf173e3037a3f144cb0d8a63",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 65,
      "paragraph_index": 14,
      "origin": "human",
      "text": "Bank-clerks are without songs, not because they are poor, but because they are sad.",
      "output_sha256": "acf86f4613a07c03831c948ec7286409a142c672a2d9c1369d7f2c6cc04edb9f",
      "alignment_unit_index": 53,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "acf86f4613a07c03831c948ec7286409a142c672a2d9c1369d7f2c6cc04edb9f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 66,
      "paragraph_index": 14,
      "origin": "human",
      "text": "Sailors are much poorer.",
      "output_sha256": "46cce44f7bd14375e78bda1bb0b3b7a24eaba21dabc9479bb406cda09a854fab",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 65,
      "source_human_sha256": "46cce44f7bd14375e78bda1bb0b3b7a24eaba21dabc9479bb406cda09a854fab",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 67,
      "paragraph_index": 14,
      "origin": "human",
      "text": "As I passed homewards I passed a little tin building of some religious sort, which was shaken with shouting as a trumpet is torn with its own tongue.",
      "output_sha256": "cc77b9d6dc37b151c7402e694a0ad5f28df67a3889db9056154783d05fd4d7bc",
      "alignment_unit_index": 55,
      "alignment_score": null,
      "source_human_sentence_index": 66,
      "source_human_sha256": "cc77b9d6dc37b151c7402e694a0ad5f28df67a3889db9056154783d05fd4d7bc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 68,
      "paragraph_index": 14,
      "origin": "human",
      "text": "THEY were singing anyhow; and I had for an instant a fancy I had often had before: that with us the super-human is the only place where you can find the human.",
      "output_sha256": "c88986a8fd12529cca953e82fcfa7c4682bbd11daceb2833a1b7fc8108c49606",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 67,
      "source_human_sha256": "c88986a8fd12529cca953e82fcfa7c4682bbd11daceb2833a1b7fc8108c49606",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 69,
      "paragraph_index": 14,
      "origin": "human",
      "text": "Human nature is hunted and has fled into sanctuary.",
      "output_sha256": "ada61efbb061a0054d078301b87c0db0e01beaf28f16b66014b867611f1ed566",
      "alignment_unit_index": 57,
      "alignment_score": null,
      "source_human_sentence_index": 68,
      "source_human_sha256": "ada61efbb061a0054d078301b87c0db0e01beaf28f16b66014b867611f1ed566",
      "ai_unit_sentence_indices": []
    }
  ]
}
