  "mixed_article_sha256": "73f7f15df526f44151bd93ec11dd3bcbc35a6adbd56cbc2d3aa67cc75e25a835",
  "human_source_sentence_count": 59,
  "ai_source_sentence_count": 52,
  "alignment_unit_count": 52,
  "selected_alignment_unit_count": 19,
  "mixed_sentence_count": 56,
  "selected_ai_sentence_count": 19,
  "actual_ai_sentence_ratio": 0.339286,
