  "mixed_article_sha256": "ebc0daccecfb0891d48183acc1b267904d68b8d166cf85ca2b511841f124b43c",
  "human_source_sentence_count": 61,
  "ai_source_sentence_count": 52,
  "alignment_unit_count": 50,
  "selected_alignment_unit_count": 18,
  "mixed_sentence_count": 63,
  "selected_ai_sentence_count": 21,
