  "mixed_article_sha256": "11e3d02573994a35e7cbfa2695a6ae13b9e122a1ffea9169f4c82b0f0365e72d",
  "human_source_sentence_count": 66,
  "ai_source_sentence_count": 56,
  "alignment_unit_count": 52,
  "selected_alignment_unit_count": 20,
