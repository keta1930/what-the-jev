  "selected_alignment_score_max": 0.86,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Among the few legacies that my father left me was a great talent for sleeping.",
      "output_sha256": "8ee90bce474bc70945cba93c7ae206125dc4f077a92811e1c83b8f89da5d9ba5",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "8ee90bce474bc70945cba93c7ae206125dc4f077a92811e1c83b8f89da5d9ba5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "human",
      "text": "I think I can say, without boasting, that in a sleeping match I could do as well as any man.",
      "output_sha256": "52b766c4cbb0bc7124f08ef1ee4db5e20aa03ac01fc943109a3c980f64adcb4e",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "52b766c4cbb0bc7124f08ef1ee4db5e20aa03ac01fc943109a3c980f64adcb4e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "human",
      "text": "I can sleep long, I can sleep often, and I can sleep sound.",
      "output_sha256": "bef2d66f814ac264a15fb083eed40829e5ca33ba0d1e9d696974a0ace2e92434",
      "alignment_unit_index": 3,
      "alignment_score": null,
      "source_human_sentence_index": 3,
      "source_human_sha256": "bef2d66f814ac264a15fb083eed40829e5ca33ba0d1e9d696974a0ace2e92434",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "human",
      "text": "When I put my head on the pillow I pass into a fathomless peace where no dreams come, and about eight hours later I emerge to consciousness, as though I have come up from the deeps of infinity.",
      "output_sha256": "ce9eaadeb92d22ba4cf5f14a186c4bb11a5f963ae20c3912d3d89c1e41b16cae",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "ce9eaadeb92d22ba4cf5f14a186c4bb11a5f963ae20c3912d3d89c1e41b16cae",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "This is my usual experience; however, there are times when I find myself awake in the dead of night.",
      "output_sha256": "227596c202b427ac331e8776692f9e4e215713aa1f119cdc77a8e25a2612604f",
      "alignment_unit_index": 5,
      "alignment_score": 0.378494,
      "human_sentence_indices": [
        5
      ],
      "human_sha256": [
        "e5c7f0bc61bb854e25e0159fc36f5d6ef66c5defe1e08fc22e66b2b050669f8e"
      ],
      "source_ai_sentence_index": 5,
      "source_ai_sha256": "227596c202b427ac331e8776692f9e4e215713aa1f119cdc77a8e25a2612604f",
      "ai_unit_sentence_indices": [
        5
      ]
    },
    {
      "sentence_index": 6,
      "paragraph_index": 2,
      "origin": "human",
      "text": "My sleep is then divided into two chapters, and between the chapters there is a slab of unmitigated dreariness.",
      "output_sha256": "7a72438ddb5287193523a24de8dce8b4a68d2edb0f92a782c93d367dfb1cbbae",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "7a72438ddb5287193523a24de8dce8b4a68d2edb0f92a782c93d367dfb1cbbae",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "This is my hour of despair.",
      "output_sha256": "82960cf8272b37188c3f4f4cb0bb85975442866ef60733c2014230fb49325243",
      "alignment_unit_index": 7,
      "alignment_score": 0.6,
      "human_sentence_indices": [
        7
      ],
      "human_sha256": [
        "8ceb0429d2537e25e49be24054f0c52ce9ba0e72db436a1d4f6937ad9faa1dec"
      ],
      "source_ai_sentence_index": 7,
      "source_ai_sha256": "82960cf8272b37188c3f4f4cb0bb85975442866ef60733c2014230fb49325243",
      "ai_unit_sentence_indices": [
        7
      ]
    },
    {
      "sentence_index": 8,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "The tide has receded, leaving behind a barren landscape of mud and desolation.",
      "output_sha256": "c0bff50b9e577961242180d3436c0a3fb0eafc3b743f9f0d00a6b2e435f084e1",
      "alignment_unit_index": 8,
      "alignment_score": 0.382792,
      "human_sentence_indices": [
        8
      ],
      "human_sha256": [
        "0186fbfa905762a5bf2da3e608f99ea0d7b780054834667988bfdf1a39d34355"
      ],
      "source_ai_sentence_index": 8,
      "source_ai_sha256": "c0bff50b9e577961242180d3436c0a3fb0eafc3b743f9f0d00a6b2e435f084e1",
      "ai_unit_sentence_indices": [
        8
      ]
    },
    {
      "sentence_index": 9,
      "paragraph_index": 2,
      "origin": "human",
      "text": "It is then that this tragi-comedy of life touches bottom, and I see the heavens all hung with black.",
      "output_sha256": "c3fecaaab1d00daf1c43abddaad8ef2364504f4eb9d6e5ae7e886bf744bbe608",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "c3fecaaab1d00daf1c43abddaad8ef2364504f4eb9d6e5ae7e886bf744bbe608",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 2,
      "origin": "human",
      "text": "I despair of humanity, I despair of the war, I despair of myself.",
      "output_sha256": "2468fab84b8de5114d157840366cace03f003b0da7d8af58654126bf71eb1b49",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 10,
      "source_human_sha256": "2468fab84b8de5114d157840366cace03f003b0da7d8af58654126bf71eb1b49",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "There is not a glimmer of light in the dismal panorama, and I feel as though the abyss is poised to engulf me along with all that I hold dear.",
      "output_sha256": "dd40a3bfcc1c7301735bb23b011dfcb96bbb7e99da32aa3b771b7e08432ea137",
      "alignment_unit_index": 10,
      "alignment_score": 0.509647,
      "human_sentence_indices": [
        11
      ],
      "human_sha256": [
        "d7d57927d93e0099572cc6a201c91f38847832d3d40b380833f0d266f7092379"
      ],
      "source_ai_sentence_index": 10,
      "source_ai_sha256": "dd40a3bfcc1c7301735bb23b011dfcb96bbb7e99da32aa3b771b7e08432ea137",
      "ai_unit_sentence_indices": [
        10
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 2,
      "origin": "human",
      "text": "It is no use saying to this demon of the darkness that I know he is a humbug, a mere Dismal Jemmy of the brain, who sits there croaking like a night owl or a tenth-rate journalist.",
      "output_sha256": "4a45481338e0e583e10646189a2e534deeadd12c75aeb4175939477959f27272",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "4a45481338e0e583e10646189a2e534deeadd12c75aeb4175939477959f27272",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 2,
      "origin": "human",
      "text": "My Dismal Jemmy is not to be exorcised by argument.",
      "output_sha256": "bf866838c006919be1e0578ce1c07b3c18be8420a0d30377680649e6f62de3a5",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "bf866838c006919be1e0578ce1c07b3c18be8420a0d30377680649e6f62de3a5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 2,
      "origin": "human",
      "text": "He can only be driven out by a little sane companionship.",
      "output_sha256": "710a6d2e039fc2215581fc8383d0a3129a2d0a34fbe72cce1f3c7e8b4c6386cd",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "710a6d2e039fc2215581fc8383d0a3129a2d0a34fbe72cce1f3c7e8b4c6386cd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "In those moments, I switch on a light and summon one of my bedside companions.",
      "output_sha256": "b8f061976509293d88e1a93cb9fa3277a4ca5227685fbd74cfa0e74bd4c5f10d",
      "alignment_unit_index": 13,
      "alignment_score": 0.547795,
      "human_sentence_indices": [
        15
      ],
      "human_sha256": [
        "60610bfc920275640fb5434870218834c484a0da561c6dbccaf0e0a696ef1284"
      ],
      "source_ai_sentence_index": 13,
      "source_ai_sha256": "b8f061976509293d88e1a93cb9fa3277a4ca5227685fbd74cfa0e74bd4c5f10d",
      "ai_unit_sentence_indices": [
        13
      ]
    },
    {
      "sentence_index": 16,
      "paragraph_index": 3,
      "origin": "human",
      "text": "They stand there in noble comradeship, ready to talk, willing to remain silent, only asking to do my pleasure.",
      "output_sha256": "744f439c0b3b331d4c2a08d61ace7eb6c203adc4aafd83291eefc3deb24add6b",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "744f439c0b3b331d4c2a08d61ace7eb6c203adc4aafd83291eefc3deb24add6b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "I feel immense gratitude toward Gutenberg, the Master Printer.",
      "output_sha256": "c621d75a1051b179505447f3f129092231eed77d3e8ae079f62b6370b56521fb",
      "alignment_unit_index": 15,
      "alignment_score": 0.496974,
      "human_sentence_indices": [
        17
      ],
      "human_sha256": [
        "263a379451bc07c739c834942e0b640124e9abef5fc6b766486628a5df384e96"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "c621d75a1051b179505447f3f129092231eed77d3e8ae079f62b6370b56521fb",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 18,
      "paragraph_index": 3,
      "origin": "human",
      "text": "A German?",
      "output_sha256": "321350d8dfd2129f4a6c377bacf62d443970c09c90b089b390090aea1194cc8d",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "321350d8dfd2129f4a6c377bacf62d443970c09c90b089b390090aea1194cc8d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "human",
      "text": "I care not.",
      "output_sha256": "2e791e6b28034b478de9b3bd9d867f096446be87992d76a37ef056e123757269",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "2e791e6b28034b478de9b3bd9d867f096446be87992d76a37ef056e123757269",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Even if he had been a Prussian—which I rejoice to think he was not—I would still say: \"Blessed be the name of Gutenberg,\" though Sir Richard Cooper, M.P., sent me to the Tower for it.",
      "output_sha256": "a0f103ef31af29fef9cec2968975cdefaf5fbc84baaf20e8783d402a7efa6958",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "a0f103ef31af29fef9cec2968975cdefaf5fbc84baaf20e8783d402a7efa6958",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Gutenberg is not merely a mythical figure but a historical titan who kindled the sacred flame of knowledge and shattered the darkness that enveloped society.",
      "output_sha256": "05d66ffa03c9fe0480df099a15c973f3b6cf8c38fca13d61953336560bd3613e",
      "alignment_unit_index": 17,
      "alignment_score": 0.420421,
      "human_sentence_indices": [
        21,
        22
      ],
      "human_sha256": [
        "8b6ba927653de59a35494688f08896f7ecd599a6000434e1aee3bcc41e9b3b57",
        "5700bdaa4d9244eea10c5cd4de6957d16fe0cae928a0e20c19f2c269beea09b1"
      ],
      "source_ai_sentence_index": 17,
      "source_ai_sha256": "05d66ffa03c9fe0480df099a15c973f3b6cf8c38fca13d61953336560bd3613e",
      "ai_unit_sentence_indices": [
        17
      ]
    },
    {
      "sentence_index": 22,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Although he introduced us to the Daily Owl, he also granted us the freedom of time and thought, allowing us to connect with the wisdom and mirth of centuries past.",
      "output_sha256": "343b57569529773d35c121731b19bf4a7a7c40201b20bd3f35aa4246d9446656",
      "alignment_unit_index": 18,
      "alignment_score": 0.476981,
      "human_sentence_indices": [
        23
      ],
      "human_sha256": [
        "91349195b7ddda34877c74579c6974d359a65cdd3bdc3ffd007d7f4f25a22773"
      ],
      "source_ai_sentence_index": 18,
      "source_ai_sha256": "343b57569529773d35c121731b19bf4a7a7c40201b20bd3f35aa4246d9446656",
      "ai_unit_sentence_indices": [
        18
      ]
    },
    {
      "sentence_index": 23,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Thanks to him I can, for the expenditure of a few shillings, hear Homer sing and Socrates talk and Rabelais laugh; I can go chivvying the sheep with Don Quixote and roaming the hills with Borrow; I can carry the whole universe of Shakespeare in my pocket, and call up spirits to drive Dismal Jemmy from my pillow.",
      "output_sha256": "6623a9b8f9ebec06c60e11e628f299b72f72d7e9d70c99669bc62effaea18b4e",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "6623a9b8f9ebec06c60e11e628f299b72f72d7e9d70c99669bc62effaea18b4e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "But who are these spirits?",
      "output_sha256": "022a0ede64072da7f89d08072f2e4a4b59e884edc6bf6c0c92f812185f78571b",
      "alignment_unit_index": 20,
      "alignment_score": 0.86,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "5ca3d1e91e72b9dc7605c18312683e3835794300836401c36e4b1907e5fd51e4"
      ],
      "source_ai_sentence_index": 22,
      "source_ai_sha256": "022a0ede64072da7f89d08072f2e4a4b59e884edc6bf6c0c92f812185f78571b",
      "ai_unit_sentence_indices": [
        22
      ]
    },
    {
      "sentence_index": 25,
      "paragraph_index": 4,
      "origin": "human",
      "text": "In choosing them it is necessary to avoid the deep-browed argumentative fellows.",
      "output_sha256": "0ccae10badfd12be1918e0ec685bf6a656b92c40c77153b80aeff997beb41790",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "0ccae10badfd12be1918e0ec685bf6a656b92c40c77153b80aeff997beb41790",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 26,
      "paragraph_index": 4,
      "origin": "human",
      "text": "I do not want Plato or Gibbon or any of the learned brotherhood by my bedside, nor the poets, nor the novelists, nor the dramatists, nor even the professional humorists.",
      "output_sha256": "1fa7ba91d6d52483be9481b7eaedbca26d4ca76b7a3b5cdea2b476b8fdf33a40",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "1fa7ba91d6d52483be9481b7eaedbca26d4ca76b7a3b5cdea2b476b8fdf33a40",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 4,
      "origin": "human",
      "text": "These are all capital fellows in their way, but let them stay downstairs.",
      "output_sha256": "22598ec55647c71ec08829b1bb20c171d35edff1de41e2e71cd971a8732d8dd0",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "22598ec55647c71ec08829b1bb20c171d35edff1de41e2e71cd971a8732d8dd0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Instead, I invite only those amiable figures who, in a sense, arrive in their nightclothes and slippers, sitting comfortably to chat as if they have known me since my earliest days, just as they might have known my father and grandfather.",
      "output_sha256": "004874294990738006998205e1901144113c31e1040212fe1bd5dfee82053c66",
      "alignment_unit_index": 23,
      "alignment_score": 0.36428,
      "human_sentence_indices": [
        29
      ],
      "human_sha256": [
        "1dafe243d4a23e3db7520e540d107c0f40e1d5fdf7a11f2b0bb60d98ae5a8468"
      ],
      "source_ai_sentence_index": 25,
      "source_ai_sha256": "004874294990738006998205e1901144113c31e1040212fe1bd5dfee82053c66",
      "ai_unit_sentence_indices": [
        25
      ]
    },
    {
      "sentence_index": 29,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Among them is the venerable Montaigne, a delightful conversationalist.",
      "output_sha256": "78255cf3c172931a3f61fbd841dd6ed6ff54577666074b09defbe0a72e60a077",
      "alignment_unit_index": 24,
      "alignment_score": 0.321071,
      "human_sentence_indices": [
        30,
        31
      ],
      "human_sha256": [
        "d501b0b9ce4cbe0a02c3a54c199dccaa18ad7c86ff8e3088782de835886dbdcb",
        "4fffe30fcea4682c1fda8709389db62edf3bccb7659b3bff063ff833aafa5e8c"
      ],
      "source_ai_sentence_index": 26,
      "source_ai_sha256": "78255cf3c172931a3f61fbd841dd6ed6ff54577666074b09defbe0a72e60a077",
      "ai_unit_sentence_indices": [
        26
      ]
    },
    {
      "sentence_index": 30,
      "paragraph_index": 4,
      "origin": "human",
      "text": "What strange things he has to tell you, what a noble candour he shows!",
      "output_sha256": "5f9b8fd2d8630585fca6ae76ebfea3aa791e46309b441f7eab0e0ae4df7ccace",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 32,
      "source_human_sha256": "5f9b8fd2d8630585fca6ae76ebfea3aa791e46309b441f7eab0e0ae4df7ccace",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 4,
      "origin": "human",
      "text": "He turns out his mind as carelessly as a boy turns out his pockets, and gives you the run of his whole estate.",
      "output_sha256": "e59165683a6c9b6f26435f576b20dd8c5daa6c461a570bf996d77878a87d5bc2",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "e59165683a6c9b6f26435f576b20dd8c5daa6c461a570bf996d77878a87d5bc2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You may wander everywhere, and never see a board warning you to keep off the grass or reminding you that you are a trespasser.",
      "output_sha256": "4e41cb9c21232190f11dcaa2f8e1edec869276efafd52893e943ffc9b1527894",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "4e41cb9c21232190f11dcaa2f8e1edec869276efafd52893e943ffc9b1527894",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "human",
      "text": "And Bozzy.",
      "output_sha256": "7ee5d0c14e505530371bda248920ca92696e55e3254c47def62b191aff8ec395",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 35,
      "source_human_sha256": "7ee5d0c14e505530371bda248920ca92696e55e3254c47def62b191aff8ec395",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Who could do without Bozzy by his bedside—dear, garrulous old Bozzy, most splendid of toadies, most miraculous of reporters?",
      "output_sha256": "8903b5dead27be262cbb89f10af58e79d06eb870ad548146d0a5a215f432c67a",
      "alignment_unit_index": 28,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "8903b5dead27be262cbb89f10af58e79d06eb870ad548146d0a5a215f432c67a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 35,
      "paragraph_index": 5,
      "origin": "human",
      "text": "When Bozzy begins to talk to me, and the old Doctor growls \"Sir,\" all the worries and anxieties of life fall magically away, and Dismal Jemmy vanishes like the ghost at cock-crow.",
      "output_sha256": "8289e4fb10073d3aae1188363a26fef4acb01d5de6f134310a5b0cd7b3052b36",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "8289e4fb10073d3aae1188363a26fef4acb01d5de6f134310a5b0cd7b3052b36",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 5,
      "origin": "human",
      "text": "I am no longer imprisoned in time and the flesh: I am of the company of the immortals.",
      "output_sha256": "ac1b22d2ad3a8b158009d68e6ae8bb4d790d6800af3f2c6d811ca04492491bbd",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "ac1b22d2ad3a8b158009d68e6ae8bb4d790d6800af3f2c6d811ca04492491bbd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 5,
      "origin": "human",
      "text": "I share their triumphant aloofness from the play that fills our stage and see its place in the scheme of the unending drama of men.",
      "output_sha256": "727dc25fdfd3c4e778cc3f374196c937232517164fc561e61de6d0e57997ee5b",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "727dc25fdfd3c4e778cc3f374196c937232517164fc561e61de6d0e57997ee5b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 6,
      "origin": "human",
      "text": "That sly rogue Pepys, of course, is there—more thumb-stained than any of them except Bozzy.",
      "output_sha256": "f924092b69f79440a431a3b66d49f1ea568f5a10b3d56cbdda2218fd91c1857b",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "f924092b69f79440a431a3b66d49f1ea568f5a10b3d56cbdda2218fd91c1857b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "He lives in our imagination more vividly than any historical figure.",
      "output_sha256": "a4a5d4746a78ffbffab5fa86eecbb7b4f382479f3de4d9c25f2ea0321f40dbc2",
      "alignment_unit_index": 33,
      "alignment_score": 0.339137,
      "human_sentence_indices": [
        41
      ],
      "human_sha256": [
        "f9aaba513284e2aba2029d5db13173d2e58ec9c846278677c57e4280245c5e7f"
      ],
      "source_ai_sentence_index": 36,
      "source_ai_sha256": "a4a5d4746a78ffbffab5fa86eecbb7b4f382479f3de4d9c25f2ea0321f40dbc2",
      "ai_unit_sentence_indices": [
        36
      ]
    },
    {
      "sentence_index": 40,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "What is the secret to his allure?",
      "output_sha256": "e04bcc4718b9d2a526b36bb2f0565651240f71772f374fde93ade6c0d4531a0f",
      "alignment_unit_index": 34,
      "alignment_score": 0.657143,
      "human_sentence_indices": [
        42
      ],
      "human_sha256": [
        "9bcf911c912dce45fed52e51aac7321ff7dce36c91f216148e836ce37102bfb5"
      ],
      "source_ai_sentence_index": 37,
      "source_ai_sha256": "e04bcc4718b9d2a526b36bb2f0565651240f71772f374fde93ade6c0d4531a0f",
      "ai_unit_sentence_indices": [
        37
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "It lies in his ability to capture the genuine essence of himself on paper.",
      "output_sha256": "dfae12356116b2115d7db350d7684cd0d506be90bd1f69196ffca0293d845a3b",
      "alignment_unit_index": 35,
      "alignment_score": 0.326989,
      "human_sentence_indices": [
        43
      ],
      "human_sha256": [
        "956d5c3ccde8b6411c1097fc8077578616d0e12b4a49707f72dcec69cc447f91"
      ],
      "source_ai_sentence_index": 38,
      "source_ai_sha256": "dfae12356116b2115d7db350d7684cd0d506be90bd1f69196ffca0293d845a3b",
      "ai_unit_sentence_indices": [
        38
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 6,
      "origin": "human",
      "text": "A small thing?",
      "output_sha256": "66e32dfa41920131012874a619890c88c6833e3411e5c2291c0220569b87fb98",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "66e32dfa41920131012874a619890c88c6833e3411e5c2291c0220569b87fb98",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Well, you try it.",
      "output_sha256": "6206ad112acc64d5f52a4dc2785327e4192129ee3affaf88cd207d02a044fb3b",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "6206ad112acc64d5f52a4dc2785327e4192129ee3affaf88cd207d02a044fb3b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 6,
      "origin": "human",
      "text": "You will find it the hardest job you have ever tackled.",
      "output_sha256": "2cd2584f48e7c2748ea8230163cba8af7154d47f2eb6fcebbd83d0882b4fa744",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "2cd2584f48e7c2748ea8230163cba8af7154d47f2eb6fcebbd83d0882b4fa744",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "No matter how secretive you may be, you will find that conveying the full truth about yourself is no easy task.",
      "output_sha256": "4848339839f0ce0460b02f804518846bc646d0c3650b0926153f840c73d8dd41",
      "alignment_unit_index": 37,
      "alignment_score": 0.541667,
      "human_sentence_indices": [
        47
      ],
      "human_sha256": [
        "14476144b03a8e37d203be79bef7a3aa1dc49cf831e76a69fd9cedafbf710d52"
      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "4848339839f0ce0460b02f804518846bc646d0c3650b0926153f840c73d8dd41",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 46,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Pepys did that.",
      "output_sha256": "2fffcb85f42c4ec92ae49a9d41572cbd432305cb2db8e0c8cf438868e72b3092",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "2fffcb85f42c4ec92ae49a9d41572cbd432305cb2db8e0c8cf438868e72b3092",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "While Benvenuto Cellini claimed to achieve this, I remain skeptical.",
      "output_sha256": "14a0aba22400474af551f92c18b4e9926128136e4e3bfbc5b4a249a9093eb9b2",
      "alignment_unit_index": 39,
      "alignment_score": 0.393701,
      "human_sentence_indices": [
        49
      ],
      "human_sha256": [
        "da59e2feaaf861341ded053e2017be84ba7307cdb996c2d4c2453040eede3d37"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "14a0aba22400474af551f92c18b4e9926128136e4e3bfbc5b4a249a9093eb9b2",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "Benjamin Franklin came close, and St. Augustine was candid about his youthful indiscretions, but his later confessions were tinged with the piety of a saint.",
      "output_sha256": "8f623cad95019e49ce4556691d1bc53336d0bc22a3dd4424a2152793a412d71f",
      "alignment_unit_index": 40,
      "alignment_score": 0.48908,
      "human_sentence_indices": [
        50,
        51
      ],
      "human_sha256": [
        "62dea31743219247e0dd3587105f76007e40f066039642a911fa035aec162fc1",
        "b5e78c5a79b9816cba2e279c15788c5183a5e0ef268b90569c8f0defe02e889c"
      ],
      "source_ai_sentence_index": 43,
      "source_ai_sha256": "8f623cad95019e49ce4556691d1bc53336d0bc22a3dd4424a2152793a412d71f",
      "ai_unit_sentence_indices": [
        43
      ]
    },
    {
      "sentence_index": 49,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "No, Pepys stands alone as the master of self-revelation.",
      "output_sha256": "cb20079611d61760ea45fecf697ba57eef6c8b82e0f6f09a7627f09c0cd334e8",
      "alignment_unit_index": 41,
      "alignment_score": 0.439683,
      "human_sentence_indices": [
        52
      ],
      "human_sha256": [
        "9c0d396dd6d61d6eba0dd6fe1deffbfbcf9cf123334224290238ae06d479361c"
      ],
      "source_ai_sentence_index": 44,
      "source_ai_sha256": "cb20079611d61760ea45fecf697ba57eef6c8b82e0f6f09a7627f09c0cd334e8",
      "ai_unit_sentence_indices": [
        44
      ]
    },
    {
      "sentence_index": 50,
      "paragraph_index": 6,
      "origin": "human",
      "text": "He did the thing better than it has ever been done in this world.",
      "output_sha256": "e52d372a93184ab4292b1e40a57bb02031037b5db142b08baffb7cf95b8495f3",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "e52d372a93184ab4292b1e40a57bb02031037b5db142b08baffb7cf95b8495f3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 7,
      "origin": "human",
      "text": "I like to have the Paston Letters at my bedside, too.",
      "output_sha256": "75163f5aeeab97a68785f65402d13ce0908bb8b8d9d0e29a01e4f1c736cfcf06",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "75163f5aeeab97a68785f65402d13ce0908bb8b8d9d0e29a01e4f1c736cfcf06",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Then I go off to sleep again in the fifteenth century with the voice of old Agnes Paston sounding in my ears.",
      "output_sha256": "dfe78e2eb137e44ea47d71339cde9e3163c3db92ac3752a1b5dbeb6b33119404",
      "alignment_unit_index": 44,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "dfe78e2eb137e44ea47d71339cde9e3163c3db92ac3752a1b5dbeb6b33119404",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Dead half a thousand years, yet across the gulf of time I hear the painful scratching of her quill as she sends \"Goddis blyssyng\" to her son in London, and tells him all her motherly gossip and makes the rough life of far-off Tudor England live for ever.",
      "output_sha256": "0f5dc303cb716859d538597a2f0742b9ee5f374924ef49bf113c0da3436592be",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "0f5dc303cb716859d538597a2f0742b9ee5f374924ef49bf113c0da3436592be",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Dear old Agnes!",
      "output_sha256": "97142f4808bc792b99ce3cc95b967fd5ff06c7efed299e62cb636c0a690a2334",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "97142f4808bc792b99ce3cc95b967fd5ff06c7efed299e62cb636c0a690a2334",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Little did she realize that as she grappled with spelling and penmanship, she was penning something that would achieve immortality.",
      "output_sha256": "5177fdeeb3186042f973bf97c2142fb00d3c47bd1223c818669530b65583da77",
      "alignment_unit_index": 47,
      "alignment_score": 0.48125,
      "human_sentence_indices": [
        58
      ],
      "human_sha256": [
        "1a7b6c45cac7c4fa46796a79b70c9f014bc490455a44f3fb9d8a2dc4fcd894d4"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "5177fdeeb3186042f973bf97c2142fb00d3c47bd1223c818669530b65583da77",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 56,
      "paragraph_index": 7,
      "origin": "human",
      "text": "If she had known, I don't think she would have bothered.",
      "output_sha256": "f031b8d266b2834013aad875353265357f7af85ff410e31f9dbb837f834f36f5",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "f031b8d266b2834013aad875353265357f7af85ff410e31f9dbb837f834f36f5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 7,
      "origin": "human",
      "text": "She was a very matter-of-fact old lady, and was too full of worries to have much room for vanities.",
      "output_sha256": "49ac199acf0ca2fccfa7c4b11723f78656abc3a07b0255c0dab47ca29f6988f7",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 60,
      "source_human_sha256": "49ac199acf0ca2fccfa7c4b11723f78656abc3a07b0255c0dab47ca29f6988f7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 8,
      "origin": "human",
      "text": "I should like to say more about my bedside friends—strapping George Borrow sitting with Petulengro's sister under the hedge or fighting the Flaming Tinman; the dear little Boston doctor who talks so chirpily over the Breakfast Table; the Compleat Angler that takes you out into an eternal May morning, and Sainte-Beuve whom I have found a first-rate bedside talker.",
      "output_sha256": "682e4bbc6a5f162c1bb2ea6783fb0677269d21e954771912715fe8201b7d44cd",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "682e4bbc6a5f162c1bb2ea6783fb0677269d21e954771912715fe8201b7d44cd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Yet, as I draw near to the end of my musings, I must conclude.",
      "output_sha256": "fa00c1a9f57e58c53d038dc73f785c940f5bcce708a88c21df112a8435d890c6",
      "alignment_unit_index": 50,
      "alignment_score": 0.250913,
      "human_sentence_indices": [
        62,
        63
      ],
      "human_sha256": [
        "06ce1343c7fec7cb09e09bf3e03a1ad8a1ea0a671e792101146df47b98e55dfe",
        "54f289ebf7e6bc147f5610ac474ac24805df44693f68f405b2491d13fbb56e6b"
      ],
      "source_ai_sentence_index": 53,
      "source_ai_sha256": "fa00c1a9f57e58c53d038dc73f785c940f5bcce708a88c21df112a8435d890c6",
      "ai_unit_sentence_indices": [
        53,
        54
      ]
    },
    {
      "sentence_index": 60,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "Still, one final thought lingers.",
      "output_sha256": "2751f659c0039dece90d9dc63c82b34515df2b1c77c2be0f15b4da9fd04d40f4",
      "alignment_unit_index": 50,
      "alignment_score": 0.250913,
      "human_sentence_indices": [
        62,
        63
      ],
      "human_sha256": [
        "06ce1343c7fec7cb09e09bf3e03a1ad8a1ea0a671e792101146df47b98e55dfe",
        "54f289ebf7e6bc147f5610ac474ac24805df44693f68f405b2491d13fbb56e6b"
      ],
      "source_ai_sentence_index": 54,
      "source_ai_sha256": "2751f659c0039dece90d9dc63c82b34515df2b1c77c2be0f15b4da9fd04d40f4",
      "ai_unit_sentence_indices": [
        53,
        54
      ]
    },
    {
      "sentence_index": 61,
      "paragraph_index": 9,
      "origin": "human",
      "text": "Your bedside friends should be dressed in soft leather and printed on thin paper.",
      "output_sha256": "b58a07efd98750057e6cd8d011773e3c7d109a097bc7a5ee2aa036c10c77df29",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 64,
      "source_human_sha256": "b58a07efd98750057e6cd8d011773e3c7d109a097bc7a5ee2aa036c10c77df29",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 9,
      "origin": "human",
      "text": "Then you can talk to them quite snugly.",
      "output_sha256": "53e5dfe6e1e88891a8cc17c0676f92b9670f03ef5368de5f0600fcd2e01c5884",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 65,
      "source_human_sha256": "53e5dfe6e1e88891a8cc17c0676f92b9670f03ef5368de5f0600fcd2e01c5884",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 63,
      "paragraph_index": 9,
      "origin": "human",
      "text": "It is a great nuisance if you have to stick your arms out of bed and hold your hands rigid.",
      "output_sha256": "3b6b05162865f2ce8e1335173ce5e79106531dd83a87d61806c740211b2cea3b",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 66,
      "source_human_sha256": "3b6b05162865f2ce8e1335173ce5e79106531dd83a87d61806c740211b2cea3b",
      "ai_unit_sentence_indices": []
    }
  ]
}
