  "mixed_article_sha256": "d2ba6bc2687073b5f8b9b3dd7a9811674833c355f02a900f082d0c3301594a05",
  "human_source_sentence_count": 60,
  "ai_source_sentence_count": 55,
  "alignment_unit_count": 53,
  "selected_alignment_unit_count": 17,
  "mixed_sentence_count": 60,
  "selected_ai_sentence_count": 20,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.25335,
