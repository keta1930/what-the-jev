  "mixed_article_sha256": "5387354dde064b65b32577e2f247c4b8d2b7f910ff198ffb1da8b63165a81466",
  "human_source_sentence_count": 59,
  "ai_source_sentence_count": 53,
  "alignment_unit_count": 52,
  "selected_alignment_unit_count": 18,
  "mixed_sentence_count": 57,
  "selected_ai_sentence_count": 19,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.30201,
