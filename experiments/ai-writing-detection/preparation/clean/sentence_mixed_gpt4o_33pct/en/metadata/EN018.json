  "mixed_article_sha256": "0300caace768281584d32822a87fcb72a80e89a49372d8221041d08b901b0e22",
  "human_source_sentence_count": 49,
  "ai_source_sentence_count": 52,
  "alignment_unit_count": 47,
  "selected_alignment_unit_count": 13,
  "mixed_sentence_count": 53,
  "selected_ai_sentence_count": 18,
  "actual_ai_sentence_ratio": 0.339623,
