  "mixed_article_sha256": "ec427407e4982dbc012b548d3623661ef006be9af1cdae64325bfc0c45f51463",
  "human_source_sentence_count": 66,
  "ai_source_sentence_count": 65,
  "alignment_unit_count": 54,
  "selected_alignment_unit_count": 20,
  "mixed_sentence_count": 63,
  "selected_ai_sentence_count": 21,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.262726,
