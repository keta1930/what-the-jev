      ],
      "source_ai_sentence_index": 40,
      "source_ai_sha256": "91b23c68e326cd90a3adec04458dc2c5713411d3166f90b9423e64f416213b7c",
      "ai_unit_sentence_indices": [
        40
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "I imagine a celebration of sorts, perhaps involving an outdoor play or a tank drama.",
      "output_sha256": "d617577c696d7e68d677d9301dccc19ca89b3e28e258daa2b530b5985be857b2",
      "alignment_unit_index": 40,
      "alignment_score": 0.305354,
      "human_sentence_indices": [
