      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 44,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I must say that he has been a little lucky in his choice of a year for inaugurating the pond.",
      "output_sha256": "8134f53d7f3bcea6b0066a783871b6dd68a7d896ad4a81e89ceaa0a2197b1c8e",
      "alignment_unit_index": 42,
