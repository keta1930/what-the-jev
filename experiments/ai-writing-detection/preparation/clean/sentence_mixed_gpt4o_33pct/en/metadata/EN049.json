      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "1bc4ac1adad9c36f1959a9c74a844f2b8d84cda0da78c16e5a7590ba8106da2e",
      "ai_unit_sentence_indices": [
        39
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "A person with such an expansive and welcoming attitude towards rain gauges surely has something grand in mind for the occasion.",
      "output_sha256": "91b23c68e326cd90a3adec04458dc2c5713411d3166f90b9423e64f416213b7c",
      "alignment_unit_index": 39,
      "alignment_score": 0.385406,
