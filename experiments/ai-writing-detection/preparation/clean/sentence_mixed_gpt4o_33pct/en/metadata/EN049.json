      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 5,
      "origin": "human",
      "text": "And you know, it even reconciles us a little to these streaming days to reflect that it all goes to fill the pond.",
      "output_sha256": "b5bb17e5213c492e6f1b253e8aeeb02e0b7eeef83441cbe10d860db630798d39",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 39,
