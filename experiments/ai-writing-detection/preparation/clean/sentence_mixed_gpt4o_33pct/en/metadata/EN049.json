      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 5,
      "origin": "human",
      "text": "For there is ever before our minds that great moment in the future when the pond is at last full.",
      "output_sha256": "a118701fa6da3b0cf49bd6756bbce30cf1bed429e9496c25d65fc2713334e76c",
      "alignment_unit_index": 35,
      "alignment_score": null,
