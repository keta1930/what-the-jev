      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Instead, we cheerfully announce, \"I'm off to see the pond; it must be nearly full.",
      "output_sha256": "9880ca02612d4df0d24fe59c35e85667d234bb1f4abe0e335b18e4138680567e",
      "alignment_unit_index": 31,
      "alignment_score": 0.626917,
