      ],
      "source_ai_sentence_index": 41,
      "source_ai_sha256": "d617577c696d7e68d677d9301dccc19ca89b3e28e258daa2b530b5985be857b2",
      "ai_unit_sentence_indices": [
        41
      ]
    },
    {
      "sentence_index": 43,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Regardless, we remain optimistic that Aldenham will quickly drain the pond so we can witness its filling once again.",
      "output_sha256": "09bb7df1be50450f08799ffb9e1e377862969b89425ad393398e0e9925a0604e",
      "alignment_unit_index": 41,
      "alignment_score": 0.354767,
      "human_sentence_indices": [
