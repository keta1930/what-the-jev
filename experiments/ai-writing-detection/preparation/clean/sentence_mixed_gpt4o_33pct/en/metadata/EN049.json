      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 35,
      "paragraph_index": 5,
      "origin": "human",
      "text": "And with any luck she comes.",
      "output_sha256": "caa255645134ffd5070885943ab4a4ff970c0a00bcd218795fd2dc6808cfd2e0",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 38,
