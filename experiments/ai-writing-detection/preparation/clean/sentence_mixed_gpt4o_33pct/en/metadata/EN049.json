      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 5,
      "origin": "human",
      "text": "What will happen then?",
      "output_sha256": "e460827d55ac1b7d96d8ec8f82308081c37e0857673ad605f625888282838b06",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "e460827d55ac1b7d96d8ec8f82308081c37e0857673ad605f625888282838b06",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Aldenham may know, but we his guests do not.",
      "output_sha256": "6fd889c1f60a5e1c1b3c434fdbb8d79b5946dae9b6120b1d3f6717d67a02b66c",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "6fd889c1f60a5e1c1b3c434fdbb8d79b5946dae9b6120b1d3f6717d67a02b66c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Some believe it will merely spill over onto the adjacent paths and into the kitchen garden, while I hold out hope for something more spectacular.",
      "output_sha256": "1bc4ac1adad9c36f1959a9c74a844f2b8d84cda0da78c16e5a7590ba8106da2e",
      "alignment_unit_index": 38,
      "alignment_score": 0.51303,
      "human_sentence_indices": [
        43
