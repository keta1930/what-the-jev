      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "9880ca02612d4df0d24fe59c35e85667d234bb1f4abe0e335b18e4138680567e",
      "ai_unit_sentence_indices": [
        32
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "human",
      "text": "Won't you come too?\"",
      "output_sha256": "273eeaad9a02027bb4d0b696ede7a5a64f5b85d1abd92fb7f316a9de243fe9dd",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 37,
