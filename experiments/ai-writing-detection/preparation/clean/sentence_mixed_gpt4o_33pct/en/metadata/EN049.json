      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 32,
      "paragraph_index": 5,
      "origin": "human",
      "text": "\"Where are you off to?\" she would ask, and we could only answer lamely, \"Er—I was just going to— er—walk about a bit.\"",
      "output_sha256": "36703dfe53a656e110a18af0a5e89b122ff3645ca723a08ebb0d86424d8eda71",
      "alignment_unit_index": 30,
      "alignment_score": null,
