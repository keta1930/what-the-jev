  "ai_article_sha256": "3f38a99b31b3c26a02b93da9def366cc23c6fcd30ca19d37d5ae7847c059e3c4",
  "mixed_article_sha256": "8364201f21eff59d1010bcf4beb3815fb434a06d6afee7ee2af5996da6150799",
  "human_source_sentence_count": 59,
  "ai_source_sentence_count": 52,
  "alignment_unit_count": 54,
  "selected_alignment_unit_count": 19,
  "mixed_sentence_count": 57,
  "selected_ai_sentence_count": 19,
  "actual_ai_sentence_ratio": 0.333333,
