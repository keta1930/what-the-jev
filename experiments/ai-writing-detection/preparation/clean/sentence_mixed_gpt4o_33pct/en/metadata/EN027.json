  "mixed_article_sha256": "c04053b57f3765afb1da992cff56ebd7690dce3fae56bc9ff13d09ab02427566",
  "human_source_sentence_count": 54,
  "ai_source_sentence_count": 54,
  "alignment_unit_count": 49,
  "selected_alignment_unit_count": 18,
  "mixed_sentence_count": 54,
  "selected_ai_sentence_count": 18,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.27139,
