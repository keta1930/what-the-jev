  "selected_alignment_score_max": 0.681473,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "I started out the other day from Keswick with a rucksack on my back, a Baddeley in my pocket, and a companion by my side.",
      "output_sha256": "2bb15c48762ae93ddf89d2323fa78c49334a85440914f713e3b2bb9f87ae8709",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "2bb15c48762ae93ddf89d2323fa78c49334a85440914f713e3b2bb9f87ae8709",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "Walking with a partner adds to the experience; as Sterne once expressed, \"Give me a companion by the way,\" even if it’s just to notice how shadows stretch as the sun dips lower.",
      "output_sha256": "84f5cad3280d6a319d64f27681d1f0f9158c9a7ac10b6e0c1e5a526e4d9cdfca",
      "alignment_unit_index": 2,
      "alignment_score": 0.504563,
      "human_sentence_indices": [
        2,
        3
      ],
      "human_sha256": [
        "75ea71804e9299e1d326aa1a1879012dbbac54415924c9b27111599fd0ecd947",
        "7e18a047e0c74c81e5b6348a7af1e706fb74cf2e10c20838588fa33cdb987a6d"
      ],
      "source_ai_sentence_index": 2,
      "source_ai_sha256": "84f5cad3280d6a319d64f27681d1f0f9158c9a7ac10b6e0c1e5a526e4d9cdfca",
      "ai_unit_sentence_indices": [
        2
      ]
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "That’s about all the conversation one needs.",
      "output_sha256": "7cc9f7e0fc0b2ec1f7ddb12d693f7e3dd7d430f371d2fdeb1fbc0accf5f42fc7",
      "alignment_unit_index": 3,
      "alignment_score": 0.288961,
      "human_sentence_indices": [
        4
      ],
      "human_sha256": [
        "a6160c903fde36c6a3f95ce8c0b3c75f51f29c353d36a9b68c78e306739ba8e2"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "7cc9f7e0fc0b2ec1f7ddb12d693f7e3dd7d430f371d2fdeb1fbc0accf5f42fc7",
      "ai_unit_sentence_indices": [
        3
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "human",
      "text": "You do not want a talkative person.",
      "output_sha256": "1d48fe7ca6cc939ee33b98b9f2019280a35d1cbcc3fca144631254d783d8034c",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 5,
      "source_human_sha256": "1d48fe7ca6cc939ee33b98b9f2019280a35d1cbcc3fca144631254d783d8034c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "human",
      "text": "Walking is an occupation in itself.",
      "output_sha256": "6faebdc59b83cf84351696e29d597ec54aed738a22ddb26760e54f6c6940f91f",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "6faebdc59b83cf84351696e29d597ec54aed738a22ddb26760e54f6c6940f91f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "human",
      "text": "You may give yourself up to chatter at the beginning, but when you are warmed to the job you are disposed to silence, drop perhaps one behind the other, and reserve your talk for the inn table and the after-supper pipe.",
      "output_sha256": "9ef012104a919d935ddd528e6224f9654ae272bdae6c1a77f3a242a2563119fd",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 7,
      "source_human_sha256": "9ef012104a919d935ddd528e6224f9654ae272bdae6c1a77f3a242a2563119fd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "human",
      "text": "An occasional joke, an occasional stave of song, a necessary consultation over the map—that is enough for the way.",
      "output_sha256": "3e887687391e8b8361ebf53ea21b9f29bdf409e154e6b63983b0dd1c14d060f0",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "3e887687391e8b8361ebf53ea21b9f29bdf409e154e6b63983b0dd1c14d060f0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 2,
      "origin": "human",
      "text": "At the head of the Lake we got in a boat and rowed across Derwentwater to the tiny bay at the foot of Catbells.",
      "output_sha256": "d011b4c589ef3f35c85e65142edda60e9c8505e049522d9e878e23570e0af2c0",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "d011b4c589ef3f35c85e65142edda60e9c8505e049522d9e878e23570e0af2c0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "We disembarked, adjusted our packs, and embarked on our journey over the mountains and through the passes, relishing a week immersed in the profound solitude that this region has to offer.",
      "output_sha256": "59a36a69d2a0d9c5b551d02cd8764e6ab5fda169609bd40df22e969812cfa07d",
      "alignment_unit_index": 8,
      "alignment_score": 0.481459,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "bb33d151d0ea7bdbae84cc0a9359c3831f3591d6c25f5ed70c20387df07e5007"
      ],
      "source_ai_sentence_index": 8,
      "source_ai_sha256": "59a36a69d2a0d9c5b551d02cd8764e6ab5fda169609bd40df22e969812cfa07d",
      "ai_unit_sentence_indices": [
        8
      ]
    },
    {
      "sentence_index": 10,
      "paragraph_index": 2,
      "origin": "human",
      "text": "We followed no cut-and-dried programme.",
      "output_sha256": "ca624a9d50389dc296a6d98c61eed04394650399f349c482f408ee5b7b7cb2ce",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "ca624a9d50389dc296a6d98c61eed04394650399f349c482f408ee5b7b7cb2ce",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "While I enjoy creating plans for hiking expeditions, I find even greater joy in deviating from them.",
      "output_sha256": "e8430db308d9a387754cd4e0781f6e5516385e191cd1564abe3a1b9151591cbb",
      "alignment_unit_index": 10,
      "alignment_score": 0.291746,
      "human_sentence_indices": [
        12
      ],
      "human_sha256": [
        "daa1a709bf3729f02afe56f2b18d0c8af8fc8069bb30bf4e9c318ef40793bab2"
      ],
      "source_ai_sentence_index": 10,
      "source_ai_sha256": "e8430db308d9a387754cd4e0781f6e5516385e191cd1564abe3a1b9151591cbb",
      "ai_unit_sentence_indices": [
        10
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 2,
      "origin": "human",
      "text": "For one of the joys of walking is the sense of freedom it gives you.",
      "output_sha256": "890672daae8ef6d59077b5b3117e55748aa948039c4bfd34b016a08e65d9d877",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "890672daae8ef6d59077b5b3117e55748aa948039c4bfd34b016a08e65d9d877",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "You are not bound by schedules, nor confined to a specific route, nor beholden to anyone.",
      "output_sha256": "cbf16a81fe98d2b6ea485f0bc554504f500a03b7a0d98b09d56baf7083dc316c",
      "alignment_unit_index": 12,
      "alignment_score": 0.334375,
      "human_sentence_indices": [
        14
      ],
      "human_sha256": [
        "a2b5e4667546b14d70f5c62cd2b7c422d683a64042801016ead89eefa71eb13f"
      ],
      "source_ai_sentence_index": 12,
      "source_ai_sha256": "cbf16a81fe98d2b6ea485f0bc554504f500a03b7a0d98b09d56baf7083dc316c",
      "ai_unit_sentence_indices": [
        12
      ]
    },
    {
      "sentence_index": 14,
      "paragraph_index": 2,
      "origin": "human",
      "text": "If you like the road you follow it; if you choose the pass that is yours also; if your fancy (and your wind) is for the mountain tops, then over Great Gable and Scawfell, Robinson and Helvellyn be your way.",
      "output_sha256": "bd016c79d00acf36dc5c073f795ac9bc02f3e046e79f9d038406a974c747ff8a",
      "alignment_unit_index": 13,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "bd016c79d00acf36dc5c073f795ac9bc02f3e046e79f9d038406a974c747ff8a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Every short cut is for you, and every track is the path of adventure.",
      "output_sha256": "421e76c278817c11bd096973e1d6912c078cb144785a6108fd9f2bcc9641d233",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "421e76c278817c11bd096973e1d6912c078cb144785a6108fd9f2bcc9641d233",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 2,
      "origin": "human",
      "text": "The stream that tumbles down the mountain side is your wine cup.",
      "output_sha256": "4f9677e274f0a8872b1c8fa1df323f153f5b0ab3c5f3b1527b4823e313b7d89d",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "4f9677e274f0a8872b1c8fa1df323f153f5b0ab3c5f3b1527b4823e313b7d89d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 2,
      "origin": "human",
      "text": "You kneel on the boulders, bend your head, and take such draughts as only the healthy thirst of the mountains can give.",
      "output_sha256": "09ce76231333c772be81cec413d416ebff3facc18e9578800c61de2d875d2377",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "09ce76231333c772be81cec413d416ebff3facc18e9578800c61de2d875d2377",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Then, with a renewed spirit, you continue on your way, singing:",
      "output_sha256": "d8700c29f84b23e47c5947be0093a976b095011c41aa4a432559b0443e73f79d",
      "alignment_unit_index": 17,
      "alignment_score": 0.505844,
      "human_sentence_indices": [
        19
      ],
      "human_sha256": [
        "028dd63a91084d10bf5f9fdb88a41a1561825efdf23798dea87c3aeeac50f7d3"
      ],
      "source_ai_sentence_index": 17,
      "source_ai_sha256": "d8700c29f84b23e47c5947be0093a976b095011c41aa4a432559b0443e73f79d",
      "ai_unit_sentence_indices": [
        17
      ]
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Bed in the bush with the stars to see.",
      "output_sha256": "0042fb7c9ad64ce97b8dc675943b8bd07d255ac94594449fb78075c4bc54ae6f",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "0042fb7c9ad64ce97b8dc675943b8bd07d255ac94594449fb78075c4bc54ae6f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "human",
      "text": "Bread I dip in the river— There's the life for a man like me.",
      "output_sha256": "c8e34ea1963b996c3cfc389452c3cdbbb21cc9b42cfb21999c9c5671a40180dc",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 21,
      "source_human_sha256": "c8e34ea1963b996c3cfc389452c3cdbbb21cc9b42cfb21999c9c5671a40180dc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "human",
      "text": "There's the life for ever.",
      "output_sha256": "2f58de6c44739ce341b17a9331a4f3fab8fe546b6811f80c82a6a0f2d7b57f5f",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "2f58de6c44739ce341b17a9331a4f3fab8fe546b6811f80c82a6a0f2d7b57f5f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 4,
      "origin": "human",
      "text": "What liberty is there like this?",
      "output_sha256": "a67daa48463280b4f3610323acbeb76848cadd72a472952ac55c5f66c53c860d",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "a67daa48463280b4f3610323acbeb76848cadd72a472952ac55c5f66c53c860d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You have cut your moorings from the world, you are far from telegraphs and newspapers and all the frenzies of the life you have left behind you, you are alone with the lonely hills and the wide sky and the elemental things that have been from the beginning and will outlast all the tortured drama of men.",
      "output_sha256": "a85b3378398f248e4fbf56decf18c4b466ff5afadd7d649d93548958e752fd3f",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "a85b3378398f248e4fbf56decf18c4b466ff5afadd7d649d93548958e752fd3f",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "The sounds of life—the curlew’s whistle, the bleating of sheep—only deepen the sense of ancient isolation.",
      "output_sha256": "39c89ba145e91ad10417962e187525bf41bcf6d4ba928d972f1ab0cbee419f46",
      "alignment_unit_index": 23,
      "alignment_score": 0.59777,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "e1bedc376b31a3cf694bcd28101f756a7b15f701875b2774a8bfc4b7825efd21"
      ],
      "source_ai_sentence_index": 24,
      "source_ai_sha256": "39c89ba145e91ad10417962e187525bf41bcf6d4ba928d972f1ab0cbee419f46",
      "ai_unit_sentence_indices": [
        24
      ]
    },
    {
      "sentence_index": 25,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "These echoes have resonated off the crags for millennia; their harmonies, alongside the rush of winds and waters, will continue to reverberate for countless more years.",
      "output_sha256": "ca8619203620a4c72a96bb96d936bed719185da88324ab7327d0ebe7241c2f09",
      "alignment_unit_index": 24,
      "alignment_score": 0.392941,
      "human_sentence_indices": [
        26
      ],
      "human_sha256": [
        "0337f6f9d1908323fb4021762569e83d576948c676bbee4d967ef55b0e56ebfc"
      ],
      "source_ai_sentence_index": 25,
      "source_ai_sha256": "ca8619203620a4c72a96bb96d936bed719185da88324ab7327d0ebe7241c2f09",
      "ai_unit_sentence_indices": [
        25
      ]
    },
    {
      "sentence_index": 26,
      "paragraph_index": 4,
      "origin": "human",
      "text": "It is as though you have passed out of time into eternity, where a thousand years are as one day.",
      "output_sha256": "573b9c9a92ce901075375aa56979e64dd8bc3b48e12c27a662f5e5e2b988097a",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "573b9c9a92ce901075375aa56979e64dd8bc3b48e12c27a662f5e5e2b988097a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 4,
      "origin": "human",
      "text": "There is no calendar for this dateless world.",
      "output_sha256": "a0197cc79b6ea2d53dac81d62fc0fa838045a62c16d83da088e13a5a70466b01",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "a0197cc79b6ea2d53dac81d62fc0fa838045a62c16d83da088e13a5a70466b01",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 4,
      "origin": "human",
      "text": "The buzzard that you have startled from its pool in the gully and that circles round with wide-flapping wings has a lineage as ancient as the hills, and the vision of the pikes of Langdale that bursts on you as you reach the summit of Esk hause is the same vision that burst on the first savage who adventured into these wild fastnesses of the mountains.",
      "output_sha256": "7ba34f1e65f29efbb33502adf839402502caf78d0f2d9bf166aa10751c16bb45",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "7ba34f1e65f29efbb33502adf839402502caf78d0f2d9bf166aa10751c16bb45",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "As the sun tilts toward the horizon, reality sets in.",
      "output_sha256": "0ba059bfc01260708595a9dccdedb12051f0dd1d772b222cb8e5eb2faf734815",
      "alignment_unit_index": 28,
      "alignment_score": 0.350033,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "074eb8be59b7b6e50349a821c9aa9ab148b3859ebc04a28b7b03984b865d2018"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "0ba059bfc01260708595a9dccdedb12051f0dd1d772b222cb8e5eb2faf734815",
      "ai_unit_sentence_indices": [
        30,
        31
      ]
    },
    {
      "sentence_index": 30,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "You are reminded that, while surrounded by eternal wonders, you are still very much mortal, feeling the fatigue in your feet and realizing the need for rest and refuge for the night.",
      "output_sha256": "5c803d5dfa79d6fe72c3464aa43cc87dde28b5ac19d0d90c381699ff498a9078",
      "alignment_unit_index": 28,
      "alignment_score": 0.350033,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "074eb8be59b7b6e50349a821c9aa9ab148b3859ebc04a28b7b03984b865d2018"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "5c803d5dfa79d6fe72c3464aa43cc87dde28b5ac19d0d90c381699ff498a9078",
      "ai_unit_sentence_indices": [
        30,
        31
      ]
    },
    {
      "sentence_index": 31,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "Where shall we go?",
      "output_sha256": "5b518225803b5120d5fe0f22757465e3a42c15c3326cf92610573df319db210d",
      "alignment_unit_index": 29,
      "alignment_score": 0.485,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "44600e7b4cd636c2c8ec83299b51d2fca226eef390b10982fb608c3333b7e15a"
      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "5b518225803b5120d5fe0f22757465e3a42c15c3326cf92610573df319db210d",
      "ai_unit_sentence_indices": [
        32
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 5,
      "origin": "human",
      "text": "The valleys call us on every side.",
      "output_sha256": "45d505cf1ce51a96c24b7e0fc8ec89e9f2c18640e23cfb8ef0633628dd4b970c",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 32,
      "source_human_sha256": "45d505cf1ce51a96c24b7e0fc8ec89e9f2c18640e23cfb8ef0633628dd4b970c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "We could head toward the expansive Newlands Vale, the cheerful Borrowdale, the serene Ennerdale, or—yes, tonight we’ll dine at Wastdale, at the cheerful old inn once run by Auld Will Ritson, a sanctuary for cragsmen.",
      "output_sha256": "ab46e73736481e08dfc28617dcfd3168c1540c68265d8f53cc1828e132434283",
      "alignment_unit_index": 31,
      "alignment_score": 0.456712,
      "human_sentence_indices": [
        33
      ],
      "human_sha256": [
        "eefa45e1c694c59ffacd7ae776fb192ffefe4a98aaaa4c3425aa6cea104a9d9e"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "ab46e73736481e08dfc28617dcfd3168c1540c68265d8f53cc1828e132434283",
      "ai_unit_sentence_indices": [
        34,
        35
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 5,
      "origin": "ai",
      "text": "It’s a place where, on New Year’s Eve, climbers gather to share stories of their mountain exploits, discussing handholds and footholds, joining in the lively chorus of “The rope, the rope,” led by the landlord who heartily sings:",
      "output_sha256": "d50f19a55c602f9090c7427260a13ee1c84549d337df7b92ee98b8dae0eeb98a",
      "alignment_unit_index": 31,
      "alignment_score": 0.456712,
      "human_sentence_indices": [
        33
      ],
      "human_sha256": [
        "eefa45e1c694c59ffacd7ae776fb192ffefe4a98aaaa4c3425aa6cea104a9d9e"
      ],
      "source_ai_sentence_index": 35,
      "source_ai_sha256": "d50f19a55c602f9090c7427260a13ee1c84549d337df7b92ee98b8dae0eeb98a",
      "ai_unit_sentence_indices": [
        34,
        35
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I'm not a climber, not a climber, Not a climber now, My weight is going fourteen stone— I'm not a climber now.",
      "output_sha256": "446f9fc8353e6629ae5c709137996c899e7a96b93d1f05b38d6a58d00425bba6",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "446f9fc8353e6629ae5c709137996c899e7a96b93d1f05b38d6a58d00425bba6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 36,
      "paragraph_index": 7,
      "origin": "human",
      "text": "We shall not find Gaspard there to-night—Gaspard, the gay and intrepid guide from the Dauphiné, beloved of all who know the lonely inn at Wastdale.",
      "output_sha256": "7d57675a03d4a496c1c0237a131711472d2e1171d24b8b6cebf41b83c979c3ed",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 35,
      "source_human_sha256": "7d57675a03d4a496c1c0237a131711472d2e1171d24b8b6cebf41b83c979c3ed",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He is away on the battle-field fighting a sterner foe than the rocks and precipices of Great Gable and Scawfell.",
      "output_sha256": "ad683258b0ae3d3b7a2dedd2f80974fc1a000d7b1ebdd836f171a8b08d46515a",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "ad683258b0ae3d3b7a2dedd2f80974fc1a000d7b1ebdd836f171a8b08d46515a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 7,
      "origin": "human",
      "text": "But Old Joe, the shepherd, will be there—Old Joe, who has never been in a train or seen a town and whose special glory is that he can pull uglier faces than any man in Cumberland.",
      "output_sha256": "256761d74bf6cc69498627b0f7816b65e8760067fa1e8ae69fd990f17039b6ef",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "256761d74bf6cc69498627b0f7816b65e8760067fa1e8ae69fd990f17039b6ef",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He will not pull them for anybody—only when he is in a good humour and for his cronies in the back parlour.",
      "output_sha256": "043936e153a319ffd4bc8119ab7dc1bf2682fa121a081c1ba8db9804b45cd682",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "043936e153a319ffd4bc8119ab7dc1bf2682fa121a081c1ba8db9804b45cd682",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Perhaps tonight, we will witness his eyes rolling as he passionately belts out the chorus of “D’ye ken John Peel?”",
      "output_sha256": "ac897386d5dd2a98688f2a5a0ba6ed4f946f569700f0d7cf7e1ae0032dfc31cd",
      "alignment_unit_index": 37,
      "alignment_score": 0.572637,
      "human_sentence_indices": [
        39
      ],
      "human_sha256": [
        "cd752ee30842f619fffc7ed076518beeb19765368ed09648f488267510896019"
      ],
      "source_ai_sentence_index": 41,
      "source_ai_sha256": "ac897386d5dd2a98688f2a5a0ba6ed4f946f569700f0d7cf7e1ae0032dfc31cd",
      "ai_unit_sentence_indices": [
        41
      ]
    },
    {
      "sentence_index": 41,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Yes, Wastdale shall be to-night's halt.",
      "output_sha256": "44229476a304c53d688072e1ebff2a17976deb8d0abebd3adaa7269261483078",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "44229476a304c53d688072e1ebff2a17976deb8d0abebd3adaa7269261483078",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 7,
      "origin": "human",
      "text": "And so over Black Sail, and down the rough mountain side to the inn whose white-washed walls hail us from afar out of the gathering shadows of the valley.",
      "output_sha256": "94596e51d957a6a5996198bc928209a3786065e94330f54ae43a66b168c7767c",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "94596e51d957a6a5996198bc928209a3786065e94330f54ae43a66b168c7767c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 8,
      "origin": "human",
      "text": "To-morrow?",
      "output_sha256": "7a5f93f7ba5055fb26660d5b7ecffe1b76caa7a7457a13d578f6e73af0865f10",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "7a5f93f7ba5055fb26660d5b7ecffe1b76caa7a7457a13d578f6e73af0865f10",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Well, to-morrow shall be as to-day.",
      "output_sha256": "15bf9343125a1d3cf3af0448f8774db0ec38b86b9c781ae40a90ae1ba0b05dc5",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "15bf9343125a1d3cf3af0448f8774db0ec38b86b9c781ae40a90ae1ba0b05dc5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 8,
      "origin": "human",
      "text": "We will shoulder our rucksacks early, and be early on the mountains, for the first maxim in going a journey is the early start.",
      "output_sha256": "2d8f1fb90a98873addf48ab413c743df6d1d485cab433dd179c1781c583a7986",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "2d8f1fb90a98873addf48ab413c743df6d1d485cab433dd179c1781c583a7986",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Have the whip-hand of the day, and then you may loiter as you choose.",
      "output_sha256": "28cea021e6965fc2309bdf20bdf8ccda16f942e174a80f14deb4c42652b26cc6",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "28cea021e6965fc2309bdf20bdf8ccda16f942e174a80f14deb4c42652b26cc6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 8,
      "origin": "human",
      "text": "If it is hot, you may bathe in the chill waters of those tarns that lie bare to the eye of heaven in the hollows of the hills—tarns with names of beauty and waters of such crystal purity as Killarney knows not.",
      "output_sha256": "e4449058d60792b935e25807ee929bda5e23b36003407e6b9b8aadef5dd41278",
      "alignment_unit_index": 43,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "e4449058d60792b935e25807ee929bda5e23b36003407e6b9b8aadef5dd41278",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 48,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "By nightfall, we may descend through the clouds along the wild path of Rosset Ghyll and find rest and nourishment at the hotel near Dungeon Ghyll, or, if we manage the day well, we could continue on toward Coniston via Blea Tarn and Yewdale, or through Easedale Tarn to Grasmere, eventually reaching the Swan at the foot of Dunmail Raise.",
      "output_sha256": "1c6873d7b7d57ea0d71cb6a0f2ab05254f1ffe37cc0972bc85851f7076fa3fcd",
      "alignment_unit_index": 44,
      "alignment_score": 0.632659,
      "human_sentence_indices": [
        47
      ],
      "human_sha256": [
        "49f03a429df5806482ec39abeb3d2f8c861762dd1364b81adeb135587cb69033"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "1c6873d7b7d57ea0d71cb6a0f2ab05254f1ffe37cc0972bc85851f7076fa3fcd",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 49,
      "paragraph_index": 8,
      "origin": "human",
      "text": "For we must call at the Swan.",
      "output_sha256": "7af6f1ab0544f5da65f73cb79bd7441c320d89b04d1c9d650e37526b62efbaa3",
      "alignment_unit_index": 45,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "7af6f1ab0544f5da65f73cb79bd7441c320d89b04d1c9d650e37526b62efbaa3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Was it not the Swan that Wordsworth's \"Waggoner\" so triumphantly passed?",
      "output_sha256": "097b641d20d49f6f4a781137c145dd3bbc8a4a6399bd34fa3dbcb85119bcfc27",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "097b641d20d49f6f4a781137c145dd3bbc8a4a6399bd34fa3dbcb85119bcfc27",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Was it not the Swan where Sir Walter Scott enjoyed a pint during his visits with Wordsworth at Rydal Water?",
      "output_sha256": "aa42cd47f014d5f188b2bc871d496a276cd4e68af102b4cfdeacdb02ab55b5a4",
      "alignment_unit_index": 47,
      "alignment_score": 0.613529,
      "human_sentence_indices": [
        50
      ],
      "human_sha256": [
        "840e8a7193587b4999f30f44b52a99ae4d5dd4ad6274ee6edbc83aea595c537c"
      ],
      "source_ai_sentence_index": 52,
      "source_ai_sha256": "aa42cd47f014d5f188b2bc871d496a276cd4e68af102b4cfdeacdb02ab55b5a4",
      "ai_unit_sentence_indices": [
        52
      ]
    },
    {
      "sentence_index": 52,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "And isn’t there, behind the Swan, a fold in the hills where Wordsworth’s “Michael” endeavored to build his sheepfold?",
      "output_sha256": "e0858badc03445b9979cff0aeaf4cee4ba8cd3015c164c2e93707739bdd95819",
      "alignment_unit_index": 48,
      "alignment_score": 0.681473,
      "human_sentence_indices": [
        51
      ],
      "human_sha256": [
        "3e5563434e62918664e9c729b9b987b99ba31cc085393a7917b5f7ae5eda6bb6"
      ],
      "source_ai_sentence_index": 53,
      "source_ai_sha256": "e0858badc03445b9979cff0aeaf4cee4ba8cd3015c164c2e93707739bdd95819",
      "ai_unit_sentence_indices": [
        53
      ]
    },
    {
      "sentence_index": 53,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Yes, we will certainly stay at the Swan, come what may.",
      "output_sha256": "e1a3637ec954553a4df6e4691e57545d14b3b30cad0b5c6e510e540b8103b078",
      "alignment_unit_index": 49,
      "alignment_score": 0.648636,
      "human_sentence_indices": [
        52
      ],
      "human_sha256": [
        "6800bff40224eb81d8d35b7104eb6e2706e893315ee67944768abdd0b99308ed"
      ],
      "source_ai_sentence_index": 54,
      "source_ai_sha256": "e1a3637ec954553a4df6e4691e57545d14b3b30cad0b5c6e510e540b8103b078",
      "ai_unit_sentence_indices": [
        54
      ]
    },
    {
      "sentence_index": 54,
      "paragraph_index": 9,
      "origin": "human",
      "text": "And so the jolly days go by, some wet, some fine, some a mixture of both, but all delightful, and we forget the day of the week, know no news except the changes in the weather and the track over the mountains, meet none of our kind except a rare vagabond like ourselves—with rope across his shoulder if he is a rock-man, with rucksack on back if he is a tourist—and with no goal save some far-off valley inn where we shall renew our strength and where the morrow's uprising to deeds shall be sweet.",
      "output_sha256": "c4a87c0ef8cc43d71c1557cfd2153415b8fb835772190743d966e1dd2b357ff5",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "c4a87c0ef8cc43d71c1557cfd2153415b8fb835772190743d966e1dd2b357ff5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 55,
      "paragraph_index": 10,
      "origin": "human",
      "text": "I started to write in praise of walking, and I find I have written in praise of Lakeland.",
      "output_sha256": "555ec4c30dfb9029b9cf1615e5bd19d331ecaa8f8ab1ead949440ba8d416b22e",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "555ec4c30dfb9029b9cf1615e5bd19d331ecaa8f8ab1ead949440ba8d416b22e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 10,
      "origin": "human",
      "text": "But indeed the two chants of praise are a single harmony, for I have written in vain if I have not shown that the way to see the most exquisite cabinet of beauties in this land is by the humble path of the pedestrian.",
      "output_sha256": "73533366c55c2e189c966a49767c55e4e875b1fdd5a391a4be3cccfbe176bed5",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "73533366c55c2e189c966a49767c55e4e875b1fdd5a391a4be3cccfbe176bed5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 10,
      "origin": "ai",
      "text": "Those who traverse Lakeland on horseback or in a vehicle miss out on its hidden wonders and the enchantment it holds.",
      "output_sha256": "6306a80deb969187f02e11b86c3c9d32ae79aa94997535164deb4b1bf7c73101",
      "alignment_unit_index": 53,
      "alignment_score": 0.265414,
      "human_sentence_indices": [
        56
      ],
      "human_sha256": [
        "9efddd1ff0506b8d07bac0f62dd81ed70b24409b615d046dab32640d0ccdad07"
      ],
      "source_ai_sentence_index": 60,
      "source_ai_sha256": "6306a80deb969187f02e11b86c3c9d32ae79aa94997535164deb4b1bf7c73101",
      "ai_unit_sentence_indices": [
        60
      ]
    }
  ]
}
