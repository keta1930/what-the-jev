  "mixed_article_sha256": "7b3791c16bbe8b5428d63f0da054b2f0e0c6755e2080344b2b1d1b64afa8fcda",
  "human_source_sentence_count": 59,
  "ai_source_sentence_count": 55,
  "alignment_unit_count": 55,
  "selected_alignment_unit_count": 18,
  "mixed_sentence_count": 62,
  "selected_ai_sentence_count": 21,
  "actual_ai_sentence_ratio": 0.33871,
  "selected_alignment_score_min": 0.251714,
