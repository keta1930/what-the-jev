  "ai_source_sentence_count": 46,
  "alignment_unit_count": 43,
  "selected_alignment_unit_count": 16,
  "mixed_sentence_count": 54,
  "selected_ai_sentence_count": 18,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.281905,
