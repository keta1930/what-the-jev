  "ai_article_sha256": "38698bc084d2246f6133c266e4b8ed4aed0211da1d5840f3ddb456c37e4a3bfc",
  "mixed_article_sha256": "ca43114fffdd52dc196f3baff869e447c906c42df8e2891b9991b971f12ad5bc",
  "human_source_sentence_count": 40,
  "ai_source_sentence_count": 38,
  "alignment_unit_count": 37,
  "selected_alignment_unit_count": 12,
  "mixed_sentence_count": 39,
  "selected_ai_sentence_count": 13,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.273421,
