  "ai_article_sha256": "1b9589e8e801db9ae96eed4a93167954d4b7e338771900b918556968beb27cce",
  "mixed_article_sha256": "d501fcf69d0b075a9f1a4eb611f3cc6c516c8060a56fb8c0b9afde2c1fd6129b",
  "human_source_sentence_count": 63,
  "ai_source_sentence_count": 52,
  "alignment_unit_count": 50,
  "selected_alignment_unit_count": 21,
  "mixed_sentence_count": 63,
  "selected_ai_sentence_count": 21,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.325542,
  "selected_alignment_score_median": 0.461597,
  "selected_alignment_score_max": 0.585776,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "On the first of May I was sitting outside a café in the Place de la Bastille in Paris staring at the exultant column, crowned with a capering figure, which stands in the place where the people destroyed a prison and ended an age.",
      "output_sha256": "970e294375b1d02d3ab24e6d906a82e195e3baa9a5980f2232a5e19f6ce941ae",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "970e294375b1d02d3ab24e6d906a82e195e3baa9a5980f2232a5e19f6ce941ae",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "It serves as a fascinating illustration of how much of human history is steeped in symbolism.",
      "output_sha256": "11af589555409de6a22c9828dd008beae8dbffff285aaace3e010fb02b0caec4",
      "alignment_unit_index": 2,
      "alignment_score": 0.42875,
      "human_sentence_indices": [
        2
      ],
      "human_sha256": [
        "a7ff53bf92a91c7fd90e3203dab1c0e12d1399c21de65cec847da8c6f4ade01d"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "11af589555409de6a22c9828dd008beae8dbffff285aaace3e010fb02b0caec4",
      "ai_unit_sentence_indices": [
        3
      ]
    },
    {
      "sentence_index": 3,
      "paragraph_index": 1,
      "origin": "ai",
      "text": "In terms of physical reality, the Bastille was hardly a dreadful prison when it fell; it was barely a prison at all.",
      "output_sha256": "a6ba848fc732f2ad9b1eadb92c4923a07df653387b07beaa5b51fafdfc0fcbc1",
      "alignment_unit_index": 3,
      "alignment_score": 0.49154,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "7caed271a3f5df2bbd5a0e05a48a866e211b6a6d8309b3b614d08f57bc31f675"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "a6ba848fc732f2ad9b1eadb92c4923a07df653387b07beaa5b51fafdfc0fcbc1",
      "ai_unit_sentence_indices": [
        4
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 1,
      "origin": "human",
      "text": "But it was a symbol, and the people always go by a sure instinct for symbols; for the Chinaman, for instance, at the last General Election, or for President Kruger’s hat in the election before; their poetic sense is perfect.",
      "output_sha256": "aae5e44a235e40b625b88bcfe6f19ebb4751b2382b35000dfd444a85683b561c",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "aae5e44a235e40b625b88bcfe6f19ebb4751b2382b35000dfd444a85683b561c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 5,
      "paragraph_index": 1,
      "origin": "human",
      "text": "The Chinaman with his pigtail is not an idle flippancy.",
      "output_sha256": "4ad1808105834ca1f3b0067e0c6560218594f956862ba3c4ca13b4e7562c8f9e",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 5,
      "source_human_sha256": "4ad1808105834ca1f3b0067e0c6560218594f956862ba3c4ca13b4e7562c8f9e",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 1,
      "origin": "human",
      "text": "He does typify with a compact precision exactly the thing the people resent in African policy, the alien and grotesque nature of the power of wealth, the fact that money has no roots, that it is not a natural and familiar power, but a sort of airy and evil magic calling monsters from the ends of the earth.",
      "output_sha256": "d87bf96bf4691d313773e1bb2c70a6ca3db0c4d47a95339d2e02ca6ab6bd8249",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "d87bf96bf4691d313773e1bb2c70a6ca3db0c4d47a95339d2e02ca6ab6bd8249",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 1,
      "origin": "human",
      "text": "The people hate the mine owner who can bring a Chinaman flying across the sea, exactly as the people hated the wizard who could fetch a flying dragon through the air.",
      "output_sha256": "7b0a3d6923640bea6a93a44b0317ccb1fd649c67056d11a3a06e0db72d4f164c",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 7,
      "source_human_sha256": "7b0a3d6923640bea6a93a44b0317ccb1fd649c67056d11a3a06e0db72d4f164c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It was the same with Mr. Kruger’s hat.",
      "output_sha256": "db45dd08677f4c52132b5e69af8725ea4ce1a2609f7d3059cdb4790074949300",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "db45dd08677f4c52132b5e69af8725ea4ce1a2609f7d3059cdb4790074949300",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 9,
      "paragraph_index": 1,
      "origin": "human",
      "text": "His hat (that admirable hat) was not merely a joke.",
      "output_sha256": "9edb7046fe575c3e221dd7418ff818a3c893c2b728d81f96367402c736329257",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "9edb7046fe575c3e221dd7418ff818a3c893c2b728d81f96367402c736329257",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 1,
      "origin": "human",
      "text": "It did symbolise, and symbolise extremely well, the exact thing which our people at that moment regarded with impatience and venom; the old-fashioned, dingy, Republican simplicity, the unbeautiful dignity of the bourgeois, and the heavier truisms of political morality.",
      "output_sha256": "e3ab1f29eadd47bdc6070f3aecaa4e7a957d7beda83682e84c7669fad5bd06bb",
      "alignment_unit_index": 7,
      "alignment_score": null,
      "source_human_sentence_index": 10,
      "source_human_sha256": "e3ab1f29eadd47bdc6070f3aecaa4e7a957d7beda83682e84c7669fad5bd06bb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 1,
      "origin": "human",
      "text": "No; the people are sometimes wrong on the practical side of politics; they are never wrong on the artistic side.",
      "output_sha256": "3149453f5569171258326a38d695a98fb0927a65eef2ab47bd11b53a0ebd4095",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 11,
      "source_human_sha256": "3149453f5569171258326a38d695a98fb0927a65eef2ab47bd11b53a0ebd4095",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 12,
      "paragraph_index": 2,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 13,
      "paragraph_index": 3,
      "origin": "human",
      "text": "So it was, certainly, with the Bastille.",
      "output_sha256": "060a134c939a32309e684515f3e7d1275bf962b81156171e455f89b939dd4403",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 13,
      "source_human_sha256": "060a134c939a32309e684515f3e7d1275bf962b81156171e455f89b939dd4403",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 14,
      "paragraph_index": 3,
      "origin": "human",
      "text": "The destruction of the Bastille was not a reform; it was something more important than a reform.",
      "output_sha256": "9b5320f63c625f06d42f8deadbe484765345a7180bf2c674b227a41654c766be",
      "alignment_unit_index": 10,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "9b5320f63c625f06d42f8deadbe484765345a7180bf2c674b227a41654c766be",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 3,
      "origin": "human",
      "text": "It was an iconoclasm; it was the breaking of a stone image.",
      "output_sha256": "5e4530c03b0d5a0267105530a8d7cf411acfc9511e3ba69dbc5475f1a66e391a",
      "alignment_unit_index": 10,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "5e4530c03b0d5a0267105530a8d7cf411acfc9511e3ba69dbc5475f1a66e391a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 16,
      "paragraph_index": 3,
      "origin": "human",
      "text": "The people saw the building like a giant looking at them with a score of eyes, and they struck at it as at a carved fact.",
      "output_sha256": "f4f23d9c3a7d7fd03f3e3c4dcdd2d91c23d247a7dcaa67b417d7a75dd70b2332",
      "alignment_unit_index": 11,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "f4f23d9c3a7d7fd03f3e3c4dcdd2d91c23d247a7dcaa67b417d7a75dd70b2332",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Of all the various manifestations of the enormous illusion known as materialism that can terrify the human spirit, few are as stifling as imposing edifices.",
      "output_sha256": "0891d4a2ca962a7fb9fcb10a10bc88b2e0c6ec3c22181cd6f7ba163dfaabe590",
      "alignment_unit_index": 12,
      "alignment_score": 0.3965,
      "human_sentence_indices": [
        17
      ],
      "human_sha256": [
        "2d504e17f26b944d514a8e9f73e14b3e936865d2b8e3edbb5651cfbbf34ec5b5"
      ],
      "source_ai_sentence_index": 14,
      "source_ai_sha256": "0891d4a2ca962a7fb9fcb10a10bc88b2e0c6ec3c22181cd6f7ba163dfaabe590",
      "ai_unit_sentence_indices": [
        14
      ]
    },
    {
      "sentence_index": 18,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Individuals can feel insignificant, like a mere fly in the web of something they themselves have constructed.",
      "output_sha256": "2b9290e5b0129b57b2dbb6dfca9260bf95c75619c029094b06dbcad72b0ddfe8",
      "alignment_unit_index": 13,
      "alignment_score": 0.345161,
      "human_sentence_indices": [
        18
      ],
      "human_sha256": [
        "b28713e6a964f90fa622e19ab40605866f08376991b35811564f39686582a433"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "2b9290e5b0129b57b2dbb6dfca9260bf95c75619c029094b06dbcad72b0ddfe8",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 19,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "It takes a monumental effort of the spirit to remember that humans created this daunting structure and that they possess the power to dismantle it.",
      "output_sha256": "2f09115e738eb1cc39555f1e4bac3a759ac6865ff9059a80cb0321d0f7feb75d",
      "alignment_unit_index": 14,
      "alignment_score": 0.497783,
      "human_sentence_indices": [
        19
      ],
      "human_sha256": [
        "de30834251a031498097a4ca45d9f50c2ff35ca19c3f9b76771825d5c5e5c5fb"
      ],
      "source_ai_sentence_index": 16,
      "source_ai_sha256": "2f09115e738eb1cc39555f1e4bac3a759ac6865ff9059a80cb0321d0f7feb75d",
      "ai_unit_sentence_indices": [
        16
      ]
    },
    {
      "sentence_index": 20,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Thus, the very action of the ragged citizens in the streets taking down a colossal public building carries a spiritual, almost ritualistic significance that far exceeds its immediate political implications.",
      "output_sha256": "1aa75d5680509db977885c6430b9d9112a233993a91006087eb560bc25368ab2",
      "alignment_unit_index": 15,
      "alignment_score": 0.515,
      "human_sentence_indices": [
        20
      ],
      "human_sha256": [
        "cf75db841f1bce2d4815dc3d4d6a72cede7a335c9eabc977c0bc6f5c1e932b49"
      ],
      "source_ai_sentence_index": 17,
      "source_ai_sha256": "1aa75d5680509db977885c6430b9d9112a233993a91006087eb560bc25368ab2",
      "ai_unit_sentence_indices": [
        17
      ]
    },
    {
      "sentence_index": 21,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "It resembles a sacred observance.",
      "output_sha256": "76c7df6101c911c76c7c75cd78cd8850b055f12baa6e2c911ac14ee60e152084",
      "alignment_unit_index": 16,
      "alignment_score": 0.43,
      "human_sentence_indices": [
        21
      ],
      "human_sha256": [
        "4c3e0b0066a7dc3bb83cdfd0a2be02668a4903370f903516fa18cbabfbbfa492"
      ],
      "source_ai_sentence_index": 18,
      "source_ai_sha256": "76c7df6101c911c76c7c75cd78cd8850b055f12baa6e2c911ac14ee60e152084",
      "ai_unit_sentence_indices": [
        18
      ]
    },
    {
      "sentence_index": 22,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "For instance, if Socialists were bold enough to seize and demolish the Bank of England, one could endlessly debate the futility of such an act and how it may not directly address the core economic issues.",
      "output_sha256": "46af3580ee2e282de1b820f1af1deacca68830b603e9556257347426b38caa4e",
      "alignment_unit_index": 17,
      "alignment_score": 0.461597,
      "human_sentence_indices": [
        22
      ],
      "human_sha256": [
        "d7d7590ebe04eeeb18165c8fc59cb700c96397a6b7b8a75c60dbb31c0021797e"
      ],
      "source_ai_sentence_index": 19,
      "source_ai_sha256": "46af3580ee2e282de1b820f1af1deacca68830b603e9556257347426b38caa4e",
      "ai_unit_sentence_indices": [
        19
      ]
    },
    {
      "sentence_index": 23,
      "paragraph_index": 3,
      "origin": "human",
      "text": "But mankind would never forget it.",
      "output_sha256": "251517d4cbc4d422fa0c78fa4ae0fa11e75ad96325da164fbd4a3427d87ac60d",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 23,
      "source_human_sha256": "251517d4cbc4d422fa0c78fa4ae0fa11e75ad96325da164fbd4a3427d87ac60d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 3,
      "origin": "human",
      "text": "It would change the world.",
      "output_sha256": "c2972d2debcc3dd333310734392ccef82fb704910865e9fe49560b5f75d06bee",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "c2972d2debcc3dd333310734392ccef82fb704910865e9fe49560b5f75d06bee",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Architecture serves as a reliable gauge of the true resilience of a society since the most treasured aspects of a community are those that are irrevocable—marriage, for instance.",
      "output_sha256": "a47151e8b95fee058dfc1db1029d83d7cb90342c60f9466d26b84aff7b9d9d8b",
      "alignment_unit_index": 19,
      "alignment_score": 0.585776,
      "human_sentence_indices": [
        25
      ],
      "human_sha256": [
        "cf8ce12792ff1c2f3939932b7da5bb97d11523426f81329e977358a47565769d"
      ],
      "source_ai_sentence_index": 21,
      "source_ai_sha256": "a47151e8b95fee058dfc1db1029d83d7cb90342c60f9466d26b84aff7b9d9d8b",
      "ai_unit_sentence_indices": [
        21
      ]
    },
    {
      "sentence_index": 26,
      "paragraph_index": 4,
      "origin": "human",
      "text": "And architecture approaches nearer than any other art to being irrevocable, because it is so difficult to get rid of.",
      "output_sha256": "2c598b127d21d59bea3df49ffcd9783967bd7828edd50352a58f1a434d855053",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "2c598b127d21d59bea3df49ffcd9783967bd7828edd50352a58f1a434d855053",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 27,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You can turn a picture with its face to the wall; it would be a nuisance to turn that Roman cathedral with its face to the wall.",
      "output_sha256": "288f47d40967f206322d159c31739deeb8790ac8ceee80480573a1ea2627a672",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "288f47d40967f206322d159c31739deeb8790ac8ceee80480573a1ea2627a672",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You can tear a poem to pieces; it is only in moments of very sincere emotion that you tear a town-hall to pieces.",
      "output_sha256": "7e599c88e19c597cb63297b5ed36089de5c9af60cf322d9d58853f17a74c5166",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 28,
      "source_human_sha256": "7e599c88e19c597cb63297b5ed36089de5c9af60cf322d9d58853f17a74c5166",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 4,
      "origin": "human",
      "text": "A building is akin to dogma; it is insolent, like a dogma.",
      "output_sha256": "bb84ba0b56b1465b16cba97707b152af26e171d4753c66b4bd0207681d345bb0",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "bb84ba0b56b1465b16cba97707b152af26e171d4753c66b4bd0207681d345bb0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 4,
      "origin": "human",
      "text": "Whether or no it is permanent, it claims permanence like a dogma.",
      "output_sha256": "e965014ef7a8203daa5304bc4d90ceb0140cd6eabe066eb6fd0923a753e2f6e1",
      "alignment_unit_index": 23,
      "alignment_score": null,
      "source_human_sentence_index": 30,
      "source_human_sha256": "e965014ef7a8203daa5304bc4d90ceb0140cd6eabe066eb6fd0923a753e2f6e1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "People often ponder why modern society lacks a distinctive architectural style akin to Impressionism in painting.",
      "output_sha256": "2ce7cc382a7af0f01d6b11851d0efb6e439571752fd654ebc092cc4dc3191576",
      "alignment_unit_index": 24,
      "alignment_score": 0.472697,
      "human_sentence_indices": [
        31
      ],
      "human_sha256": [
        "377de3e3b193dde4395b1f755841afbf27179514134ccf9c30a1a2176fef263f"
      ],
      "source_ai_sentence_index": 26,
      "source_ai_sha256": "2ce7cc382a7af0f01d6b11851d0efb6e439571752fd654ebc092cc4dc3191576",
      "ai_unit_sentence_indices": [
        26
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "The answer is evident: we simply do not possess enough dogmas; we are unable to accept anything in the heavens that is solid and enduring, anything that does not shift like the clouds.",
      "output_sha256": "d2085cc793f2f33fb74c0181cef9d545a8b9fc3db278dea7ef62a9ce20046be3",
      "alignment_unit_index": 25,
      "alignment_score": 0.548557,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "225342ab5f54858d0131810ee7a1284f64d85124631d7905a9bd24fb20527703"
      ],
      "source_ai_sentence_index": 27,
      "source_ai_sha256": "d2085cc793f2f33fb74c0181cef9d545a8b9fc3db278dea7ef62a9ce20046be3",
      "ai_unit_sentence_indices": [
        27
      ]
    },
    {
      "sentence_index": 33,
      "paragraph_index": 4,
      "origin": "human",
      "text": "But along with this decision which is involved in creating a building, there goes a quite similar decision in the more delightful task of smashing one.",
      "output_sha256": "bca29a4ec24edb64870a287c449b5720773cea7f16ec327da70bb9abc5210581",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "bca29a4ec24edb64870a287c449b5720773cea7f16ec327da70bb9abc5210581",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 34,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "The two actions are intrinsically linked.",
      "output_sha256": "acdc6441e9eaa7aa0f63460c16a03688c84ff0a9deb46102b332260b0859e538",
      "alignment_unit_index": 27,
      "alignment_score": 0.442857,
      "human_sentence_indices": [
        34
      ],
      "human_sha256": [
        "e8f180cbbe3afe0e93dae19cbe83208c56255a1f048e95f98e684396bfc24dc3"
      ],
      "source_ai_sentence_index": 29,
      "source_ai_sha256": "acdc6441e9eaa7aa0f63460c16a03688c84ff0a9deb46102b332260b0859e538",
      "ai_unit_sentence_indices": [
        29
      ]
    },
    {
      "sentence_index": 35,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Few cities have witnessed the construction of as many remarkable public buildings as Paris, nor have so many been dismantled.",
      "output_sha256": "8a95e106c12578ae6f1979dce683149b4278667260833eda9f2f1452eb809157",
      "alignment_unit_index": 28,
      "alignment_score": 0.484902,
      "human_sentence_indices": [
        35
      ],
      "human_sha256": [
        "2e32e5533782cf556814bbe45d75382ae8173dd0cb0dcfa939209009f24d46f7"
      ],
      "source_ai_sentence_index": 30,
      "source_ai_sha256": "8a95e106c12578ae6f1979dce683149b4278667260833eda9f2f1452eb809157",
      "ai_unit_sentence_indices": [
        30
      ]
    },
    {
      "sentence_index": 36,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "When people fall into the unfortunate habit of preserving structures, they often lose the inclination to create new ones.",
      "output_sha256": "07fad5f8ae7e5fdc684f7e7470e5ffed4b587952aba6e51e2116afba5e73aa8b",
      "alignment_unit_index": 29,
      "alignment_score": 0.495288,
      "human_sentence_indices": [
        36
      ],
      "human_sha256": [
        "cfe2170f0bd1ea4df3883cce09e171c83a2d4425e1533e0a78a4126e54fe8f36"
      ],
      "source_ai_sentence_index": 31,
      "source_ai_sha256": "07fad5f8ae7e5fdc684f7e7470e5ffed4b587952aba6e51e2116afba5e73aa8b",
      "ai_unit_sentence_indices": [
        31
      ]
    },
    {
      "sentence_index": 37,
      "paragraph_index": 4,
      "origin": "human",
      "text": "And in London one mingles, as it were, one’s tears because so few are pulled down.",
      "output_sha256": "4ec2bb26588b02748e0dad1541ba5aa413f117ee5ae7497f59211425d61842f2",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "4ec2bb26588b02748e0dad1541ba5aa413f117ee5ae7497f59211425d61842f2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 5,
      "origin": "human",
      "text": ".....",
      "output_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "alignment_unit_index": 30,
      "alignment_score": null,
      "source_human_sentence_index": 38,
      "source_human_sha256": "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 6,
      "origin": "human",
      "text": "As I sat staring at the column of the Bastille, inscribed to Liberty and Glory, there came out of one corner of the square (which, like so many such squares, was at once crowded and quiet) a sudden and silent line of horsemen.",
      "output_sha256": "b85128c0758027ddaefa714042e162e5525037cfad8307a736ea2a6052411c8b",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "b85128c0758027ddaefa714042e162e5525037cfad8307a736ea2a6052411c8b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Their dress was of a dull blue, plain and prosaic enough, but the sun set on fire the brass and steel of their helmets; and their helmets were carved like the helmets of the Romans.",
      "output_sha256": "7eaf18a264131872dd7999c22da8c57dca5187f3b361a6745381e590a6ee0869",
      "alignment_unit_index": 32,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "7eaf18a264131872dd7999c22da8c57dca5187f3b361a6745381e590a6ee0869",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I had seen them by twos and threes often enough before.",
      "output_sha256": "02cb2ffa44e87d96c0b1cd422ec856bc310696ec9ccbc93b1650ed3b977974ef",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "02cb2ffa44e87d96c0b1cd422ec856bc310696ec9ccbc93b1650ed3b977974ef",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 42,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I had seen plenty of them in pictures toiling through the snows of Friedland or roaring round the squares at Waterloo.",
      "output_sha256": "a94f5d85029e9eac8f8f4b27c3fc6f71c43117b862dde67b6e57a6914ec8a1ca",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 42,
      "source_human_sha256": "a94f5d85029e9eac8f8f4b27c3fc6f71c43117b862dde67b6e57a6914ec8a1ca",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 43,
      "paragraph_index": 6,
      "origin": "human",
      "text": "But now they came file after file, like an invasion, and something in their numbers, or in the evening light that lit up their faces and their crests, or something in the reverie into which they broke, made me inclined to spring to my feet and cry out, “The French soldiers!”",
      "output_sha256": "84dd3e14fa0f1052e0d9830c8a7475a76972236c94b6fde50a6f513285e77f26",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 43,
      "source_human_sha256": "84dd3e14fa0f1052e0d9830c8a7475a76972236c94b6fde50a6f513285e77f26",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 6,
      "origin": "human",
      "text": "There were the little men with the brown faces that had so often ridden through the capitals of Europe as coolly as they now rode through their own.",
      "output_sha256": "3765ec9a656fb88776e4afaeafa56d042221d5186f6eda0cc9e83f92d1164bf5",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 44,
      "source_human_sha256": "3765ec9a656fb88776e4afaeafa56d042221d5186f6eda0cc9e83f92d1164bf5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 6,
      "origin": "human",
      "text": "And when I looked across the square I saw that the two other corners were choked with blue and red; held by little groups of infantry.",
      "output_sha256": "c5eb14db52317f3557ff1588a7ec309ec06f9241d6dd7ddf710ec07fa79d7d62",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 45,
      "source_human_sha256": "c5eb14db52317f3557ff1588a7ec309ec06f9241d6dd7ddf710ec07fa79d7d62",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The city was garrisoned as against a revolution.",
      "output_sha256": "8619f96a0ae745198fd7c79c5bd2b714ad6493770129c5d32c46c52d916c2183",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "8619f96a0ae745198fd7c79c5bd2b714ad6493770129c5d32c46c52d916c2183",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 47,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Naturally, I was aware of the ongoing strike, primarily from a baker who shared his thoughts with me.",
      "output_sha256": "a31e25954246a6dd542638c2d3c94195a2b9e63355050e918a5cbcaf6808c8d0",
      "alignment_unit_index": 37,
      "alignment_score": 0.364792,
      "human_sentence_indices": [
        47
      ],
      "human_sha256": [
        "ee1592f41d570ac9f0788b066a342bae5ecb92e75e691d6b98dc110b28f91576"
      ],
      "source_ai_sentence_index": 39,
      "source_ai_sha256": "a31e25954246a6dd542638c2d3c94195a2b9e63355050e918a5cbcaf6808c8d0",
      "ai_unit_sentence_indices": [
        39
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He said he was not going to “Chomer.”",
      "output_sha256": "303e15b6a9bfadd9c0c9e0af2d0f99c8e6aa6009478f09ccc16d4210dd875657",
      "alignment_unit_index": 38,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "303e15b6a9bfadd9c0c9e0af2d0f99c8e6aa6009478f09ccc16d4210dd875657",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 49,
      "paragraph_index": 7,
      "origin": "human",
      "text": "I said, “Qu’est-ce que c’est que le chome?”",
      "output_sha256": "dae6736e79e010a22a33876e73e6c94267c38e4e726be115e4f3f7c76d206469",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 49,
      "source_human_sha256": "dae6736e79e010a22a33876e73e6c94267c38e4e726be115e4f3f7c76d206469",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 50,
      "paragraph_index": 7,
      "origin": "human",
      "text": "He said, “Ils ne veulent pas travailler.”",
      "output_sha256": "fe554ad2af3a9123c19f44d2819dc5da715c4f2c060abaebc3bbb0ef80bcb5a6",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 50,
      "source_human_sha256": "fe554ad2af3a9123c19f44d2819dc5da715c4f2c060abaebc3bbb0ef80bcb5a6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "I replied, “Neither do I,” which led him to perceive me as a class-conscious, collectivist member of the proletariat.",
      "output_sha256": "c29eea86ddbf2e4bbd6ff38eadf4f43bd42cfd4b415971e4ae43a965608c4495",
      "alignment_unit_index": 40,
      "alignment_score": 0.325542,
      "human_sentence_indices": [
        51
      ],
      "human_sha256": [
        "d016457f48cc6d632a97e07475ac08cb0c339b26c70d4dc1e8b3494a382f0d80"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "c29eea86ddbf2e4bbd6ff38eadf4f43bd42cfd4b415971e4ae43a965608c4495",
      "ai_unit_sentence_indices": [
        42
      ]
    },
    {
      "sentence_index": 52,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "The situation was intriguing, and the underlying lesson from it was not easily grasped by us as a nation, as our own shortcomings lie in an entirely different direction.",
      "output_sha256": "56bba1a39833e2898fde4aea59c60e5fb306f8a0d6c0638822f3fb3fd12f58fc",
      "alignment_unit_index": 41,
      "alignment_score": 0.465033,
      "human_sentence_indices": [
        52
      ],
      "human_sha256": [
        "836188ad32b4f9e87bf98ab934c425e1ed962d2efcc933fe41989a9d35cd6abf"
      ],
      "source_ai_sentence_index": 43,
      "source_ai_sha256": "56bba1a39833e2898fde4aea59c60e5fb306f8a0d6c0638822f3fb3fd12f58fc",
      "ai_unit_sentence_indices": [
        43
      ]
    },
    {
      "sentence_index": 53,
      "paragraph_index": 7,
      "origin": "human",
      "text": "To me, as an Englishman (personally steeped in the English optimism and the English dislike of severity), the whole thing seemed a fuss about nothing.",
      "output_sha256": "b5a511a5b6a0ce8ff4428aae2a5f4ca7673e3c7bf40bb0bf895f1bc9eb0b2aad",
      "alignment_unit_index": 42,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "b5a511a5b6a0ce8ff4428aae2a5f4ca7673e3c7bf40bb0bf895f1bc9eb0b2aad",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 54,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "It appeared to me as though a top-tier army in Europe was being mobilized against ordinary citizens merely going about their day.",
      "output_sha256": "ef8d36a9517544027e6a461ce4a76ca917035e1287c17f4ce79598ee177bfb6e",
      "alignment_unit_index": 43,
      "alignment_score": 0.404435,
      "human_sentence_indices": [
        54
      ],
      "human_sha256": [
        "1aa095585ff1ef190cc7fc0301a2db82dcd84f6497fd07fb283f597170467d30"
      ],
      "source_ai_sentence_index": 45,
      "source_ai_sha256": "ef8d36a9517544027e6a461ce4a76ca917035e1287c17f4ce79598ee177bfb6e",
      "ai_unit_sentence_indices": [
        45
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "The cavalry charged at us a couple of times, but to little effect.",
      "output_sha256": "531b6f968865bf0bace8e95a423eb7dbcd1af1917982cb142c2355dc590d1bf6",
      "alignment_unit_index": 44,
      "alignment_score": 0.444231,
      "human_sentence_indices": [
        55
      ],
      "human_sha256": [
        "32404d846b3174ca292d9089897e85a026a214e7f53d625b5e2c9ce8763fd09e"
      ],
      "source_ai_sentence_index": 46,
      "source_ai_sha256": "531b6f968865bf0bace8e95a423eb7dbcd1af1917982cb142c2355dc590d1bf6",
      "ai_unit_sentence_indices": [
        46
      ]
    },
    {
      "sentence_index": 56,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "Yet, the challenge lies in recognizing how far my criticisms might stem from an erroneous assumption of the French populace being as compliant as the English.",
      "output_sha256": "97fb4418f7ecfb1719376d1aaac293d5778b1c94adaa1ae5de68bd1474c2ca83",
      "alignment_unit_index": 45,
      "alignment_score": 0.434048,
      "human_sentence_indices": [
        56
      ],
      "human_sha256": [
        "c93b4217dacc126f9dc18db3d4e45e3867d153de6023e715cec9df580202ce99"
      ],
      "source_ai_sentence_index": 47,
      "source_ai_sha256": "97fb4418f7ecfb1719376d1aaac293d5778b1c94adaa1ae5de68bd1474c2ca83",
      "ai_unit_sentence_indices": [
        47
      ]
    },
    {
      "sentence_index": 57,
      "paragraph_index": 7,
      "origin": "human",
      "text": "But the deeper truth of the matter tingled, so to speak, through the whole noisy night.",
      "output_sha256": "926bc2a0cbce7a2b56279a0ea430d006b5c0e9ebbda2e4e690b1efdb4baa05d2",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 57,
      "source_human_sha256": "926bc2a0cbce7a2b56279a0ea430d006b5c0e9ebbda2e4e690b1efdb4baa05d2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "This nation possesses an inherent ability to sense when it stands on the brink of something significant—be it the Bartholomew, the Revolution, the Commune, or even Judgment Day.",
      "output_sha256": "7afdf89442bb6b84a310fc68cfcf90c5175d51073e232f113f155adf514d7bd8",
      "alignment_unit_index": 47,
      "alignment_score": 0.530185,
      "human_sentence_indices": [
        58
      ],
      "human_sha256": [
        "29efa1c2125e97a56b6ff694309b12cfdf0e41d0a194e877f2566968374acbc4"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "7afdf89442bb6b84a310fc68cfcf90c5175d51073e232f113f155adf514d7bd8",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 59,
      "paragraph_index": 7,
      "origin": "human",
      "text": "It is this sense of crisis that makes France eternally young.",
      "output_sha256": "463ca86e14248ada2d25d9f2d1f52aaced4806b197dece0d21181c72dcc20ad3",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 59,
      "source_human_sha256": "463ca86e14248ada2d25d9f2d1f52aaced4806b197dece0d21181c72dcc20ad3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 7,
      "origin": "human",
      "text": "It is perpetually pulling down and building up, as it pulled down the prison and put up the column in the Place de La Bastille.",
      "output_sha256": "1dcf4415f4745a72581fbf19c39761003fd19f546f751a2739b287fb9ce1042b",
      "alignment_unit_index": 49,
      "alignment_score": null,
      "source_human_sentence_index": 60,
      "source_human_sha256": "1dcf4415f4745a72581fbf19c39761003fd19f546f751a2739b287fb9ce1042b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 61,
      "paragraph_index": 7,
      "origin": "human",
      "text": "France has always been at the point of dissolution.",
      "output_sha256": "e375e9cbe704acf051a03eeb8d06d44e8ec2719cf975efb77903c8a04217bc21",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 61,
      "source_human_sha256": "e375e9cbe704acf051a03eeb8d06d44e8ec2719cf975efb77903c8a04217bc21",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 62,
      "paragraph_index": 7,
      "origin": "human",
      "text": "She has found the only method of immortality.",
      "output_sha256": "25183c956e5ba12d58b48f2c547cbc9dc55766b6bf95226f543158faa384bf06",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 62,
      "source_human_sha256": "25183c956e5ba12d58b48f2c547cbc9dc55766b6bf95226f543158faa384bf06",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 63,
      "paragraph_index": 7,
      "origin": "human",
      "text": "She dies daily.",
      "output_sha256": "415fbc7d60eac177511663dbd2999cc937edf7f1f0b5957342bc2a07b3655803",
      "alignment_unit_index": 50,
      "alignment_score": null,
      "source_human_sentence_index": 63,
      "source_human_sha256": "415fbc7d60eac177511663dbd2999cc937edf7f1f0b5957342bc2a07b3655803",
      "ai_unit_sentence_indices": []
    }
  ]
}
