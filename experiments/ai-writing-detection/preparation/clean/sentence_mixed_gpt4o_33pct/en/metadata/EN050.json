  "ai_article_sha256": "0ce9f9230fed28f26eccad2c3e3488acd0559b3565ff8b216098cd8d512b05ce",
  "mixed_article_sha256": "72db4119ba30150bd4260a189df054adfe133a2f88468997b811a8984558d88b",
  "human_source_sentence_count": 56,
  "ai_source_sentence_count": 61,
  "alignment_unit_count": 56,
  "selected_alignment_unit_count": 16,
  "mixed_sentence_count": 60,
  "selected_ai_sentence_count": 20,
  "actual_ai_sentence_ratio": 0.333333,
  "selected_alignment_score_min": 0.256615,
  "selected_alignment_score_median": 0.532367,
  "selected_alignment_score_max": 0.9025,
  "segments": [
    {
      "sentence_index": 1,
      "paragraph_index": 1,
      "origin": "human",
      "text": "After fighting against bondage for years I am now a slave: I have a telephone.",
      "output_sha256": "1b04c22bec9b46cd8b5d3e330fd058239aa8d7706643cb5c5b4603cd3336271d",
      "alignment_unit_index": 1,
      "alignment_score": null,
      "source_human_sentence_index": 1,
      "source_human_sha256": "1b04c22bec9b46cd8b5d3e330fd058239aa8d7706643cb5c5b4603cd3336271d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 2,
      "paragraph_index": 2,
      "origin": "human",
      "text": "Although the advantages are many, it means that I have lost the purest and rarest of life's pleasures—which was to ring up from a three-pence-in-the-slot call-office (as I continually had to do) and not be asked for the money.",
      "output_sha256": "6306a159b5f618217f253ad05e9f707fe24cf7681436073dc76f9340c2971fcd",
      "alignment_unit_index": 2,
      "alignment_score": null,
      "source_human_sentence_index": 2,
      "source_human_sha256": "6306a159b5f618217f253ad05e9f707fe24cf7681436073dc76f9340c2971fcd",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 3,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Over the years, this extraordinary occurrence has happened to me only twice.",
      "output_sha256": "19c71403ec9aed672548ef00be4d56d171b50a57e520d3e651a616599b1bbb31",
      "alignment_unit_index": 3,
      "alignment_score": 0.449942,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "4138246a4bc95d54216bcedce749fc0793562f5f81a840a1c240aa9fe6eba203"
      ],
      "source_ai_sentence_index": 3,
      "source_ai_sha256": "19c71403ec9aed672548ef00be4d56d171b50a57e520d3e651a616599b1bbb31",
      "ai_unit_sentence_indices": [
        3,
        4
      ]
    },
    {
      "sentence_index": 4,
      "paragraph_index": 2,
      "origin": "ai",
      "text": "Just last week, I encountered a wealthy man, typically somber in demeanor, whose face lit up with a triumphant grin as he recounted that it had also occurred to him recently.",
      "output_sha256": "122bc186c60b7cd039c18032ae3936725966cc461f0b65b4fa360fd4a710081c",
      "alignment_unit_index": 3,
      "alignment_score": 0.449942,
      "human_sentence_indices": [
        3
      ],
      "human_sha256": [
        "4138246a4bc95d54216bcedce749fc0793562f5f81a840a1c240aa9fe6eba203"
      ],
      "source_ai_sentence_index": 4,
      "source_ai_sha256": "122bc186c60b7cd039c18032ae3936725966cc461f0b65b4fa360fd4a710081c",
      "ai_unit_sentence_indices": [
        3,
        4
      ]
    },
    {
      "sentence_index": 5,
      "paragraph_index": 3,
      "origin": "human",
      "text": "On the other hand, through having a telephone of my own I now escape one of the commonest and most tiresome of life's irritations—which is to wait outside one of these call-offices while the person inside is carrying on a conversation that is not only unnecessary and frivolous, but unending.",
      "output_sha256": "3fdd3e6e339246bf252c528699efb3ee9aca58f48685d50433e7d26fa855fae3",
      "alignment_unit_index": 4,
      "alignment_score": null,
      "source_human_sentence_index": 4,
      "source_human_sha256": "3fdd3e6e339246bf252c528699efb3ee9aca58f48685d50433e7d26fa855fae3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 6,
      "paragraph_index": 3,
      "origin": "human",
      "text": "In London these offices are used both by men and women; but in the suburbs by women only, who may be thought to be romantically engaged but really are reminding their husbands not to forget the fish.",
      "output_sha256": "cac38a3edf913e134260db30c2c543ad4418fe2bfce6b45272f02fe1aacb411a",
      "alignment_unit_index": 5,
      "alignment_score": null,
      "source_human_sentence_index": 5,
      "source_human_sha256": "cac38a3edf913e134260db30c2c543ad4418fe2bfce6b45272f02fe1aacb411a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 7,
      "paragraph_index": 3,
      "origin": "human",
      "text": "The possession of a telephone of one's own, however, does not, in an imperfect world, put an end to the ordeal of waiting.",
      "output_sha256": "0da54c5133affe57e5f27ebbd8c5f17706767f8ab0d11b1e13074a13478f2c1c",
      "alignment_unit_index": 6,
      "alignment_score": null,
      "source_human_sentence_index": 6,
      "source_human_sha256": "0da54c5133affe57e5f27ebbd8c5f17706767f8ab0d11b1e13074a13478f2c1c",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 8,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "If a fairy godmother were to appear before me—though, after all these years, I am not particularly optimistic about such an occurrence—and grant me a wish, I would deliberate long before settling on anything more significant than reclaiming all the time I’ve wasted with the telephone pressed to my ear, awaiting a response.",
      "output_sha256": "c877a31271ca5047a8862abe05afb0097357fd87d5e0b12e010b32bfad3afa55",
      "alignment_unit_index": 7,
      "alignment_score": 0.493059,
      "human_sentence_indices": [
        7
      ],
      "human_sha256": [
        "e89f0483b091da68b9439edd56aa57a643593b3187463292dc42cd18fd1ff339"
      ],
      "source_ai_sentence_index": 8,
      "source_ai_sha256": "c877a31271ca5047a8862abe05afb0097357fd87d5e0b12e010b32bfad3afa55",
      "ai_unit_sentence_indices": [
        8
      ]
    },
    {
      "sentence_index": 9,
      "paragraph_index": 3,
      "origin": "human",
      "text": "The ordinary delays can be long enough, but for true foretastes of eternity you must sit at the instrument while some one is being fetched from a distant part of the building.",
      "output_sha256": "47e5573641d220f0588a7c344777dca182e7410219e0379cee9bc082ed8d6a19",
      "alignment_unit_index": 8,
      "alignment_score": null,
      "source_human_sentence_index": 8,
      "source_human_sha256": "47e5573641d220f0588a7c344777dca182e7410219e0379cee9bc082ed8d6a19",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 10,
      "paragraph_index": 3,
      "origin": "human",
      "text": "This is a foretaste not only of eternity but of perdition, for there is nothing to do; and to have nothing to do is to be damned.",
      "output_sha256": "1fce5766be63db910170e69d269811f4edeae6193a4e8edcecf0164c13ef6e92",
      "alignment_unit_index": 9,
      "alignment_score": null,
      "source_human_sentence_index": 9,
      "source_human_sha256": "1fce5766be63db910170e69d269811f4edeae6193a4e8edcecf0164c13ef6e92",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 11,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "When left to idle, time drags on interminably.",
      "output_sha256": "e726c202a07f2deb4daaa8e7569a778e7afb02c5fb54010f0b5f6181b9ff1831",
      "alignment_unit_index": 10,
      "alignment_score": 0.377771,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "20af78717829fa123de6c415a1c0d68bec68359f262b88dfeebf0f94ca5ff469"
      ],
      "source_ai_sentence_index": 11,
      "source_ai_sha256": "e726c202a07f2deb4daaa8e7569a778e7afb02c5fb54010f0b5f6181b9ff1831",
      "ai_unit_sentence_indices": [
        11,
        12
      ]
    },
    {
      "sentence_index": 12,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "Even if a book happens to be at hand, reading is impossible as one’s thoughts cannot wander freely; all that occupies the mind is the anxious speculation about the messenger's progress, the current activity of the person being sought, and the potential journey they are undertaking to reach the receiver.",
      "output_sha256": "67712a991bf72f1d9b79847d4da286aa9b6196d99d54ec58411cb1246ffe26d8",
      "alignment_unit_index": 10,
      "alignment_score": 0.377771,
      "human_sentence_indices": [
        10
      ],
      "human_sha256": [
        "20af78717829fa123de6c415a1c0d68bec68359f262b88dfeebf0f94ca5ff469"
      ],
      "source_ai_sentence_index": 12,
      "source_ai_sha256": "67712a991bf72f1d9b79847d4da286aa9b6196d99d54ec58411cb1246ffe26d8",
      "ai_unit_sentence_indices": [
        11,
        12
      ]
    },
    {
      "sentence_index": 13,
      "paragraph_index": 3,
      "origin": "ai",
      "text": "In this preoccupation, minutes, hours, days, and even weeks appear to stretch out in reluctant agony.",
      "output_sha256": "278da08bb9cc1a5031ca60bd0c284022471fc947c0fc87e672f4437ff5b408e1",
      "alignment_unit_index": 11,
      "alignment_score": 0.582258,
      "human_sentence_indices": [
        11
      ],
      "human_sha256": [
        "2f9d0486ab30c3e22fa6cbe0d14529383d1153f3c634bf882e7b92eb91482753"
      ],
      "source_ai_sentence_index": 13,
      "source_ai_sha256": "278da08bb9cc1a5031ca60bd0c284022471fc947c0fc87e672f4437ff5b408e1",
      "ai_unit_sentence_indices": [
        13
      ]
    },
    {
      "sentence_index": 14,
      "paragraph_index": 4,
      "origin": "human",
      "text": "You can imagine also the attitude of the person who is sent for.",
      "output_sha256": "4c93c80b12c50eed0c582c9a8b4ccc6d5dcf903a146f8684a13ab3a410baf6f7",
      "alignment_unit_index": 12,
      "alignment_score": null,
      "source_human_sentence_index": 12,
      "source_human_sha256": "4c93c80b12c50eed0c582c9a8b4ccc6d5dcf903a146f8684a13ab3a410baf6f7",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 15,
      "paragraph_index": 4,
      "origin": "ai",
      "text": "Despite the telephone's ubiquity, it remains steeped in an air of formality.",
      "output_sha256": "83cb63e40f20205d84cc0d12ba56628fd8cdeba5aa70897f1c388daf1b200d0b",
      "alignment_unit_index": 13,
      "alignment_score": 0.256615,
      "human_sentence_indices": [
        13
      ],
      "human_sha256": [
        "bfaa19b3e7c1a7c1e3287cd33feccddb1d22524268e60c801ba0239298891c25"
      ],
      "source_ai_sentence_index": 15,
      "source_ai_sha256": "83cb63e40f20205d84cc0d12ba56628fd8cdeba5aa70897f1c388daf1b200d0b",
      "ai_unit_sentence_indices": [
        15
      ]
    },
    {
      "sentence_index": 16,
      "paragraph_index": 4,
      "origin": "human",
      "text": "At any rate, I notice that men called to it by page boys in restaurants and hotels have a special gait of importance proper to the occasion.",
      "output_sha256": "7b97ecbed98aca0325744054aa74cc3f0032334f17bca5f24f339a3d6e01572a",
      "alignment_unit_index": 14,
      "alignment_score": null,
      "source_human_sentence_index": 14,
      "source_human_sha256": "7b97ecbed98aca0325744054aa74cc3f0032334f17bca5f24f339a3d6e01572a",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 17,
      "paragraph_index": 5,
      "origin": "human",
      "text": "The possession of a telephone no doubt now and then simplifies life; but its complications are too many, even if you adopt the sound rule to be more rung against than ringing.",
      "output_sha256": "27337fbc19ee818a012b40e52543224ca28d4114f28c005d6fd5ea8f423db7dc",
      "alignment_unit_index": 15,
      "alignment_score": null,
      "source_human_sentence_index": 15,
      "source_human_sha256": "27337fbc19ee818a012b40e52543224ca28d4114f28c005d6fd5ea8f423db7dc",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 18,
      "paragraph_index": 5,
      "origin": "human",
      "text": "One of them is the perplexity incident to delays and misunderstandings, and, above all, as to the constitution of Exchanges.",
      "output_sha256": "369456d971e182fc541e8db1b8f512d426ac95793e7cd4e5ad4d322bf7629d74",
      "alignment_unit_index": 16,
      "alignment_score": null,
      "source_human_sentence_index": 16,
      "source_human_sha256": "369456d971e182fc541e8db1b8f512d426ac95793e7cd4e5ad4d322bf7629d74",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 19,
      "paragraph_index": 5,
      "origin": "human",
      "text": "We all, I suppose, have our own idea as to what they are like; there must at one time or other have been photographs in the more informing of the magazines; but I missed them, and, therefore, decline on a vague vision of machinery and wire-eared ladies.",
      "output_sha256": "aa5347aceaf49d1457fced7f98b038e970d0a9224365322ebd0c93f1ffd1da98",
      "alignment_unit_index": 17,
      "alignment_score": null,
      "source_human_sentence_index": 17,
      "source_human_sha256": "aa5347aceaf49d1457fced7f98b038e970d0a9224365322ebd0c93f1ffd1da98",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 20,
      "paragraph_index": 5,
      "origin": "human",
      "text": "A friend is more definite: \"A large building,\" he describes it, \"like Olympia, the roof lost in darkness, and pallid women moving about, spinning tops and blowing penny trumpets.\"",
      "output_sha256": "ab0c73a694fec62ac4e2796961f387a07a4c89f65a29aed500eb72ea8cef3e87",
      "alignment_unit_index": 18,
      "alignment_score": null,
      "source_human_sentence_index": 18,
      "source_human_sha256": "ab0c73a694fec62ac4e2796961f387a07a4c89f65a29aed500eb72ea8cef3e87",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 21,
      "paragraph_index": 5,
      "origin": "human",
      "text": "To me, as I have suggested, there is more of Tartarus than Olympus about it.",
      "output_sha256": "fa7ad7457b26234be7d1d008482fd9cec40f69dde07dbaa8d75469a10cd79ac2",
      "alignment_unit_index": 19,
      "alignment_score": null,
      "source_human_sentence_index": 19,
      "source_human_sha256": "fa7ad7457b26234be7d1d008482fd9cec40f69dde07dbaa8d75469a10cd79ac2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 22,
      "paragraph_index": 5,
      "origin": "human",
      "text": "A sufficient hell, indeed, for any misspent life, to be continually calling up numbers, and continually being met with the saddest words that are known to men: \"Number engaged.\"",
      "output_sha256": "93591ab8f5041f86b2b69b93763c1eca93e135a5dd4e860cdfabb014e2a6ea88",
      "alignment_unit_index": 20,
      "alignment_score": null,
      "source_human_sentence_index": 20,
      "source_human_sha256": "93591ab8f5041f86b2b69b93763c1eca93e135a5dd4e860cdfabb014e2a6ea88",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 23,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I want to understand the whole telephone system.",
      "output_sha256": "7b1f9c4ccb2b00a22e3fc0478e3ee166ce921a32c75f129f5dc89b560f1c54cb",
      "alignment_unit_index": 21,
      "alignment_score": null,
      "source_human_sentence_index": 21,
      "source_human_sha256": "7b1f9c4ccb2b00a22e3fc0478e3ee166ce921a32c75f129f5dc89b560f1c54cb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 24,
      "paragraph_index": 6,
      "origin": "human",
      "text": "I want to know how the operators all get to speak exactly alike.",
      "output_sha256": "d818f2da9789d36c72ef6b313c2ca2633c8dd9af866c8ba03dc36bdb9b19ed44",
      "alignment_unit_index": 22,
      "alignment_score": null,
      "source_human_sentence_index": 22,
      "source_human_sha256": "d818f2da9789d36c72ef6b313c2ca2633c8dd9af866c8ba03dc36bdb9b19ed44",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 25,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "I know that women can be quite adept at imitation; the transition of a chorus girl from Brixton to the Savoy restaurant can occur as seamlessly as the shift from dusk to dawn, often accompanied by a change in accent.",
      "output_sha256": "2a997fdbc6de905d170d0b3c59f8096d8e661ceb1f2d552467f9fbc44383cf92",
      "alignment_unit_index": 23,
      "alignment_score": 0.541592,
      "human_sentence_indices": [
        23
      ],
      "human_sha256": [
        "0b3282800fb1ec0f4735a92be47efcbc722d4614d1d78a7358aa01e5d60e3107"
      ],
      "source_ai_sentence_index": 26,
      "source_ai_sha256": "2a997fdbc6de905d170d0b3c59f8096d8e661ceb1f2d552467f9fbc44383cf92",
      "ai_unit_sentence_indices": [
        26,
        27
      ]
    },
    {
      "sentence_index": 26,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "However, it is astonishing how operators from various Exchanges bear such striking resemblances to one another.",
      "output_sha256": "fb38e4a52a38675225c04898cfd74557b574da96783ca80aeccf3677106f5f24",
      "alignment_unit_index": 23,
      "alignment_score": 0.541592,
      "human_sentence_indices": [
        23
      ],
      "human_sha256": [
        "0b3282800fb1ec0f4735a92be47efcbc722d4614d1d78a7358aa01e5d60e3107"
      ],
      "source_ai_sentence_index": 27,
      "source_ai_sha256": "fb38e4a52a38675225c04898cfd74557b574da96783ca80aeccf3677106f5f24",
      "ai_unit_sentence_indices": [
        26,
        27
      ]
    },
    {
      "sentence_index": 27,
      "paragraph_index": 6,
      "origin": "human",
      "text": "They cannot all be one and the same.",
      "output_sha256": "46359ae33f051b15509b22bf001227a45902c0f447ba6566c42a718e0bd74aa0",
      "alignment_unit_index": 24,
      "alignment_score": null,
      "source_human_sentence_index": 24,
      "source_human_sha256": "46359ae33f051b15509b22bf001227a45902c0f447ba6566c42a718e0bd74aa0",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 28,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Miraculous as is everything connected with the telephone—talking quietly over wires that thread the earth beneath the busiest and noisiest of pavements in the world is sufficiently magical—it would be a shade too marvellous for one operator to be everywhere at once.",
      "output_sha256": "9e08625d8482dfa6737fa7b428b4998eb9585b57e5bd0c8e5f3e6162111dbb21",
      "alignment_unit_index": 25,
      "alignment_score": null,
      "source_human_sentence_index": 25,
      "source_human_sha256": "9e08625d8482dfa6737fa7b428b4998eb9585b57e5bd0c8e5f3e6162111dbb21",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 29,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Therefore, there must be many.",
      "output_sha256": "cd0792267461d4be4e095065c1a4b243e81f92fdb4a04e7886950e7eb58cb992",
      "alignment_unit_index": 26,
      "alignment_score": null,
      "source_human_sentence_index": 26,
      "source_human_sha256": "cd0792267461d4be4e095065c1a4b243e81f92fdb4a04e7886950e7eb58cb992",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 30,
      "paragraph_index": 6,
      "origin": "human",
      "text": "Is there, then, a school of elocution, where instruction in the most refined form of speech ever known is imparted, together with lessons in the trilling of the letter R?",
      "output_sha256": "a43f2cc63861c447c67d0d62731a52809411e13880b42962a0d84b82957fd38b",
      "alignment_unit_index": 27,
      "alignment_score": null,
      "source_human_sentence_index": 27,
      "source_human_sha256": "a43f2cc63861c447c67d0d62731a52809411e13880b42962a0d84b82957fd38b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 31,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "Why do they all say \"No replay\" when they mean \"No reply\"?",
      "output_sha256": "1eb5753d08d77d3d7e9e6efcce392f275c8cc452f69d228c24133b60ed05d1d4",
      "alignment_unit_index": 28,
      "alignment_score": 0.9025,
      "human_sentence_indices": [
        28
      ],
      "human_sha256": [
        "aed597e167260d94e3d227e536efe0efa4e9e1a468e713855044434d628e32f5"
      ],
      "source_ai_sentence_index": 32,
      "source_ai_sha256": "1eb5753d08d77d3d7e9e6efcce392f275c8cc452f69d228c24133b60ed05d1d4",
      "ai_unit_sentence_indices": [
        32
      ]
    },
    {
      "sentence_index": 32,
      "paragraph_index": 6,
      "origin": "human",
      "text": "And how do they talk at home?",
      "output_sha256": "e16ceb716753d29b8278b7a1f8c13473321c45d7e37497f12adb3a18c6d7c4b4",
      "alignment_unit_index": 29,
      "alignment_score": null,
      "source_human_sentence_index": 29,
      "source_human_sha256": "e16ceb716753d29b8278b7a1f8c13473321c45d7e37497f12adb3a18c6d7c4b4",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 33,
      "paragraph_index": 6,
      "origin": "ai",
      "text": "It must be quite distressing for their families if they do not temper their speech in more casual settings.",
      "output_sha256": "fc599f3adcd9a579a40f98037124c6a11d0ce86439f121b80f59af3b71c8ab70",
      "alignment_unit_index": 30,
      "alignment_score": 0.421594,
      "human_sentence_indices": [
        30
      ],
      "human_sha256": [
        "26c0316ffd8b850c0e33366a5f2c7020a5777108b46d5456060c5d411addbdbf"
      ],
      "source_ai_sentence_index": 34,
      "source_ai_sha256": "fc599f3adcd9a579a40f98037124c6a11d0ce86439f121b80f59af3b71c8ab70",
      "ai_unit_sentence_indices": [
        34
      ]
    },
    {
      "sentence_index": 34,
      "paragraph_index": 6,
      "origin": "human",
      "text": "The joy with which we recognise a male voice at the Exchange is another proof that woman does not really represent the gentler sex.",
      "output_sha256": "e74116849d308255e07895cd4b6887c60ac55271b3db10f63d047f2706cd3000",
      "alignment_unit_index": 31,
      "alignment_score": null,
      "source_human_sentence_index": 31,
      "source_human_sha256": "e74116849d308255e07895cd4b6887c60ac55271b3db10f63d047f2706cd3000",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 35,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "But these are scarcely the only mysteries that I wish to unravel.",
      "output_sha256": "bc18dd775419eacdc44a36454bae0bf75956b5c6a673d8f160c91b22e22452b8",
      "alignment_unit_index": 32,
      "alignment_score": 0.464545,
      "human_sentence_indices": [
        32
      ],
      "human_sha256": [
        "eeea716bafca0277a2595ee3894d5e55bcad3d9b2da606c1c414e5e701e796ce"
      ],
      "source_ai_sentence_index": 36,
      "source_ai_sha256": "bc18dd775419eacdc44a36454bae0bf75956b5c6a673d8f160c91b22e22452b8",
      "ai_unit_sentence_indices": [
        36
      ]
    },
    {
      "sentence_index": 36,
      "paragraph_index": 7,
      "origin": "human",
      "text": "I want to know how the odd and alarming noises are made.",
      "output_sha256": "d995414b8359bae7b9075d9c40e229757de3fed914a10b96e2eac4da6cf2564b",
      "alignment_unit_index": 33,
      "alignment_score": null,
      "source_human_sentence_index": 33,
      "source_human_sha256": "d995414b8359bae7b9075d9c40e229757de3fed914a10b96e2eac4da6cf2564b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 37,
      "paragraph_index": 7,
      "origin": "human",
      "text": "There is a tapping, as of a woodpecker with delirium tremens, which at once stuns and electrifies the ear.",
      "output_sha256": "c56eb66af40a4d63e5b8f7dee973374b40edc6fdf1f47975f0c3a1e014573d8b",
      "alignment_unit_index": 34,
      "alignment_score": null,
      "source_human_sentence_index": 34,
      "source_human_sha256": "c56eb66af40a4d63e5b8f7dee973374b40edc6fdf1f47975f0c3a1e014573d8b",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 38,
      "paragraph_index": 7,
      "origin": "human",
      "text": "How do they do that, and do they know what its effect is?",
      "output_sha256": "acce7abbb17133c61db33645aca7993cd917f3862fd9ce2b1e4c2a42a6f8f5f5",
      "alignment_unit_index": 35,
      "alignment_score": null,
      "source_human_sentence_index": 35,
      "source_human_sha256": "acce7abbb17133c61db33645aca7993cd917f3862fd9ce2b1e4c2a42a6f8f5f5",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 39,
      "paragraph_index": 7,
      "origin": "human",
      "text": "And why does one sometimes hear other conversations over other wires, and sometimes not?",
      "output_sha256": "523459aef95465b0c71ca1af91e88d36312178d019ae9da06516efea40f6aafb",
      "alignment_unit_index": 36,
      "alignment_score": null,
      "source_human_sentence_index": 36,
      "source_human_sha256": "523459aef95465b0c71ca1af91e88d36312178d019ae9da06516efea40f6aafb",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 40,
      "paragraph_index": 7,
      "origin": "human",
      "text": "Rarely are they interesting; but now and then....",
      "output_sha256": "960f04018f54ca1ff774e6046b1d1fd3517837876cb2b130228f6d381b9955f3",
      "alignment_unit_index": 37,
      "alignment_score": null,
      "source_human_sentence_index": 37,
      "source_human_sha256": "960f04018f54ca1ff774e6046b1d1fd3517837876cb2b130228f6d381b9955f3",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 41,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "My pen hesitates as I recall the humiliating oversight—the tragic failure to recognize a tip—that struck me on the morning of June 4th, 1919, otherwise known as Derby Day.",
      "output_sha256": "9aa2f0f4ba2107a10fdf2452bb73fecdd20dcd910e487522141d945ee51365de",
      "alignment_unit_index": 38,
      "alignment_score": 0.619952,
      "human_sentence_indices": [
        38
      ],
      "human_sha256": [
        "3f2daa10ae355986a9b07bc89b7a69acb1a328e4714f493b2ab56827e415d4a3"
      ],
      "source_ai_sentence_index": 42,
      "source_ai_sha256": "9aa2f0f4ba2107a10fdf2452bb73fecdd20dcd910e487522141d945ee51365de",
      "ai_unit_sentence_indices": [
        42,
        43
      ]
    },
    {
      "sentence_index": 42,
      "paragraph_index": 7,
      "origin": "ai",
      "text": "On that fateful day, the art—or perhaps the science—of prediction reached a nadir in England, as every prognosticator selected The Panther.",
      "output_sha256": "ae2f2b50f8e0835278bacbab2048c4575259e0ad3279e32a045fb16f7b4c751a",
      "alignment_unit_index": 38,
      "alignment_score": 0.619952,
      "human_sentence_indices": [
        38
      ],
      "human_sha256": [
        "3f2daa10ae355986a9b07bc89b7a69acb1a328e4714f493b2ab56827e415d4a3"
      ],
      "source_ai_sentence_index": 43,
      "source_ai_sha256": "ae2f2b50f8e0835278bacbab2048c4575259e0ad3279e32a045fb16f7b4c751a",
      "ai_unit_sentence_indices": [
        42,
        43
      ]
    },
    {
      "sentence_index": 43,
      "paragraph_index": 7,
      "origin": "human",
      "text": "To my annoyance I had to listen to a long conversation between what seemed to be a bookmaker and his client with regard to money to be placed on Grand Parade.",
      "output_sha256": "eb13cb6eb681b831f9f1841a4064ab84ca4dfb777f00b27e0c6dd317efebc7b6",
      "alignment_unit_index": 39,
      "alignment_score": null,
      "source_human_sentence_index": 39,
      "source_human_sha256": "eb13cb6eb681b831f9f1841a4064ab84ca4dfb777f00b27e0c6dd317efebc7b6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 44,
      "paragraph_index": 7,
      "origin": "human",
      "text": "This at the time only irritated me, but afterwards, when Grand Parade had won at 33 to 1, and I recognised the interruption as an effort of the gods on my behalf (had I but ears to hear), how against my folly did I rail!",
      "output_sha256": "e3975dc7c5ecd0ffa38d27ad3d6564bb119a3889c63c29a419f2881be93530d1",
      "alignment_unit_index": 40,
      "alignment_score": null,
      "source_human_sentence_index": 40,
      "source_human_sha256": "e3975dc7c5ecd0ffa38d27ad3d6564bb119a3889c63c29a419f2881be93530d1",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 45,
      "paragraph_index": 8,
      "origin": "human",
      "text": "Telephony, it is clear, both from one's own experience and from reading the letters in the papers, is not yet an exact science.",
      "output_sha256": "c59b2053e2b1e2eb7e2be0a8ec9703d701b2e3dac5472cd8c11bb3c3fc906ae2",
      "alignment_unit_index": 41,
      "alignment_score": null,
      "source_human_sentence_index": 41,
      "source_human_sha256": "c59b2053e2b1e2eb7e2be0a8ec9703d701b2e3dac5472cd8c11bb3c3fc906ae2",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 46,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "In real life, it falls short of perfection; however, in theatrical productions and American detective novels, it seems flawless.",
      "output_sha256": "0db274f81ab2bf43b463a7652c300f031ce68d9fb67ef5dd82d20c1cf93ad8ff",
      "alignment_unit_index": 42,
      "alignment_score": 0.526859,
      "human_sentence_indices": [
        42
      ],
      "human_sha256": [
        "d64a8560720e3d3c68fd7d198facb822a97bd04bfd924c7b84431e9675c404cf"
      ],
      "source_ai_sentence_index": 47,
      "source_ai_sha256": "0db274f81ab2bf43b463a7652c300f031ce68d9fb67ef5dd82d20c1cf93ad8ff",
      "ai_unit_sentence_indices": [
        47
      ]
    },
    {
      "sentence_index": 47,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "An actor lifts the receiver, states the number, and begins talking right away.",
      "output_sha256": "a74cdacb9a0b1958f0cedb3bd97b0ff7a1f9058763a81ba733cb8ce215e0c738",
      "alignment_unit_index": 43,
      "alignment_score": 0.601923,
      "human_sentence_indices": [
        43
      ],
      "human_sha256": [
        "237e33a126a4f2bc1e247c733fceb29c615488f70ea5c82c088be392850f0e9e"
      ],
      "source_ai_sentence_index": 48,
      "source_ai_sha256": "a74cdacb9a0b1958f0cedb3bd97b0ff7a1f9058763a81ba733cb8ce215e0c738",
      "ai_unit_sentence_indices": [
        48
      ]
    },
    {
      "sentence_index": 48,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "If they are on film, their lips move in a manner reminiscent of molten rubber, creating a shifting cavern.",
      "output_sha256": "c7c89ccae392a22f0921f64cea258acd142fcac73f23efad4bfb549eb3650e4b",
      "alignment_unit_index": 44,
      "alignment_score": 0.591729,
      "human_sentence_indices": [
        44
      ],
      "human_sha256": [
        "e8fea7dca34928c9e57330d868eafa014639ae204d23d6b9f0b03a8c80590978"
      ],
      "source_ai_sentence_index": 49,
      "source_ai_sha256": "c7c89ccae392a22f0921f64cea258acd142fcac73f23efad4bfb549eb3650e4b",
      "ai_unit_sentence_indices": [
        49
      ]
    },
    {
      "sentence_index": 49,
      "paragraph_index": 8,
      "origin": "ai",
      "text": "Do the rest of us, I wonder, contort our faces into such grimaces when using the telephone?",
      "output_sha256": "cde797a87823b74aabd9af3ac313eec7a5b55750f0d0337c973af519ca8a8ad2",
      "alignment_unit_index": 45,
      "alignment_score": 0.483529,
      "human_sentence_indices": [
        45
      ],
      "human_sha256": [
        "20ebf6de94fd442515e07a7f6e0427c771199f7b0cbc396ec73617e72cf89d74"
      ],
      "source_ai_sentence_index": 50,
      "source_ai_sha256": "cde797a87823b74aabd9af3ac313eec7a5b55750f0d0337c973af519ca8a8ad2",
      "ai_unit_sentence_indices": [
        50
      ]
    },
    {
      "sentence_index": 50,
      "paragraph_index": 8,
      "origin": "human",
      "text": "I must fix up a mirror and see.",
      "output_sha256": "e2f0f98667dcde4d16bed24ed20fd0674b20f538fac16e5577eec65ed571eec6",
      "alignment_unit_index": 46,
      "alignment_score": null,
      "source_human_sentence_index": 46,
      "source_human_sha256": "e2f0f98667dcde4d16bed24ed20fd0674b20f538fac16e5577eec65ed571eec6",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 51,
      "paragraph_index": 9,
      "origin": "human",
      "text": "There are many good telephone stories.",
      "output_sha256": "7066954014ffa4396529e4e9854297577ae0709e204697c0afdbfab42457c966",
      "alignment_unit_index": 47,
      "alignment_score": null,
      "source_human_sentence_index": 47,
      "source_human_sha256": "7066954014ffa4396529e4e9854297577ae0709e204697c0afdbfab42457c966",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 52,
      "paragraph_index": 9,
      "origin": "human",
      "text": "The best that I know is told of a journalist with a somewhat hypertrophied bump of reverence for worldly success, whose employer is a peer.",
      "output_sha256": "fc391c98271723edcaebaa62a306b66d2c69177f5610573ee644c3062cf2c63d",
      "alignment_unit_index": 48,
      "alignment_score": null,
      "source_human_sentence_index": 48,
      "source_human_sha256": "fc391c98271723edcaebaa62a306b66d2c69177f5610573ee644c3062cf2c63d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 53,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "His employer, a peer, will be referred to as Lord Forthestait, while the journalist will be named Mr. Blank.",
      "output_sha256": "84b1adc1a7e952b2906d97b241177930733aa27b3edb6f2cd94d9de0a12a9230",
      "alignment_unit_index": 49,
      "alignment_score": 0.537875,
      "human_sentence_indices": [
        49
      ],
      "human_sha256": [
        "be2ef5d9e389a4f9b47283f3f4ff7493b95914561ac2f5eaca40ff963996fbf1"
      ],
      "source_ai_sentence_index": 54,
      "source_ai_sha256": "84b1adc1a7e952b2906d97b241177930733aa27b3edb6f2cd94d9de0a12a9230",
      "ai_unit_sentence_indices": [
        54
      ]
    },
    {
      "sentence_index": 54,
      "paragraph_index": 9,
      "origin": "ai",
      "text": "One day, several members of the newspaper staff were chatting in one of the offices when the telephone rang.",
      "output_sha256": "d745bda4523cafc897a1d29bd015738f3b727ada5c27ef99f6f6f3dd1624e3b0",
      "alignment_unit_index": 50,
      "alignment_score": 0.586923,
      "human_sentence_indices": [
        50
      ],
      "human_sha256": [
        "dcac25ce8c9e2cac589246d29a302deb7acabaa0fa0b3d990eccc8b61a3f3a85"
      ],
      "source_ai_sentence_index": 55,
      "source_ai_sha256": "d745bda4523cafc897a1d29bd015738f3b727ada5c27ef99f6f6f3dd1624e3b0",
      "ai_unit_sentence_indices": [
        55
      ]
    },
    {
      "sentence_index": 55,
      "paragraph_index": 10,
      "origin": "human",
      "text": "\"You're wanted at the 'phone, Mr. Blank,\" said the clerk.",
      "output_sha256": "d0792aa43e6673e3d64cf7509f83c568e22adef4888ed6372210679cce731513",
      "alignment_unit_index": 51,
      "alignment_score": null,
      "source_human_sentence_index": 51,
      "source_human_sha256": "d0792aa43e6673e3d64cf7509f83c568e22adef4888ed6372210679cce731513",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 56,
      "paragraph_index": 11,
      "origin": "human",
      "text": "Blank, who was just going out to lunch, came back impatiently and snatched at the instrument.",
      "output_sha256": "bdb51ae513227bb9540ca504eaaf9511495e65e9a02afeb98199a1749485448d",
      "alignment_unit_index": 52,
      "alignment_score": null,
      "source_human_sentence_index": 52,
      "source_human_sha256": "bdb51ae513227bb9540ca504eaaf9511495e65e9a02afeb98199a1749485448d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 57,
      "paragraph_index": 12,
      "origin": "human",
      "text": "\"Yes, what is it?\" he snapped out.",
      "output_sha256": "f1c86f62043344cf924fb8d3d721b36ed780f72989e0525ff383a75b4673d94d",
      "alignment_unit_index": 53,
      "alignment_score": null,
      "source_human_sentence_index": 53,
      "source_human_sha256": "f1c86f62043344cf924fb8d3d721b36ed780f72989e0525ff383a75b4673d94d",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 58,
      "paragraph_index": 13,
      "origin": "human",
      "text": "\"Is that Blank?\" came back the reply.",
      "output_sha256": "caa2bae8b139b1242e691def6488b091707089798ab8a4292ba1dd24044a1757",
      "alignment_unit_index": 54,
      "alignment_score": null,
      "source_human_sentence_index": 54,
      "source_human_sha256": "caa2bae8b139b1242e691def6488b091707089798ab8a4292ba1dd24044a1757",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 59,
      "paragraph_index": 13,
      "origin": "human",
      "text": "\"Lord Forthestait speaking.\"",
      "output_sha256": "e9b55e721e003f0dfa205e1e4d964cb57fef3cae56220376bfc65aa5ad275dfe",
      "alignment_unit_index": 55,
      "alignment_score": null,
      "source_human_sentence_index": 55,
      "source_human_sha256": "e9b55e721e003f0dfa205e1e4d964cb57fef3cae56220376bfc65aa5ad275dfe",
      "ai_unit_sentence_indices": []
    },
    {
      "sentence_index": 60,
      "paragraph_index": 14,
      "origin": "human",
      "text": "\"Yes, my lord,\" said Blank, with the meekest deference, removing his hat.",
      "output_sha256": "6d6bfe502a066d3f8b1ba4513012c75b77764016d4bd9eb23ed01916a1026ab8",
      "alignment_unit_index": 56,
      "alignment_score": null,
      "source_human_sentence_index": 56,
      "source_human_sha256": "6d6bfe502a066d3f8b1ba4513012c75b77764016d4bd9eb23ed01916a1026ab8",
      "ai_unit_sentence_indices": []
    }
  ]
}
