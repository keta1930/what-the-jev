  "mixed_article_sha256": "5fd5fd3548bcccfe4f11522c5ed3ebf0e30aafd384ff404eb590074f9652cc9d",
  "human_source_sentence_count": 56,
  "ai_source_sentence_count": 44,
  "alignment_unit_count": 47,
  "selected_alignment_unit_count": 18,
